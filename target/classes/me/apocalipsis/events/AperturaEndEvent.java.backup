                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§5§l⚡⚡⚡ EL DESOLADOR DEL VACÍO ⚡⚡⚡");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§d§lHA DESPERTADO");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.sendTitle("§5§l⚡⚡⚡", "§d§lEL DESOLADOR DEL VACÍO", 20, 100, 30);
                        p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 3.0f, 0.4f);
                        p.playSound(p.getLocation(), Sound.ENTITY_WITHER_SPAWN, 2.0f, 0.3f);
                        p.playSound(p.getLocation(), Sound.ENTITY_PLAYER_LEVELUP, 1.5f, 0.5f);
                    }
