                                        p.playSound(p.getLocation(), Sound.ENTITY_WARDEN_SONIC_BOOM, 0.3f, 0.5f);
                                        p.playSound(p.getLocation(), Sound.AMBIENT_CAVE, 1.0f, 0.4f);
                                        p.getWorld().spawnParticle(Particle.SCULK_CHARGE, p.getLocation().add(0, 1, 0), 30, 2, 1.5, 2, 0.2);
                                        p.sendTitle("§4§l⚠ ADVERTENCIA ⚠", "§8§oLas Profundidades aguardan...", 10, 70, 30);
                                    }
                                    break;
                                case 11:
                                    Bukkit.broadcastMessage("");
                                    Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                                    Bukkit.broadcastMessage("");
                                    this.cancel();
                                    break;
                            }
                            etapa++;
                        }
                    }.runTaskTimer(plugin, 0L, 50L); // Cada 2.5 segundos
                }
                
                // 10 minutos (600s) - Vacío envolvente + DARKNESS
                if (descubrimientoTimer == 600) {
                    // Pantalla de vacío + DARKNESS
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        p.sendTitle("§0§l████", "§0§l████", 20, 60, 20);
                        
                        // DARKNESS - Vacío total (10 segundos)
                        p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                            org.bukkit.potion.PotionEffectType.DARKNESS, 200, 0, false, false, false));
                    }
                    
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            mostrarTituloObserver("§8§o...", "§7§oPuedo sentir el vacío desde aquí.", 15, 80, 25);
                            
                            // Vacío envolvente
                            for (Player p : Bukkit.getOnlinePlayers()) {
                                Location loc = p.getLocation();
                                p.getWorld().spawnParticle(Particle.SQUID_INK, loc.clone().add(0, 2, 0), 60, 3, 2, 3, 0.02);
                                p.getWorld().spawnParticle(Particle.SMOKE, loc, 80, 2, 1, 2, 0.05);
                                p.getWorld().spawnParticle(Particle.SCULK_SOUL, loc, 30, 2, 1.5, 2, 0.1);
                                
                                p.playSound(loc, Sound.AMBIENT_CAVE, 2.0f, 0.4f);
                                p.playSound(loc, Sound.ENTITY_WARDEN_AMBIENT, 0.6f, 0.5f);
                                p.playSound(loc, Sound.AMBIENT_BASALT_DELTAS_MOOD, 0.8f, 0.3f);
                            }
                        }
                    }.runTaskLater(plugin, 80L);
                    
                    programarMensajeRetrasado("§8[§7...§8] §7Frío. Silencioso. Esperando.", 160);
                    
                    // Los waypoints ahora se generan al completar el anterior (sistema automático)
                    // EMPUJES Y BRÚJULA siguen programados
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            // EMPEZAR EMPUJES HACIA EL PORTAL cada 30 segundos
                            iniciarEmpujesHaciaPortal();
                            
                            // INICIAR BRÚJULA DIRECCIONAL CON FLECHAS (obligatorio desde los 10 minutos)
                            iniciarBrujulaDireccional();
                        }
                    }.runTaskLater(plugin, 200L);
                }
                
                // 5 minutos (300s) - ALTA TENSIÓN + DARKNESS
                if (descubrimientoTimer == 300) {
                    // Secuencia apocalíptica
                    new BukkitRunnable() {
                        int fase = 0;
                        @Override
                        public void run() {
                            if (fase == 0) {
                                // Flash rojo + DARKNESS
                                for (Player p : Bukkit.getOnlinePlayers()) {
                                    p.sendTitle("§4§l⚠", "§4§l⚠⚠⚠⚠⚠⚠⚠⚠⚠", 5, 15, 5);
                                    
                                    // DARKNESS - Terror creciente (6 segundos)
                                    p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                                        org.bukkit.potion.PotionEffectType.DARKNESS, 120, 0, false, false, false));
                                }
                            } else if (fase == 1) {
                                mostrarTituloObserver("§c§l5 MINUTOS", "§7§oYa casi están ahí", 10, 60, 20);
                                
                                // Efectos apocalípticos
                                for (Player p : Bukkit.getOnlinePlayers()) {
                                    Location loc = p.getLocation();
                                    
                                    // Explosión de partículas dramática
                                    p.getWorld().spawnParticle(Particle.EXPLOSION, loc.clone().add(0, 1, 0), 5);
                                    p.getWorld().spawnParticle(Particle.LAVA, loc, 40, 2, 1, 2, 0.1);
                                    p.getWorld().spawnParticle(Particle.DRAGON_BREATH, loc, 80, 3, 2, 3, 0.1);
                                    p.getWorld().spawnParticle(Particle.PORTAL, loc, 150, 4, 2, 4, 1.5);
                                    p.getWorld().spawnParticle(Particle.END_ROD, loc.clone().add(0, 3, 0), 60, 1, 2, 1, 0.3);
                                    
                                    p.playSound(loc, Sound.ENTITY_ENDER_DRAGON_GROWL, 1.5f, 0.7f);
                                    p.playSound(loc, Sound.ENTITY_WARDEN_ROAR, 0.8f, 0.5f);
                                    p.playSound(loc, Sound.ENTITY_GENERIC_EXPLODE, 0.8f, 0.8f);
                                }
                            }
                            
                            fase++;
                            if (fase >= 2) {
                                this.cancel();
                            }
                        }
                    }.runTaskTimer(plugin, 0L, 20L);
                    
                    programarMensajeRetrasado("§8[§7...§8] §7Si cruzan ese umbral, no hay marcha atrás.", 80);
                    
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            mostrarTituloObserver("§8§o...", "§7§oNunca la hay.", 10, 60, 20);
                            
                            // Eco oscuro
                            for (Player p : Bukkit.getOnlinePlayers()) {
                                Location loc = p.getLocation();
                                p.getWorld().spawnParticle(Particle.SOUL_FIRE_FLAME, loc.clone().add(0, 0.3, 0), 30, 2, 0.5, 2, 0.02);
                                p.getWorld().spawnParticle(Particle.SMOKE, loc, 60, 2, 2, 2, 0.05);
                                p.playSound(loc, Sound.ENTITY_WARDEN_LISTENING, 0.8f, 0.5f);
                            }
                        }
                    }.runTaskLater(plugin, 140L);
                }
                
                // 3 minutos (180s) - Advertencia final + ambiente terrorífico + DARKNESS
                if (descubrimientoTimer == 180) {
                    // DARKNESS inicial - Ambiente de terror (4 segundos)
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                            org.bukkit.potion.PotionEffectType.DARKNESS, 80, 0, false, false, false));
                    }
                    
                    Bukkit.broadcastMessage("§8[§7...§8] §7El End no olvida.");
                    
                    // Ambiente de terror
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        Location loc = p.getLocation();
                        p.getWorld().spawnParticle(Particle.SOUL_FIRE_FLAME, loc.clone().add(0, 0.3, 0), 30, 2, 0.5, 2, 0.02);
                        p.getWorld().spawnParticle(Particle.SMOKE, loc, 60, 2, 2, 2, 0.05);
                        p.playSound(loc, Sound.ENTITY_WARDEN_LISTENING, 0.8f, 0.5f);
                    }
                    
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            mostrarTituloObserver("§8§l...", "§7§oNi perdona.", 10, 70, 20);
                            
                            // Partículas de condena
                            for (Player p : Bukkit.getOnlinePlayers()) {
                                Location loc = p.getLocation();
                                p.getWorld().spawnParticle(Particle.SCULK_CHARGE, loc, 40, 3, 1, 3, 0.5);
                                p.getWorld().spawnParticle(Particle.CRIMSON_SPORE, loc, 50, 2, 2, 2, 0.1);
                                p.playSound(loc, Sound.ENTITY_WARDEN_AMBIENT, 1.0f, 0.6f);
                                p.playSound(loc, Sound.BLOCK_SCULK_SHRIEKER_SHRIEK, 0.5f, 0.7f);
                            }
                        }
                    }.runTaskLater(plugin, 100L);
                    
                    // Los waypoints ahora se generan al completar el anterior (sistema automático)
                    // TELETRANSPORTE sigue programado
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            // TELETRANSPORTE MÁS AGRESIVO cada 15 segundos
                            iniciarTeletransporteIntensivo();
                        }
                    }.runTaskLater(plugin, 120L);
                }
                
                // 1 minuto (60s) - MÁXIMA TENSIÓN + secuencia épica final + DARKNESS TOTAL
                if (descubrimientoTimer == 60) {
                    // Secuencia cinematográfica final
                    new BukkitRunnable() {
                        int tick = 0;
                        @Override
                        public void run() {
                            if (tick == 0) {
                                // Pantalla negra inicial + DARKNESS máxima
                                for (Player p : Bukkit.getOnlinePlayers()) {
                                    p.sendTitle("§0§l███████", "§0§l███████", 10, 30, 10);
                                    
                                    // DARKNESS - Máxima oscuridad (15 segundos)
                                    p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                                        org.bukkit.potion.PotionEffectType.DARKNESS, 300, 0, false, false, false));
                                }
                            } else if (tick == 40) {
                                // Revelación dramática
                                mostrarTituloObserver("§c§l1 MINUTO", "§8§oEl portal despierta", 15, 70, 25);
                                
                                for (Player p : Bukkit.getOnlinePlayers()) {
                                    Location loc = p.getLocation();
                                    
                                    // Explosión masiva de efectos
                                    p.getWorld().spawnParticle(Particle.EXPLOSION_EMITTER, loc.clone().add(0, 2, 0), 3);
                                    p.getWorld().spawnParticle(Particle.PORTAL, loc, 200, 5, 3, 5, 2.0);
                                    p.getWorld().spawnParticle(Particle.DRAGON_BREATH, loc, 120, 4, 2, 4, 0.5);
                                    p.getWorld().spawnParticle(Particle.END_ROD, loc.clone().add(0, 4, 0), 80, 2, 3, 2, 0.5);
                                    p.getWorld().spawnParticle(Particle.REVERSE_PORTAL, loc, 100, 3, 2, 3, 1.0);
                                    
                                    p.playSound(loc, Sound.ENTITY_ENDER_DRAGON_DEATH, 1.0f, 2.0f);
                                    p.playSound(loc, Sound.ENTITY_WARDEN_HEARTBEAT, 1.5f, 0.5f);
                                    p.playSound(loc, Sound.ENTITY_GENERIC_EXPLODE, 1.0f, 0.6f);
                                    p.playSound(loc, Sound.BLOCK_END_PORTAL_SPAWN, 1.5f, 0.5f);
                                }
                            }
                            
                            tick++;
                            if (tick >= 80) {
                                this.cancel();
                            }
                        }
                    }.runTaskTimer(plugin, 0L, 1L);
                    
                    programarMensajeRetrasado("§8[§7...§8] §7Deberían haber traído más que armadura.", 100);
                    
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            mostrarTituloObserver("§8§o...", "§7§oDeberían haber traído esperanza.", 15, 80, 25);
                            
                            // Partículas de desesperanza
                            for (Player p : Bukkit.getOnlinePlayers()) {
                                Location loc = p.getLocation();
                                p.getWorld().spawnParticle(Particle.SOUL, loc, 60, 3, 2, 3, 0.05);
                                p.getWorld().spawnParticle(Particle.ASH, loc, 80, 3, 2, 3, 0.1);
                            }
                        }
                    }.runTaskLater(plugin, 160L);
                }
                
                // Countdown final (10 segundos) - Intensidad máxima + DARKNESS pulsante
                if (descubrimientoTimer <= 10 && descubrimientoTimer > 0) {
                    for (Player player : Bukkit.getOnlinePlayers()) {
                        player.sendTitle("§c§l" + descubrimientoTimer, "§8§oEl vacío espera", 5, 10, 5);
                        
                        Location loc = player.getLocation();
                        // Efectos crecientes según se acerca el final
                        int intensidad = (11 - descubrimientoTimer) * 10;
                        player.getWorld().spawnParticle(Particle.PORTAL, loc, intensidad, 1, 1, 1, 0.5);
                        player.getWorld().spawnParticle(Particle.END_ROD, loc.clone().add(0, 2, 0), intensidad / 2, 0.5, 1, 0.5, 0.1);
                        
                        player.playSound(loc, Sound.BLOCK_NOTE_BLOCK_HAT, 1.5f, 0.8f);
                        player.playSound(loc, Sound.ENTITY_WARDEN_HEARTBEAT, 1.0f + (intensidad * 0.01f), 1.0f);
                        
                        if (descubrimientoTimer <= 5) {
                            player.playSound(loc, Sound.BLOCK_END_PORTAL_SPAWN, 0.5f, 2.0f);
                            
                            // DARKNESS pulsante en últimos 5 segundos
                            if (descubrimientoTimer % 2 == 0) {
                                player.addPotionEffect(new org.bukkit.potion.PotionEffect(
                                    org.bukkit.potion.PotionEffectType.DARKNESS, 40, 0, false, false, false));
                            }
                        }
                    }
                }
                
                // Verificar si hay jugadores cerca del portal
                if (portalLocation != null && direccionRevelada) {
                    checkJugadoresCercaPortal();
                }
                
                // Si se acaba el tiempo, NO forzar - esperar a que lleguen
                if (descubrimientoTimer <= 0) {
                    if (!esperandoJugadoresCercaPortal) {
                        esperandoJugadoresCercaPortal = true;
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§c§l⚠ TIEMPO AGOTADO ⚠");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§7El portal está listo...");
                        Bukkit.broadcastMessage("§7Pero nadie está cerca para verlo activarse.");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8El evento continuará cuando alguien se acerque.");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.playSound(p.getLocation(), Sound.BLOCK_NOTE_BLOCK_PLING, 1.0f, 0.5f);
                        }
                    }
                    // NO cancelar el task, seguir verificando proximidad
                }
            }
        }.runTaskTimer(plugin, 0L, 20L); // Cada segundo
    }
    
    /**
     * Muestra un título del Observer a todos los jugadores
     * Usado para mensajes de alta carga emocional (nostalgia, tristeza, tensión)
     */
    private void mostrarTituloObserver(String titulo, String subtitulo, int fadeIn, int stay, int fadeOut) {
        for (Player player : Bukkit.getOnlinePlayers()) {
            player.sendTitle(titulo, subtitulo, fadeIn, stay, fadeOut);
        }
    }
    
    /**
     * Programa un mensaje del Observer con delay (en ticks)
     */
    private void programarMensajeRetrasado(String mensaje, long delayTicks) {
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage(mensaje);
            }
        }.runTaskLater(plugin, delayTicks);
    }
    
    /**
     * Verifica si todos los jugadores están agrupados (a menos de 30 bloques entre sí)
     * @return true si están juntos, false si están dispersos
     */
    private boolean verificarJugadoresAgrupados() {
        List<Player> players = new ArrayList<>(Bukkit.getOnlinePlayers());
        if (players.size() <= 1) return true; // Un solo jugador siempre está "agrupado"
        
        // Verificar que todos estén en el mismo mundo
        World mundo = players.get(0).getWorld();
        for (Player p : players) {
            if (!p.getWorld().equals(mundo)) {
                return false; // Jugadores en diferentes mundos
            }
        }
        
        // Calcular distancia máxima entre todos los jugadores
        double maxDistancia = 0;
        for (int i = 0; i < players.size(); i++) {
            for (int j = i + 1; j < players.size(); j++) {
                double dist = players.get(i).getLocation().distance(players.get(j).getLocation());
                if (dist > maxDistancia) {
                    maxDistancia = dist;
                }
            }
        }
        
        return maxDistancia <= DISTANCIA_MAXIMA_AGRUPACION;
    }
    
    /**
     * Intenta crear un waypoint solo si los jugadores están agrupados
     * Si no están juntos, inicia una tarea que pide agrupación
     */
    private void intentarCrearWaypoint(double factorDistancia, String nombre, String mensaje) {
        // Verificar si ya están agrupados
        if (verificarJugadoresAgrupados()) {
            jugadoresAgrupados = true;
            crearWaypoint(factorDistancia, nombre, mensaje);
            return;
        }
        
        // No están agrupados - pedir que se junten
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§5§l⚡ EL OBSERVADOR ESPERA ⚡");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§7El Observador no puede ver claramente...");
        Bukkit.broadcastMessage("§7Los fragmentos están §cdispersos§7.");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§e§l⚠ REQUERIMIENTO:");
        Bukkit.broadcastMessage("§7Todos deben estar §ajuntos §7(máx. §e30 bloques§7)");
        Bukkit.broadcastMessage("§7para recibir la siguiente señal.");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.playSound(p.getLocation(), Sound.BLOCK_BEACON_DEACTIVATE, 1.0f, 0.5f);
            p.playSound(p.getLocation(), Sound.ENTITY_ENDERMAN_TELEPORT, 0.8f, 0.8f);
            p.spawnParticle(Particle.SMOKE, p.getLocation().add(0, 2, 0), 50, 1, 1, 1, 0.05);
        }
        
        // Cancelar tarea anterior si existe
        if (agrupacionCheckTask != null && !agrupacionCheckTask.isCancelled()) {
            agrupacionCheckTask.cancel();
        }
        
        // Iniciar tarea que verifica agrupación cada 5 segundos
        final double finalFactorDistancia = factorDistancia;
        final String finalNombre = nombre;
        final String finalMensaje = mensaje;
        
        agrupacionCheckTask = new BukkitRunnable() {
            int intentos = 0;
            
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO) {
                    cancel();
                    return;
                }
                
                intentos++;
                
                if (verificarJugadoresAgrupados()) {
                    // ¡Se agruparon!
                    jugadoresAgrupados = true;
                    
                    Bukkit.broadcastMessage("");
                    Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                    Bukkit.broadcastMessage("");
                    Bukkit.broadcastMessage("§a§l✓ VISIÓN CLARA");
                    Bukkit.broadcastMessage("");
                    Bukkit.broadcastMessage("§7Los fragmentos se §aúnen§7...");
                    Bukkit.broadcastMessage("§7El Observador puede ver de nuevo.");
                    Bukkit.broadcastMessage("");
                    Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                    
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        p.playSound(p.getLocation(), Sound.ENTITY_PLAYER_LEVELUP, 1.0f, 1.2f);
                        p.playSound(p.getLocation(), Sound.BLOCK_BEACON_POWER_SELECT, 1.0f, 1.5f);
                        p.spawnParticle(Particle.END_ROD, p.getLocation().add(0, 2, 0), 50, 0.5, 1, 0.5, 0.1);
                    }
                    
                    // Crear el waypoint después de 2 segundos
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            crearWaypoint(finalFactorDistancia, finalNombre, finalMensaje);
                        }
                    }.runTaskLater(plugin, 40L);
                    
                    cancel();
                } else {
                    // Recordatorio cada 20 segundos (cada 4 intentos)
                    if (intentos % 4 == 0) {
                        Bukkit.broadcastMessage("§8[§7...§8] §7El Observador espera que se §ereúnan§7...");
                        
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.sendActionBar("§c⚠ §7Deben estar juntos (máx. §e30 bloques§7) §c⚠");
                            p.playSound(p.getLocation(), Sound.BLOCK_NOTE_BLOCK_BASS, 0.5f, 0.5f);
                        }
                    }
                }
            }
        }.runTaskTimer(plugin, 100L, 100L); // Cada 5 segundos
    }
    
    /**
     * Crea un waypoint que guía progresivamente hacia el portal
     * @param factorDistancia 0.0 = portal, 1.0 = posición inicial
     */
    private void crearWaypoint(double factorDistancia, String nombre, String mensaje) {
        if (portalLocation == null) return;
        
        // Calcular posición del waypoint entre los jugadores y el portal
        Location promedioJugadores = calcularCentroJugadores();
        if (promedioJugadores == null) return;
        
        // Interpolar entre posición actual y portal
        double x = promedioJugadores.getX() + (portalLocation.getX() - promedioJugadores.getX()) * (1.0 - factorDistancia);
        double z = promedioJugadores.getZ() + (portalLocation.getZ() - promedioJugadores.getZ()) * (1.0 - factorDistancia);
        double y = portalLocation.getWorld().getHighestBlockYAt((int)x, (int)z) + 1;
        
        waypointActual = new Location(portalLocation.getWorld(), x, y, z);
        waypointNumero++;
        waypointsGenerados.add(waypointActual.clone());
        
        // Anuncio
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage(nombre);
        Bukkit.broadcastMessage(mensaje);
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§7Una señal ha aparecido guiándolos...");
        Bukkit.broadcastMessage("§5§l⚡ §7Pilar de luz púrpura §5§l⚡ §8| §7Rastro de partículas encantadas");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        
        // Efectos de aparición del waypoint (MUY VISIBLES)
        for (int i = 0; i < 5; i++) {
            final int iteration = i;
            new BukkitRunnable() {
                @Override
                public void run() {
                    waypointActual.getWorld().spawnParticle(Particle.EXPLOSION_EMITTER, waypointActual.clone().add(0, 2, 0), 1);
                    waypointActual.getWorld().spawnParticle(Particle.END_ROD, waypointActual, 150, 3, 4, 3, 0.4);
                    waypointActual.getWorld().spawnParticle(Particle.PORTAL, waypointActual, 300, 4, 3, 4, 1.5);
                    waypointActual.getWorld().spawnParticle(Particle.DRAGON_BREATH, waypointActual.clone().add(0, 1, 0), 50, 2, 2, 2, 0.1);
                    
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        p.playSound(p.getLocation(), Sound.BLOCK_END_PORTAL_SPAWN, 1.5f, 1.2f + (iteration * 0.2f));
                        p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 0.8f, 1.5f);
                        p.playSound(p.getLocation(), Sound.BLOCK_BEACON_ACTIVATE, 0.6f, 1.8f);
                        
                        // Mostrar dirección al jugador
                        if (iteration == 0) {
                            double dist = p.getLocation().distance(waypointActual);
                            p.sendMessage("§8[§7...§8] §7Señal detectada a §e" + (int)dist + "m §7de tu posición");
                        }
                    }
                }
            }.runTaskLater(plugin, i * 15L);
        }
        
        // Cancelar partículas anteriores si existen
        if (waypointParticlesTask != null && !waypointParticlesTask.isCancelled()) {
            waypointParticlesTask.cancel();
        }
        
        // Cancelar verificación anterior si existe
        if (waypointCheckTask != null && !waypointCheckTask.isCancelled()) {
            waypointCheckTask.cancel();
        }
        
        // Iniciar verificación de llegada al waypoint
        waypointCheckTask = new BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || waypointActual == null) {
                    cancel();
                    return;
                }
                
                // Verificar si algún jugador llegó al waypoint
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(waypointActual.getWorld())) continue;
                    
                    double distancia = p.getLocation().distance(waypointActual);
                    
                    // Si el jugador está cerca del waypoint (< 15 bloques)
                    if (distancia < 15) {
                        // Marcar waypoint como completado
                        waypointsCompletados++;
                        
                        // Efectos de celebración
                        waypointActual.getWorld().spawnParticle(Particle.EXPLOSION_EMITTER, waypointActual.clone().add(0, 2, 0), 3);
                        waypointActual.getWorld().spawnParticle(Particle.END_ROD, waypointActual, 200, 4, 5, 4, 0.5);
                        waypointActual.getWorld().spawnParticle(Particle.PORTAL, waypointActual, 400, 5, 4, 5, 2.0);
                        waypointActual.getWorld().spawnParticle(Particle.DRAGON_BREATH, waypointActual.clone().add(0, 1, 0), 80, 3, 3, 3, 0.15);
                        
                        for (Player jugador : Bukkit.getOnlinePlayers()) {
                            jugador.playSound(jugador.getLocation(), Sound.ENTITY_PLAYER_LEVELUP, 1.0f, 1.5f);
                            jugador.playSound(jugador.getLocation(), Sound.BLOCK_BEACON_POWER_SELECT, 1.0f, 2.0f);
                            jugador.playSound(jugador.getLocation(), Sound.BLOCK_END_PORTAL_FRAME_FILL, 1.0f, 1.2f);
                        }
                        
                        // Anunciar progreso
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§a§l✓ SEÑAL ENCONTRADA");
                        Bukkit.broadcastMessage("§7" + p.getName() + " ha alcanzado el waypoint!");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§e§lProgreso: §a" + waypointsCompletados + "§8/§a" + TOTAL_WAYPOINTS + " §7señales");
                        Bukkit.broadcastMessage("");
                        
                        // Verificar si completaron todos los waypoints
                        if (waypointsCompletados >= TOTAL_WAYPOINTS) {
                            Bukkit.broadcastMessage("§5§l⚡ ¡TODAS LAS SEÑALES ENCONTRADAS! ⚡");
                            Bukkit.broadcastMessage("§7Preparando revelación final...");
                            Bukkit.broadcastMessage("");
                            Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                            
                            // Revelar ubicación del portal (con verificación de agrupación)
                            new BukkitRunnable() {
                                @Override
                                public void run() {
                                    intentarRevelarDireccionPortal();
                                }
                            }.runTaskLater(plugin, 60L);
                            
                            // Cancelar tareas de waypoints
                            cancel();
                            if (waypointParticlesTask != null) {
                                waypointParticlesTask.cancel();
                            }
                        } else {
                            Bukkit.broadcastMessage("§7Generando siguiente señal...");
                            Bukkit.broadcastMessage("");
                            Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                            
                            // Generar siguiente waypoint después de 3 segundos
                            new BukkitRunnable() {
                                @Override
                                public void run() {
                                    // Calcular nuevo factor de distancia (cada vez más cerca del portal)
                                    double nuevoFactor = 0.8 - (waypointsCompletados * 0.25); // 0.8, 0.55, 0.30
                                    
                                    String[] nombres = {
                                        "§5§l⚡ SEGUNDA SEÑAL",
                                        "§5§l⚡ SEÑAL FINAL"
                                    };
                                    
                                    String[] mensajes = {
                                        "§7La energía se intensifica... están más cerca.",
                                        "§7El portal casi puede ser percibido... un último esfuerzo."
                                    };
                                    
                                    int index = waypointsCompletados - 1;
                                    if (index < nombres.length) {
                                        // VERIFICAR AGRUPACIÓN antes de crear siguiente waypoint
                                        intentarCrearWaypoint(nuevoFactor, nombres[index], mensajes[index]);
                                    }
                                }
                            }.runTaskLater(plugin, 60L);
                            
                            cancel(); // Cancelar esta tarea, se creará una nueva con el siguiente waypoint
                        }
                        
                        return; // Salir después de procesar el waypoint
                    }
                }
            }
        }.runTaskTimer(plugin, 40L, 20L); // Verificar cada segundo
        
        // Iniciar partículas continuas del waypoint
        waypointParticlesTask = new BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || waypointActual == null) {
                    cancel();
                    return;
                }
                
                // Pilar de luz hacia el cielo (MÁS ALTO Y VISIBLE)
                for (int y = 0; y < 100; y += 2) {
                    Location particleLoc = waypointActual.clone().add(0, y, 0);
                    waypointActual.getWorld().spawnParticle(Particle.END_ROD, particleLoc, 3, 0.15, 0, 0.15, 0.02);
                    waypointActual.getWorld().spawnParticle(Particle.PORTAL, particleLoc, 8, 0.4, 0, 0.4, 0.08);
                    
                    // Añadir espirales cada 10 bloques para mayor visibilidad
                    if (y % 10 == 0) {
                        double spiral = (y / 10.0) * Math.PI * 2;
                        double spiralX = Math.cos(spiral) * 2;
                        double spiralZ = Math.sin(spiral) * 2;
                        Location spiralLoc = particleLoc.clone().add(spiralX, 0, spiralZ);
                        waypointActual.getWorld().spawnParticle(Particle.ENCHANT, spiralLoc, 5, 0.1, 0.1, 0.1, 0.05);
                    }
                }
                
                // Anillo en el suelo (MÁS GRANDE)
                for (double angle = 0; angle < Math.PI * 2; angle += Math.PI / 24) {
                    double x = Math.cos(angle) * 4;
                    double z = Math.sin(angle) * 4;
                    Location ringLoc = waypointActual.clone().add(x, 0.2, z);
                    waypointActual.getWorld().spawnParticle(Particle.REVERSE_PORTAL, ringLoc, 2, 0, 0, 0, 0);
                    waypointActual.getWorld().spawnParticle(Particle.ENCHANT, ringLoc, 1, 0, 0, 0, 0);
                }
                
                // Guiar a jugadores con partículas individuales
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(waypointActual.getWorld())) continue;
                    
                    Location playerLoc = p.getLocation();
                    double distancia = playerLoc.distance(waypointActual);
                    
                    if (distancia > 15 && distancia < 1000) {
                        // Crear camino de partículas hacia el waypoint (MÁS VISIBLE)
                        org.bukkit.util.Vector direction = waypointActual.toVector().subtract(playerLoc.toVector()).normalize();
                        
                        for (int i = 1; i <= 15; i++) {
                            Location pathLoc = playerLoc.clone().add(direction.clone().multiply(i * 4));
                            pathLoc.setY(playerLoc.getY() + 1.5);
                            // Usar world.spawnParticle para que todos vean el mismo rastro
                            p.getWorld().spawnParticle(Particle.ENCHANT, pathLoc, 3, 0.2, 0.2, 0.2, 0.01);
                            p.getWorld().spawnParticle(Particle.GLOW, pathLoc, 1, 0.1, 0.1, 0.1, 0);
                        }
                    }
                    
                    // Mostrar distancia en ActionBar
                    if (distancia < 1000) {
                        int metros = (int) distancia;
                        p.sendActionBar("§5§l⚡ §7Señal: §e" + metros + "m §8| §7Sigue las partículas encantadas");
                    }
                }
            }
        }.runTaskTimer(plugin, 60L, 10L);
    }
    
    /**
     * Calcula el centro promedio de todos los jugadores online
     */
    private Location calcularCentroJugadores() {
        List<Player> players = new ArrayList<>(Bukkit.getOnlinePlayers());
        if (players.isEmpty()) return null;
        
        double sumX = 0, sumY = 0, sumZ = 0;
        World world = players.get(0).getWorld();
        
        for (Player p : players) {
            if (p.getWorld().equals(world)) {
                sumX += p.getLocation().getX();
                sumY += p.getLocation().getY();
                sumZ += p.getLocation().getZ();
            }
        }
        
        int count = players.size();
        return new Location(world, sumX / count, sumY / count, sumZ / count);
    }
    
    /**
     * Inicia sistema de empujes suaves hacia el portal (cada 30 segundos)
     */
    private void iniciarEmpujesHaciaPortal() {
        new BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || portalLocation == null) {
                    cancel();
                    return;
                }
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(portalLocation.getWorld())) continue;
                    
                    double distancia = p.getLocation().distance(portalLocation);
                    
                    // Solo empujar si están lejos (más de 100 bloques)
                    if (distancia > 100) {
                        // Vector hacia el portal
                        org.bukkit.util.Vector direction = portalLocation.toVector()
                            .subtract(p.getLocation().toVector())
                            .normalize()
                            .multiply(0.3); // Empuje suave
                        
                        p.setVelocity(p.getVelocity().add(direction));
                        
                        // Efectos visuales
                        p.spawnParticle(Particle.PORTAL, p.getLocation(), 20, 1, 1, 1, 0.1);
                        p.playSound(p.getLocation(), Sound.ENTITY_ENDERMAN_TELEPORT, 0.3f, 1.5f);
                        p.sendActionBar("§5§l» §7Algo te atrae hacia el portal... §5§l«");
                    }
                }
            }
        }.runTaskTimer(plugin, 100L, 600L); // Cada 30 segundos
    }
    
    /**
     * Inicia teletransporte intensivo hacia el portal (últimos 3 minutos)
     */
    private void iniciarTeletransporteIntensivo() {
        new BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || portalLocation == null) {
                    cancel();
                    return;
                }
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(portalLocation.getWorld())) continue;
                    
                    double distancia = p.getLocation().distance(portalLocation);
                    
                    // Teletransportar si están muy lejos (más de 200 bloques)
                    if (distancia > 200) {
                        // Calcular punto intermedio (acercar 100 bloques hacia el portal)
                        org.bukkit.util.Vector direction = portalLocation.toVector()
                            .subtract(p.getLocation().toVector())
                            .normalize()
                            .multiply(100);
                        
                        Location newLoc = p.getLocation().clone().add(direction);
                        newLoc.setY(portalLocation.getWorld().getHighestBlockYAt(newLoc) + 1);
                        
                        // Efectos pre-teletransporte
                        p.getWorld().spawnParticle(Particle.PORTAL, p.getLocation(), 100, 1, 2, 1, 1.0);
                        p.playSound(p.getLocation(), Sound.ENTITY_ENDERMAN_TELEPORT, 1.0f, 0.8f);
                        
                        // Teletransportar
                        p.teleport(newLoc);
                        
                        // Efectos post-teletransporte
                        p.getWorld().spawnParticle(Particle.REVERSE_PORTAL, newLoc, 100, 1, 2, 1, 1.0);
                        p.playSound(newLoc, Sound.ENTITY_ENDERMAN_TELEPORT, 1.0f, 1.2f);
                        
                        p.sendTitle("§5§l⚡", "§7El Vacío te arrastra", 10, 30, 10);
                        p.sendMessage("§8[§7...§8] §5El portal te llama...");
                    }
                }
            }
        }.runTaskTimer(plugin, 100L, 300L); // Cada 15 segundos
    }
    
    /**
     * Muestra brújula direccional con flechas en ActionBar
     * Activa desde los 10 minutos restantes para guiar a los jugadores al portal
     */
    private void iniciarBrujulaDireccional() {
        // Cancelar brújula anterior (intermitente) si existe
        if (brujulaTask != null && !brujulaTask.isCancelled()) {
            brujulaTask.cancel();
        }
        
        // Mensaje informativo
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§5§l⚡ BRÚJULA ACTIVADA ⚡");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§7Las flechas ahora guían §lconstantemente§7.");
        Bukkit.broadcastMessage("§8El portal está muy cerca...");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        
        new BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || portalLocation == null) {
                    cancel();
                    return;
                }
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(portalLocation.getWorld())) continue;
                    
                    Location playerLoc = p.getLocation();
                    double distancia = playerLoc.distance(portalLocation);
                    
                    // Calcular dirección
                    org.bukkit.util.Vector toPortal = portalLocation.toVector().subtract(playerLoc.toVector());
                    double angle = Math.atan2(toPortal.getZ(), toPortal.getX());
                    
                    // Convertir a dirección del jugador
                    float playerYaw = playerLoc.getYaw();
                    double playerAngle = Math.toRadians(playerYaw + 90); // Ajuste por sistema de coordenadas
                    
                    // Calcular diferencia angular
                    double diffAngle = angle - playerAngle;
                    
                    // Normalizar a -PI a PI
                    while (diffAngle > Math.PI) diffAngle -= 2 * Math.PI;
                    while (diffAngle < -Math.PI) diffAngle += 2 * Math.PI;
                    
                    // Determinar flecha según ángulo
                    String flecha;
                    String direccion;
                    
                    if (Math.abs(diffAngle) < Math.PI / 8) {
                        // Adelante
                        flecha = "↑↑↑";
                        direccion = "§a§lADELANTE";
                    } else if (Math.abs(diffAngle) > 7 * Math.PI / 8) {
                        // Atrás
                        flecha = "↓↓↓";
                        direccion = "§c§lATRÁS";
                    } else if (diffAngle > 0) {
                        // Izquierda
                        if (diffAngle < 3 * Math.PI / 8) {
                            flecha = "↖↖↖";
                            direccion = "§e§lIZQUIERDA ADELANTE";
                        } else if (diffAngle < 5 * Math.PI / 8) {
                            flecha = "←←←";
                            direccion = "§e§lIZQUIERDA";
                        } else {
                            flecha = "↙↙↙";
                            direccion = "§6§lIZQUIERDA ATRÁS";
                        }
                    } else {
                        // Derecha
                        if (diffAngle > -3 * Math.PI / 8) {
                            flecha = "↗↗↗";
                            direccion = "§b§lDERECHA ADELANTE";
                        } else if (diffAngle > -5 * Math.PI / 8) {
                            flecha = "→→→";
                            direccion = "§b§lDERECHA";
                        } else {
                            flecha = "↘↘↘";
                            direccion = "§3§lDERECHA ATRÁS";
                        }
                    }
                    
                    // Mostrar en ActionBar
                    String distanciaStr = distancia < 1000 ? String.format("§b%d bloques", (int)distancia) : String.format("§b%.1fkm", distancia / 1000);
                    p.sendActionBar("§5§l⚡ PORTAL §8§l| " + flecha + " " + direccion + " §8§l| " + distanciaStr);
                }
            }
        }.runTaskTimer(plugin, 20L, 20L); // Cada segundo
    }
    
    /**
     * Verifica si hay jugadores cerca del portal para activar Fase 2
     * REQUISITO: El iniciador del evento DEBE estar cerca del portal para que se active
     */
    private void checkJugadoresCercaPortal() {
        if (portalLocation == null) return;
        if (faseEvento != EventPhase.DESCUBRIMIENTO) return;
        
        int radioDeteccion = config.getInt("evento.portal.radio_deteccion_llegada", 30); // Reducido a 30 bloques (debe estar MUY cerca)
        
        // NUEVO: Verificar primero si el iniciador está cerca (si existe)
        boolean iniciadorCerca = false;
        Player iniciador = null;
        
        if (iniciadorUUID != null) {
            iniciador = Bukkit.getPlayer(iniciadorUUID);
            if (iniciador != null && iniciador.isOnline()) {
                if (iniciador.getWorld().equals(portalLocation.getWorld())) {
                    double distanciaIniciador = iniciador.getLocation().distance(portalLocation);
                    iniciadorCerca = distanciaIniciador <= radioDeteccion;
                    
                    // Mostrar feedback al iniciador
                    if (distanciaIniciador <= 200) {
                        if (!iniciadorCerca) {
                            iniciador.sendActionBar("§8[§5Portal§8] §cDebes acercarte más §8(§7" + (int)distanciaIniciador + "§8/§a" + radioDeteccion + " bloques§8)");
                        } else {
                            iniciador.sendActionBar("§8[§5Portal§8] §a¡Estás lo suficientemente cerca! §7(" + (int)distanciaIniciador + " bloques)");
                        }
                    }
                }
            }
        } else {
            // Si no hay iniciador definido, permitir activación normal
            iniciadorCerca = true;
        }
        
        // Solo verificar otros jugadores si el iniciador está cerca (o no hay iniciador)
        if (!iniciadorCerca) {
            return;  // El iniciador debe estar cerca primero
        }
        
        for (Player player : Bukkit.getOnlinePlayers()) {
            if (player.getWorld().equals(portalLocation.getWorld())) {
                double distancia = player.getLocation().distance(portalLocation);
                
                // DEBUG: Mostrar distancia al jugador si está relativamente cerca
                // PERO solo si NO está activa la brújula direccional (timer > 600 seg)
                if (distancia <= 200 && descubrimientoTimer > 600 && !player.equals(iniciador)) {
                    player.sendActionBar("§8[§7Portal§8] §7Distancia: §b" + (int)distancia + " bloques §8(Activación: §a<" + radioDeteccion + "§8)");
                }
                
                if (distancia <= radioDeteccion) {
                    // ¡Jugadores llegaron al portal!
                    plugin.getLogger().info("[Apertura End] ✓ Jugador " + player.getName() + " detectado a " + (int)distancia + " bloques del portal");
                    if (iniciadorUUID != null) {
                        Bukkit.broadcastMessage("§a§l✓ El iniciador y jugadores han llegado al portal!");
                    } else {
                        Bukkit.broadcastMessage("§a§l✓ " + player.getName() + " ha llegado al portal!");
                    }
                    iniciarFaseLlegada();
                    if (preparacionTask != null) {
                        preparacionTask.cancel();
                    }
                    return;
                }
            }
        }
    }
    
    /**
     * FASE 2: Llegada al portal
     * Jugadores detectados cerca, portal se activa lentamente
     */
    private void iniciarFaseLlegada() {
        faseEvento = EventPhase.LLEGADA;
        portalActivandose = true;
        portalActivacionTicks = 0;
        
        // ========================================
        // CINEMÁTICO ÉPICO - PORTAL ACTIVANDOSE
        // ========================================
        
        if (portalLocation != null) {
            World world = portalLocation.getWorld();
            
            // 1. CAMBIAR A NOCHE INSTANTÁNEA
            world.setTime(18000); // Medianoche
            world.setStorm(true); // Iniciar tormenta
            world.setThunderDuration(12000); // Duración de la tormenta (10 minutos)
            world.setWeatherDuration(12000);
            
            plugin.getLogger().info("[Apertura End] ⚡ CINEMÁTICO ACTIVADO: Noche + Tormenta");
        }
        
        // 2. EFECTOS VISUALES MASIVOS DE OSCURIDAD PARA TODOS
        for (Player p : Bukkit.getOnlinePlayers()) {
            // Fade to black completo
            p.sendTitle("§8§l█████████████", "§8§l█████████████", 10, 60, 30);
            
            // Aplicar ceguera breve para efecto oscuro
            p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                org.bukkit.potion.PotionEffectType.BLINDNESS, 
                60, // 3 segundos
                1, 
                false, 
                false, 
                false
            ));
            
            // Sonidos de terror
            p.playSound(p.getLocation(), Sound.ENTITY_WITHER_SPAWN, 1.5f, 0.5f);
            p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 2.0f, 0.4f);
            p.playSound(p.getLocation(), Sound.AMBIENT_CAVE, 1.0f, 0.5f);
        }
        
        // 3. ANUNCIO DRÁMATICO CON RETRASO
        new BukkitRunnable() {
            @Override
            public void run() {
                // Anunciar llegada
                List<String> broadcast = config.getStringList("mensajes.fase_2_deteccion.broadcast");
                for (String msg : broadcast) {
                    Bukkit.broadcastMessage(msg);
                }
                
                // Mensajes del Observador
                Bukkit.broadcastMessage("§8[§7...§8] §7Aquí fue donde todo terminó… más de una vez.");
                
                // Título épico
                for (Player p : Bukkit.getOnlinePlayers()) {
                    p.sendTitle("§8§l⚠ §4EL PORTAL DESPIERTA", "§5Una grieta entre mundos se abre...", 10, 80, 20);
                }
            }
        }.runTaskLater(plugin, 60L); // 3 segundos después
        
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("§8[§7...§8] §7Y aun así, siguen entrando.");
            }
        }.runTaskLater(plugin, 100L);
        
        // 4. EFECTOS VISUALES MASIVOS EN EL PORTAL
        if (portalLocation != null) {
            new BukkitRunnable() {
                int ticks = 0;
                
                @Override
                public void run() {
                    if (ticks++ >= 100) { // 5 segundos
                        cancel();
                        return;
                    }
                    
                    Location loc = portalLocation.clone().add(0, 2, 0);
                    
                    // Explosión de partículas cada tick
                    portalLocation.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, loc, 100, 5, 5, 5, 1.0);
                    portalLocation.getWorld().spawnParticle(org.bukkit.Particle.DRAGON_BREATH, loc, 50, 3, 3, 3, 0.1);
                    portalLocation.getWorld().spawnParticle(org.bukkit.Particle.END_ROD, loc, 30, 2, 4, 2, 0.2);
                    portalLocation.getWorld().spawnParticle(org.bukkit.Particle.REVERSE_PORTAL, loc, 40, 3, 3, 3, 0.5);
                    
                    // Rayos ocasionales
                    if (ticks % 20 == 0) {
                        portalLocation.getWorld().strikeLightningEffect(portalLocation.clone().add(
                            random.nextInt(10) - 5, 0, random.nextInt(10) - 5
                        ));
                    }
                    
                    // Partículas de explosión
                    if (ticks % 10 == 0) {
                        portalLocation.getWorld().spawnParticle(org.bukkit.Particle.EXPLOSION_EMITTER, loc, 2);
                    }
                }
            }.runTaskTimer(plugin, 20L, 1L); // Empezar tras 1 segundo
        }
        
        // CONSTRUIR PORTAL ÉPICO (si no existe ya)
        if (portalLocation != null && !portalGenerado) {
            construirPortalEpico(portalLocation);
            portalGenerado = true;
        }
        
        // Iniciar animación de activación del portal
        activarPortalLentamente();
        
        plugin.getLogger().info("[Apertura End] Fase 2: LLEGADA - Portal activándose (CINEMÁTICO)");
    }
    
    /**
     * FASE 2: Activación lenta del portal (10 segundos)
     */
    private void activarPortalLentamente() {
        bossBar.setTitle("§8El portal se activa...");
        bossBar.setColor(BarColor.WHITE);
        
        new BukkitRunnable() {
            int ticks = 0;
            
            @Override
            public void run() {
                if (faseEvento != EventPhase.LLEGADA) {
                    cancel();
                    return;
                }
                
                ticks++;
                portalActivacionTicks = ticks;
                
                // Partículas y sonidos incrementales durante la activación
                if (portalLocation != null && ticks % 10 == 0) {
                    Location loc = portalLocation.clone().add(0, 1, 0);
                    
                    // Intensidad creciente
                    int intensidad = (ticks * 20) / 200; // 0-20 durante 200 ticks
                    
                    portalLocation.getWorld().spawnParticle(
                        org.bukkit.Particle.END_ROD, 
                        loc, 
                        10 + intensidad, 
                        2, 2, 2, 
                        0.02
                    );
                    
                    portalLocation.getWorld().spawnParticle(
                        org.bukkit.Particle.PORTAL,
                        loc,
                        15 + intensidad,
                        1.5, 1.5, 1.5,
                        0.05
                    );
                    
                    for (Player player : Bukkit.getOnlinePlayers()) {
                        if (player.getWorld().equals(portalLocation.getWorld())) {
                            player.playSound(portalLocation, Sound.BLOCK_END_PORTAL_SPAWN, 0.5f + (ticks / 200.0f), 0.8f);
                        }
                    }
                }
                
                // Después de 10 segundos (200 ticks), portal activado
                if (ticks >= 200) {
                    portalActivado();
                    cancel();
                }
            }
        }.runTaskTimer(plugin, 0L, 1L);
    }
    
    /**
     * FASE 2: Portal completamente activado
     * Esperando a que jugadores entren al End
     */
    private void portalActivado() {
        faseEvento = EventPhase.PORTAL_ABIERTO;
        
        // Título y mensaje
        String titulo = config.getString("mensajes.fase_2_activacion.titulo", "§8§l...");
        String subtitulo = config.getString("mensajes.fase_2_activacion.subtitulo", "§7El portal está activo");
        
        for (Player player : Bukkit.getOnlinePlayers()) {
            player.sendTitle(titulo, subtitulo, 10, 60, 20);
            player.playSound(player.getLocation(), Sound.BLOCK_END_PORTAL_SPAWN, 2.0f, 0.8f);
            player.playSound(player.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 1.5f, 0.5f);
        }
        
        // Broadcast
        List<String> broadcast = config.getStringList("mensajes.fase_2_activacion.broadcast");
        for (String msg : broadcast) {
            Bukkit.broadcastMessage(msg);
        }
        
        Bukkit.broadcastMessage("§8El portal espera.");
        
        bossBar.setTitle("§8El portal está activo - Entra al End");
        bossBar.setColor(BarColor.PURPLE);
        
        // INICIAR EFECTOS ÉPICOS DEL PORTAL
        if (portalLocation != null) {
            iniciarEfectosPortalEpico(portalLocation.clone().add(0, 1, 0));
        }
        
        // Detectar cuando jugadores entren al End
        detectarEntradaEnd();
        
        plugin.getLogger().info("[Apertura End] Fase 2: Portal activado - Esperando jugadores");
    }
    
    private void detectarEntradaEnd() {
        mainTask = new BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.PORTAL_ABIERTO) {
                    cancel();
                    return;
                }
                
                // Contar jugadores en el End
                long jugadoresEnEnd = Bukkit.getOnlinePlayers().stream()
                    .filter(p -> p.getWorld().getEnvironment() == World.Environment.THE_END)
                    .count();
                
                if (jugadoresEnEnd >= 1) {
                    AperturaEndEvent.this.iniciarFaseCombate();
                    this.cancel();
                }
            }
        }.runTaskTimer(plugin, 0L, 20L);
    }
    
    /**
     * FASE 3: Combate (End)
     * Los jugadores entraron al End, comienza la batalla
     * Llamar este método cuando se detecte que jugadores entraron al End
     */
    public void iniciarFaseCombate() {
        faseEvento = EventPhase.COMBATE;
        faseDragon = DragonPhase.FASE_1_AEREO;
        
        // Mensajes del Observador al entrar
        List<String> broadcast = config.getStringList("mensajes.fase_3_entrada_end.broadcast");
        for (String msg : broadcast) {
            Bukkit.broadcastMessage(msg);
        }
        
        Bukkit.broadcastMessage("§8[§7...§8] §7No es el mismo lugar.");
        
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("§8[§7...§8] §7Nunca lo es.");
            }
        }.runTaskLater(plugin, 40L);
        
        // ═══════════════════════════════════════════════════════════════
        // ARENA YA GENERADA AL INICIO (onStart) - Esperar a spawn de dragón
        // ═══════════════════════════════════════════════════════════════
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§5§l⚡ La arena aguarda tu destino ⚡");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        
        // Esperar 20 segundos antes de spawnear el dragón (tensión)
        new BukkitRunnable() {
            int ticks = 0;
            
            @Override
            public void run() {
                ticks++;
                
                // Efectos de tensión
                if (ticks % 40 == 0) {
                    for (Player player : Bukkit.getOnlinePlayers()) {
                        if (player.getWorld().getEnvironment() == World.Environment.THE_END) {
                            player.playSound(player.getLocation(), Sound.AMBIENT_CAVE, 1.0f, 0.3f);
                            player.spawnParticle(org.bukkit.Particle.SMOKE, player.getLocation(), 10, 2, 2, 2, 0.01);
                        }
                    }
                }
                
                // Después de 20 segundos, spawnear dragón
                if (ticks >= 400) {
                    spawnearDragon();
                    cancel();
                }
            }
        }.runTaskTimer(plugin, 0L, 1L);
        
        plugin.getLogger().info("[Apertura End] Fase 3: COMBATE - Tensión antes del dragón");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * GENERAR ARENA ÉPICA LEGENDARIA DE BATALLA EN EL END
     * ═══════════════════════════════════════════════════════════════════
     * Crea una FORTALEZA MASIVA en el centro del End (0,0) con:
     * - Plataforma principal de 80x80 bloques (4 capas)
     * - 12 pilares COLOSALES de 45 bloques con faros
     * - 4 torres esquineras MASIVAS de 35 bloques
     * - ALTAR CENTRAL elevado con portal End decorativo
     * - PUENTES de obsidiana llorona conectando pilares
     * - MURALLAS con almenas alrededor del perímetro
     * - Runas luminosas en círculos concéntricos (5 anillos)
     * - FOSAS de lava/agua entre anillos
     * - 80+ fragmentos flotantes gigantes
     * - 20+ cristales gigantes de amatista (20 bloques)
     * - ESCALERAS monumentales hacia el altar
     * - ESTATUAS de guardianes End en esquinas
     * - Sistema de iluminación MASIVO épico
     */
    private void generarArenaEpicaBatalla(World endWorld) {
        // Centro de la arena (isla principal del End)
        int centerX = 0;
        int centerY = 64; // Altura de la plataforma principal
        int centerZ = 0;
        
        plugin.getLogger().info("[Apertura End] ⚡⚡⚡ Generando ARENA DE BATALLA ÉPICA (ESPACIO AMPLIO) ⚡⚡⚡");
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 1: LIMPIAR ÁREA MASIVA - 150 BLOQUES DE RADIO (300x300)
        // ═══════════════════════════════════════════════════════════════
        limpiarAreaBatalla(endWorld, centerX, centerY, centerZ, 150);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 2: PLATAFORMA DE SPAWN MEJORADA (donde aparecen los jugadores)
        // ═══════════════════════════════════════════════════════════════
        construirPlataformaSpawnEpica(endWorld, 100, 48, 0);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 3: PUENTE MONUMENTAL desde plataforma spawn al centro
        // ═══════════════════════════════════════════════════════════════
        construirPuenteMonumental(endWorld, 100, 48, 0, centerX, centerY, centerZ);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 4: PLATAFORMA PRINCIPAL MASIVA (100x100, 4 capas)
        // ═══════════════════════════════════════════════════════════════
        construirPlataformaBatallaEpica(endWorld, centerX, centerY, centerZ);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 5: ALTAR CENTRAL ELEVADO CON PORTAL DECORATIVO
        // ═══════════════════════════════════════════════════════════════
        construirAltarCentral(endWorld, centerX, centerY, centerZ);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 6: 8 PILARES EN PERÍMETRO (altura 30 bloques, MÁS SEPARADOS)
        // ═══════════════════════════════════════════════════════════════
        construirPilaresBatallaEspaciados(endWorld, centerX, centerY, centerZ);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 7: RUNAS LUMINOSAS SIMPLES (solo 2 círculos)
        // ═══════════════════════════════════════════════════════════════
        construirRunasLuminosasSimples(endWorld, centerX, centerY, centerZ);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 8: FRAGMENTOS FLOTANTES REDUCIDOS (20-30 bloques, MÁS ALTOS)
        // ═══════════════════════════════════════════════════════════════
        generarFragmentosFlotantesReducidos(endWorld, centerX, centerY, centerZ);
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 9: CRISTALES DECORATIVOS MÍNIMOS (solo 8 cristales en bordes)
        // ═══════════════════════════════════════════════════════════════
        generarCristalesMinimos(endWorld, centerX, centerY, centerZ);
        
        // ELEMENTOS ELIMINADOS PARA MÁS ESPACIO:
        // ✗ Puentes entre pilares (obstruían el combate aéreo)
        // ✗ Torres esquineras (bloqueaban movimiento)
        // ✗ Murallas con almenas (limitaban el espacio)
        // ✗ Fosas de lava/agua (peligro innecesario)
        // ✗ Escaleras monumentales (ocupaban espacio)
        // ✗ Estatuas de guardianes (decoración excesiva)
        
        // ═══════════════════════════════════════════════════════════════
        // PASO 10: EFECTOS VISUALES SUTILES (no invasivos)
        // ═══════════════════════════════════════════════════════════════
        iniciarEfectosArenaBatalla(new Location(endWorld, centerX, centerY + 5, centerZ));
        
        plugin.getLogger().info("[Apertura End] ✓✓✓ ARENA DE BATALLA ESPACIOSA generada exitosamente");
        plugin.getLogger().info("[Apertura End] ✓ Plataforma spawn: 25x25 bloques en (100, 48, 0)");
        plugin.getLogger().info("[Apertura End] ✓ Puente monumental: 100 bloques desde spawn a centro");
        plugin.getLogger().info("[Apertura End] ✓ Área de combate: 300x300 bloques (150 radio)");
        plugin.getLogger().info("[Apertura End] ✓ Plataforma principal: 100x100 bloques");
        plugin.getLogger().info("[Apertura End] ✓ Elementos decorativos: MINIMIZADOS para máximo espacio");
    }
    
    /**
     * Limpia el área de batalla removiendo pilares vanilla y nivelando terreno
     * VERSIÓN MEJORADA: Limpieza masiva y terraformación completa del End
     */
    private void limpiarAreaBatalla(World world, int centerX, int centerY, int centerZ, int radius) {
        plugin.getLogger().info("[Arena End] Limpiando área de " + (radius*2) + "x" + (radius*2) + " bloques...");
        
        int bloquesRemovidos = 0;
        
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                // LIMPIEZA VERTICAL MASIVA: Remover TODO desde el suelo hasta altura 120
                for (int y = centerY - 20; y <= 120; y++) {
                    Block block = world.getBlockAt(centerX + x, y, centerZ + z);
                    Material type = block.getType();
                    
                    // Remover TODOS los bloques que no sean AIR o BEDROCK
                    // Esto incluye: obsidiana vanilla, pilares, end stone natural, etc.
                    if (type != Material.AIR && type != Material.BEDROCK && type != Material.BARRIER) {
                        block.setType(Material.AIR);
                        bloquesRemovidos++;
                    }
                }
                
                // NIVELAR TERRENO BASE: Crear plataforma base de end stone
                for (int y = centerY - 20; y < centerY - 3; y++) {
                    Block block = world.getBlockAt(centerX + x, y, centerZ + z);
                    if (dist < radius - 10) {
                        block.setType(Material.END_STONE);
                    }
                }
            }
        }
        
        plugin.getLogger().info("[Arena End] ✓ Limpieza completada - " + bloquesRemovidos + " bloques removidos");
        plugin.getLogger().info("[Arena End] ✓ Área totalmente despejada y nivelada");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * CONSTRUIR PLATAFORMA DE SPAWN ÉPICA (donde aparecen los jugadores)
     * ═══════════════════════════════════════════════════════════════════
     * Mejora la plataforma de obsidiana 5x5 vanilla transformándola en:
     * - Base masiva de 25x25 bloques (5 capas)
     * - Torres de bienvenida en las esquinas (15 bloques altura)
     * - Portal decorativo de entrada con efectos
     * - Iluminación con faroles de almas
     * - Runas de protección en el suelo
     * - Mirador hacia el puente monumental
     */
    private void construirPlataformaSpawnEpica(World world, int spawnX, int spawnY, int spawnZ) {
        plugin.getLogger().info("[Arena End] Construyendo plataforma de spawn épica en (" + spawnX + ", " + spawnY + ", " + spawnZ + ")...");
        
        int radius = 12; // Plataforma de 25x25 bloques
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA -3 (CIMIENTOS): Netherite decorativo
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                Material mat = (dist < 4) ? Material.NETHERITE_BLOCK : Material.POLISHED_DEEPSLATE;
                world.getBlockAt(spawnX + x, spawnY - 3, spawnZ + z).setType(mat);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA -2 (BASE SÓLIDA): Blackstone
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                world.getBlockAt(spawnX + x, spawnY - 2, spawnZ + z).setType(Material.POLISHED_BLACKSTONE_BRICKS);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA -1 (DECORACIÓN): Obsidiana llorona con patrón
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                Material mat;
                if (dist < 3) {
                    mat = Material.CRYING_OBSIDIAN; // Centro épico
                } else if (dist < 7) {
                    mat = Material.OBSIDIAN; // Anillo intermedio
                } else {
                    mat = Material.CHISELED_POLISHED_BLACKSTONE; // Borde
                }
                world.getBlockAt(spawnX + x, spawnY - 1, spawnZ + z).setType(mat);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA 0 (SUPERFICIE): Obsidiana + runas luminosas
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                Block surface = world.getBlockAt(spawnX + x, spawnY, spawnZ + z);
                
                // Plataforma principal de obsidiana
                if (dist < 10) {
                    surface.setType(Material.OBSIDIAN);
                }
                
                // Runas luminosas en círculo (radio 6 bloques)
                if (dist > 5.5 && dist < 6.5 && Math.random() < 0.3) {
                    surface.setType(Material.GLOWSTONE);
                }
                
                // Iluminación en borde con faroles de almas
                if (dist > 9 && dist < 11 && (x % 4 == 0 || z % 4 == 0)) {
                    surface.setType(Material.POLISHED_BLACKSTONE);
                    world.getBlockAt(spawnX + x, spawnY + 1, spawnZ + z).setType(Material.SOUL_LANTERN);
                }
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // TORRES DE BIENVENIDA EN LAS 4 ESQUINAS (altura 15 bloques)
        // ═══════════════════════════════════════════════════════════════
        int[][] esquinas = {{10, 10}, {-10, 10}, {10, -10}, {-10, -10}};
        
        for (int[] esquina : esquinas) {
            int tX = spawnX + esquina[0];
            int tZ = spawnZ + esquina[1];
            
            // Base de la torre (3x3)
            for (int xOff = -1; xOff <= 1; xOff++) {
                for (int zOff = -1; zOff <= 1; zOff++) {
                    world.getBlockAt(tX + xOff, spawnY - 1, tZ + zOff).setType(Material.NETHERITE_BLOCK);
                    world.getBlockAt(tX + xOff, spawnY, tZ + zOff).setType(Material.POLISHED_BLACKSTONE_BRICKS);
                }
            }
            
            // Cuerpo de la torre (columna central)
            for (int y = 1; y <= 15; y++) {
                Material mat = (y % 4 == 0) ? Material.PURPUR_PILLAR : Material.POLISHED_BLACKSTONE_BRICKS;
                world.getBlockAt(tX, spawnY + y, tZ).setType(mat);
                
                // Decoración con glowstone cada 5 bloques
                if (y % 5 == 0) {
                    world.getBlockAt(tX + 1, spawnY + y, tZ).setType(Material.GLOWSTONE);
                    world.getBlockAt(tX - 1, spawnY + y, tZ).setType(Material.GLOWSTONE);
                    world.getBlockAt(tX, spawnY + y, tZ + 1).setType(Material.GLOWSTONE);
                    world.getBlockAt(tX, spawnY + y, tZ - 1).setType(Material.GLOWSTONE);
                }
            }
            
            // Cima de la torre: Sea Lantern
            for (int xOff = -1; xOff <= 1; xOff++) {
                for (int zOff = -1; zOff <= 1; zOff++) {
                    world.getBlockAt(tX + xOff, spawnY + 16, tZ + zOff).setType(Material.SEA_LANTERN);
                }
            }
            
            // Antorcha de End Rod en la cima
            world.getBlockAt(tX, spawnY + 17, tZ).setType(Material.END_ROD);
            world.getBlockAt(tX, spawnY + 18, tZ).setType(Material.END_ROD);
        }
        
        // ═══════════════════════════════════════════════════════════════
        // PORTAL DECORATIVO DE ENTRADA (arco de bienvenida)
        // ═══════════════════════════════════════════════════════════════
        // Dos pilares a los lados (hacia el +X donde inicia el puente)
        for (int y = 0; y <= 8; y++) {
            world.getBlockAt(spawnX - 10, spawnY + y, spawnZ - 2).setType(Material.CRYING_OBSIDIAN);
            world.getBlockAt(spawnX - 10, spawnY + y, spawnZ + 2).setType(Material.CRYING_OBSIDIAN);
        }
        
        // Arco superior conectando los pilares
        for (int z = -2; z <= 2; z++) {
            world.getBlockAt(spawnX - 10, spawnY + 8, spawnZ + z).setType(Material.CRYING_OBSIDIAN);
        }
        
        // Decoración del arco con cadenas
        world.getBlockAt(spawnX - 10, spawnY + 7, spawnZ - 1).setType(Material.CHAIN);
        world.getBlockAt(spawnX - 10, spawnY + 7, spawnZ + 1).setType(Material.CHAIN);
        world.getBlockAt(spawnX - 10, spawnY + 6, spawnZ).setType(Material.RESPAWN_ANCHOR);
        
        plugin.getLogger().info("[Arena End] ✓ Plataforma de spawn 25x25 construida con torres y portal");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * CONSTRUIR PUENTE MONUMENTAL desde spawn hacia la plataforma central
     * ═══════════════════════════════════════════════════════════════════
     * Crea un puente épico de ~100 bloques que conecta la plataforma de
     * spawn con la arena central de batalla:
     * - Ancho de 7 bloques (camino cómodo)
     * - Barandillas de cadenas y linternas
     * - Pilares de soporte cada 15 bloques
     * - Arcos decorativos cada 30 bloques
     * - Rampa gradual ascendente (de Y=48 a Y=64)
     * - Iluminación con glowstone y sea lanterns
     * - Efectos de partículas en puntos clave
     */
    private void construirPuenteMonumental(World world, int startX, int startY, int startZ, 
                                           int endX, int endY, int endZ) {
        plugin.getLogger().info("[Arena End] Construyendo puente monumental desde spawn a centro...");
        
        // Calcular dirección y distancia
        double dx = endX - startX;
        double dy = endY - startY;
        double dz = endZ - startZ;
        double distancia = Math.sqrt(dx * dx + dz * dz);
        int pasos = (int) distancia;
        
        // Vectores unitarios para dirección
        double ux = dx / distancia;
        double uz = dz / distancia;
        
        // Vector perpendicular para el ancho del puente
        double perpX = -uz;
        double perpZ = ux;
        
        int anchoPuente = 3; // Radio 3 = ancho total 7 bloques
        int pilaresConstruidos = 0;
        
        // ═══════════════════════════════════════════════════════════════
        // CONSTRUIR PUENTE BLOQUE POR BLOQUE
        // ═══════════════════════════════════════════════════════════════
        for (int paso = -10; paso < pasos + 5; paso++) {
            // Posición actual en el puente (con rampa gradual)
            int currentX = (int) (startX + ux * paso);
            int currentZ = (int) (startZ + uz * paso);
            int currentY = (int) (startY + (dy * paso / pasos)); // Rampa suave
            
            // ═══════════════════════════════════════════════════════════
            // SUPERFICIE DEL PUENTE (ancho 7 bloques)
            // ═══════════════════════════════════════════════════════════
            for (int w = -anchoPuente; w <= anchoPuente; w++) {
                int bX = (int) (currentX + perpX * w);
                int bZ = (int) (currentZ + perpZ * w);
                
                // Capa base del puente (Y-1)
                world.getBlockAt(bX, currentY - 1, bZ).setType(Material.POLISHED_BLACKSTONE_BRICKS);
                
                // Superficie del puente (Y)
                Material surfaceMat;
                if (Math.abs(w) == anchoPuente) {
                    // Bordes con crying obsidian
                    surfaceMat = Material.CRYING_OBSIDIAN;
                } else if (Math.abs(w) == 0) {
                    // Centro con línea decorativa
                    surfaceMat = (paso % 4 == 0) ? Material.POLISHED_BLACKSTONE : Material.CHISELED_POLISHED_BLACKSTONE;
                } else {
                    // Resto del camino
                    surfaceMat = Material.POLISHED_BLACKSTONE;
                }
                world.getBlockAt(bX, currentY, bZ).setType(surfaceMat);
                
                // Limpiar espacio arriba para caminar
                for (int clearY = 1; clearY <= 4; clearY++) {
                    Block airBlock = world.getBlockAt(bX, currentY + clearY, bZ);
                    if (airBlock.getType() != Material.AIR) {
                        airBlock.setType(Material.AIR);
                    }
                }
            }
            
            // ═══════════════════════════════════════════════════════════
            // BARANDILLAS CON CADENAS Y LINTERNAS (cada 3 bloques)
            // ═══════════════════════════════════════════════════════════
            if (paso % 3 == 0) {
                for (int lado : new int[]{-anchoPuente - 1, anchoPuente + 1}) {
                    int railX = (int) (currentX + perpX * lado);
                    int railZ = (int) (currentZ + perpZ * lado);
                    
                    // Poste de barandilla
                    world.getBlockAt(railX, currentY, railZ).setType(Material.POLISHED_BLACKSTONE_WALL);
                    world.getBlockAt(railX, currentY + 1, railZ).setType(Material.CHAIN);
                    world.getBlockAt(railX, currentY + 2, railZ).setType(Material.CHAIN);
                    
                    // Linterna cada 6 bloques
                    if (paso % 6 == 0) {
                        world.getBlockAt(railX, currentY + 3, railZ).setType(Material.SOUL_LANTERN);
                    }
                }
            }
            
            // ═══════════════════════════════════════════════════════════
            // PILARES DE SOPORTE MASIVOS (cada 15 bloques)
            // ═══════════════════════════════════════════════════════════
            if (paso % 15 == 0 && paso > 0 && paso < pasos - 5) {
                pilaresConstruidos++;
                
                // Pilares en ambos lados del puente
                for (int lado : new int[]{-4, 4}) {
                    int pilarX = (int) (currentX + perpX * lado);
                    int pilarZ = (int) (currentZ + perpZ * lado);
                    
                    // Base del pilar (3x3)
                    for (int xOff = -1; xOff <= 1; xOff++) {
                        for (int zOff = -1; zOff <= 1; zOff++) {
                            world.getBlockAt(pilarX + xOff, currentY - 2, pilarZ + zOff).setType(Material.NETHERITE_BLOCK);
                            world.getBlockAt(pilarX + xOff, currentY - 1, pilarZ + zOff).setType(Material.POLISHED_BLACKSTONE);
                        }
                    }
                    
                    // Columna del pilar (altura variable 8-12 bloques)
                    int alturaPilar = 8 + (pilaresConstruidos % 3) * 2;
                    for (int y = 0; y < alturaPilar; y++) {
                        Material pilarMat = (y % 3 == 0) ? Material.PURPUR_PILLAR : Material.POLISHED_BLACKSTONE_BRICKS;
                        world.getBlockAt(pilarX, currentY + y, pilarZ).setType(pilarMat);
                        
                        // Decoración luminosa
                        if (y % 4 == 0 && y > 0) {
                            world.getBlockAt(pilarX + 1, currentY + y, pilarZ).setType(Material.GLOWSTONE);
                            world.getBlockAt(pilarX - 1, currentY + y, pilarZ).setType(Material.GLOWSTONE);
                        }
                    }
                    
                    // Cima del pilar
                    world.getBlockAt(pilarX, currentY + alturaPilar, pilarZ).setType(Material.SEA_LANTERN);
                    world.getBlockAt(pilarX, currentY + alturaPilar + 1, pilarZ).setType(Material.END_ROD);
                }
            }
            
            // ═══════════════════════════════════════════════════════════
            // ARCOS DECORATIVOS MASIVOS (cada 30 bloques)
            // ═══════════════════════════════════════════════════════════
            if (paso % 30 == 0 && paso > 5 && paso < pasos - 5) {
                // Arco que cruza por encima del puente
                for (int w = -5; w <= 5; w++) {
                    int arcoX = (int) (currentX + perpX * w);
                    int arcoZ = (int) (currentZ + perpZ * w);
                    
                    // Estructura del arco (parabólico)
                    int arcoY = currentY + 5 - (int)(Math.abs(w) * 0.3);
                    world.getBlockAt(arcoX, arcoY, arcoZ).setType(Material.CRYING_OBSIDIAN);
                    
                    // Pilares del arco
                    if (Math.abs(w) == 5) {
                        for (int y = 1; y <= 5; y++) {
                            world.getBlockAt(arcoX, currentY + y, arcoZ).setType(Material.CRYING_OBSIDIAN);
                        }
                    }
                }
                
                // Decoración central del arco
                world.getBlockAt(currentX, currentY + 5, currentZ).setType(Material.RESPAWN_ANCHOR);
            }
            
            // ═══════════════════════════════════════════════════════════
            // ILUMINACIÓN ADICIONAL (glowstone oculto bajo el puente)
            // ═══════════════════════════════════════════════════════════
            if (paso % 4 == 0) {
                world.getBlockAt(currentX, currentY - 2, currentZ).setType(Material.GLOWSTONE);
            }
        }
        
        plugin.getLogger().info("[Arena End] ✓ Puente monumental construido:");
        plugin.getLogger().info("[Arena End]   - Longitud: " + pasos + " bloques");
        plugin.getLogger().info("[Arena End]   - Ancho: 7 bloques");
        plugin.getLogger().info("[Arena End]   - Pilares de soporte: " + pilaresConstruidos);
        plugin.getLogger().info("[Arena End]   - Rampa de Y=" + startY + " a Y=" + endY);
    }
    
    /**
     * Construye plataforma MASIVA épica multicapa con diseño concéntrico (100x100)
     * ═══════════════════════════════════════════════════════════════════
     * VERSIÓN MEJORADA CON TERRAFORMACIÓN ÉPICA:
     * - Base profunda de 4 capas con materiales variados
     * - Anillos concéntricos con diferentes bloques
     * - Círculo de runas luminosas (radio 20, 35, 45)
     * - Foso decorativo de lava en anillo exterior (opcional)
     * - Iluminación estratégica con glowstone y sea lanterns
     * - Patrón de estrella en el centro (radio 8)
     * - Bordes elevados con murallas bajas (altura 1)
     * - Caminos radiales desde el centro hacia los bordes
     * ═══════════════════════════════════════════════════════════════════
     */
    private void construirPlataformaBatallaEpica(World world, int centerX, int centerY, int centerZ) {
        int radius = 50; // Plataforma de 100x100 (AMPLIADO desde 80x80)
        
        plugin.getLogger().info("[Arena End] Construyendo plataforma épica 100x100...");
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA -3 (CIMIENTOS PROFUNDOS): Patrón de netherite y bedrock
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                Material mat;
                if (dist < 8) {
                    mat = Material.ANCIENT_DEBRIS; // Centro antiguo
                } else if (dist < 25) {
                    mat = (Math.random() < 0.3) ? Material.NETHERITE_BLOCK : Material.POLISHED_DEEPSLATE;
                } else {
                    mat = Material.BLACKSTONE;
                }
                world.getBlockAt(centerX + x, centerY - 3, centerZ + z).setType(mat);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA -2 (CIMIENTOS): Obsidiana y End Stone Bricks
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                Material mat;
                if (dist < 10) {
                    mat = Material.CRYING_OBSIDIAN; // Centro llorón
                } else if (dist < 25) {
                    mat = Material.OBSIDIAN;
                } else {
                    mat = Material.END_STONE_BRICKS;
                }
                world.getBlockAt(centerX + x, centerY - 2, centerZ + z).setType(mat);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA -1 (BASE): Patrón concéntrico ÉPICO con 5 anillos
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                Material mat;
                if (dist < 6) {
                    // Centro: Estrella de crying obsidian
                    double angle = Math.atan2(z, x);
                    boolean esEstrella = (Math.cos(angle * 5) > 0.6);
                    mat = esEstrella ? Material.CRYING_OBSIDIAN : Material.OBSIDIAN;
                } else if (dist < 12) {
                    mat = Material.NETHERITE_BLOCK; // Anillo 1: Poder
                } else if (dist < 22) {
                    mat = Material.POLISHED_BLACKSTONE_BRICKS; // Anillo 2: Elegancia
                } else if (dist < 35) {
                    mat = Material.CHISELED_POLISHED_BLACKSTONE; // Anillo 3: Detalle
                } else if (dist < 46) {
                    mat = Material.END_STONE_BRICKS; // Anillo 4: Transición
                } else {
                    mat = Material.END_STONE; // Borde exterior
                }
                
                world.getBlockAt(centerX + x, centerY - 1, centerZ + z).setType(mat);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CAPA 0 (SUPERFICIE): Runas, iluminación y caminos radiales
        // ═══════════════════════════════════════════════════════════════
        for (int x = -radius; x <= radius; x++) {
            for (int z = -radius; z <= radius; z++) {
                double dist = Math.sqrt(x * x + z * z);
                if (dist > radius) continue;
                
                Block surface = world.getBlockAt(centerX + x, centerY, centerZ + z);
                double angle = Math.atan2(z, x);
                
                // ═══════════════════════════════════════════════════════
                // CAMINOS RADIALES (8 direcciones desde el centro)
                // ═══════════════════════════════════════════════════════
                boolean esCamino = false;
                for (int i = 0; i < 8; i++) {
                    double caminoAngle = (i * Math.PI / 4);
                    double angleDiff = Math.abs(angle - caminoAngle);
                    if (angleDiff < 0.08 && dist > 12 && dist < 45) { // Ancho ~1.5 bloques
                        esCamino = true;
                        surface.setType(Material.POLISHED_BLACKSTONE);
                        break;
                    }
                }
                
                if (esCamino) continue; // Saltar si ya es camino
                
                // ═══════════════════════════════════════════════════════
                // CÍRCULOS DE RUNAS LUMINOSAS (3 anillos)
                // ═══════════════════════════════════════════════════════
                // Anillo 1: Radio 20 bloques
                if (dist > 19.5 && dist < 20.5) {
                    if (Math.random() < 0.25) {
                        surface.setType(Material.GLOWSTONE);
                    }
                }
                
                // Anillo 2: Radio 35 bloques
                if (dist > 34.5 && dist < 35.5) {
                    if (Math.random() < 0.20) {
                        surface.setType(Material.SEA_LANTERN);
                    }
                }
                
                // Anillo 3: Radio 45 bloques (borde)
                if (dist > 44.5 && dist < 45.5) {
                    if (Math.random() < 0.15) {
                        surface.setType(Material.GLOWSTONE);
                    }
                }
                
                // ═══════════════════════════════════════════════════════
                // ILUMINACIÓN DISPERSA ESTRATÉGICA
                // ═══════════════════════════════════════════════════════
                if (dist > 15 && dist < 43 && Math.random() < 0.03) {
                    surface.setType(Material.GLOWSTONE);
                }
                
                // ═══════════════════════════════════════════════════════
                // MURALLAS BAJAS EN EL BORDE (altura 1 bloque)
                // ═══════════════════════════════════════════════════════
                if (dist > 48 && dist < 49) {
                    surface.setType(Material.POLISHED_BLACKSTONE_WALL);
                }
                
                // ═══════════════════════════════════════════════════════
                // PEDESTALES DECORATIVOS EN INTERSECCIONES
                // ═══════════════════════════════════════════════════════
                // Pedestales en intersección de caminos con círculos de runas
                if ((Math.abs(dist - 20) < 0.5 || Math.abs(dist - 35) < 0.5)) {
                    for (int i = 0; i < 8; i++) {
                        double pedAngle = (i * Math.PI / 4);
                        if (Math.abs(angle - pedAngle) < 0.05) {
                            world.getBlockAt(centerX + x, centerY, centerZ + z).setType(Material.CHISELED_POLISHED_BLACKSTONE);
                            world.getBlockAt(centerX + x, centerY + 1, centerZ + z).setType(Material.SOUL_LANTERN);
                            break;
                        }
                    }
                }
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // CENTRO ÉPICO: ALTAR ELEVADO (5x5 bloques, altura 3)
        // ═══════════════════════════════════════════════════════════════
        for (int x = -2; x <= 2; x++) {
            for (int z = -2; z <= 2; z++) {
                double distCenter = Math.sqrt(x * x + z * z);
                if (distCenter > 2.5) continue;
                
                // Nivel 1: Base del altar
                world.getBlockAt(centerX + x, centerY + 1, centerZ + z).setType(Material.CRYING_OBSIDIAN);
                
                // Nivel 2: Cuerpo del altar
                if (Math.abs(x) <= 1 && Math.abs(z) <= 1) {
                    world.getBlockAt(centerX + x, centerY + 2, centerZ + z).setType(Material.OBSIDIAN);
                }
                
                // Nivel 3: Cima del altar (solo centro)
                if (x == 0 && z == 0) {
                    world.getBlockAt(centerX, centerY + 3, centerZ).setType(Material.RESPAWN_ANCHOR);
                }
            }
        }
        
        // Antorchas de End Rod en las esquinas del altar
        world.getBlockAt(centerX + 2, centerY + 2, centerZ + 2).setType(Material.END_ROD);
        world.getBlockAt(centerX - 2, centerY + 2, centerZ + 2).setType(Material.END_ROD);
        world.getBlockAt(centerX + 2, centerY + 2, centerZ - 2).setType(Material.END_ROD);
        world.getBlockAt(centerX - 2, centerY + 2, centerZ - 2).setType(Material.END_ROD);
        
        plugin.getLogger().info("[Arena End] ✓ Plataforma épica 100x100 construida:");
        plugin.getLogger().info("[Arena End]   - 5 anillos concéntricos");
        plugin.getLogger().info("[Arena End]   - 8 caminos radiales");
        plugin.getLogger().info("[Arena End]   - 3 círculos de runas luminosas");
        plugin.getLogger().info("[Arena End]   - Altar central elevado");
    }
    
    /**
     * Construye 12 pilares COLOSALES monumentales alrededor de la arena (40-45 bloques)
     */
    private void construirPilaresBatalla(World world, int centerX, int centerY, int centerZ) {
        int[] distancias = {32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32};
        int[] alturas = {42, 40, 44, 41, 43, 39, 45, 42, 40, 43, 41, 44};
        
        for (int i = 0; i < 12; i++) {
            double angle = (i * Math.PI * 2) / 12;
            int x = centerX + (int)(Math.cos(angle) * distancias[i]);
            int z = centerZ + (int)(Math.sin(angle) * distancias[i]);
            int altura = alturas[i];
            
            // Base del pilar EXPANDIDA (7x7)
            for (int xOff = -3; xOff <= 3; xOff++) {
                for (int zOff = -3; zOff <= 3; zOff++) {
                    world.getBlockAt(x + xOff, centerY - 3, z + zOff).setType(Material.NETHERITE_BLOCK);
                    world.getBlockAt(x + xOff, centerY - 2, z + zOff).setType(Material.POLISHED_BLACKSTONE);
                    world.getBlockAt(x + xOff, centerY - 1, z + zOff).setType(Material.CHISELED_POLISHED_BLACKSTONE);
                }
            }
            
            // Pedestales decorativos (esquinas de la base)
            world.getBlockAt(x + 3, centerY, z + 3).setType(Material.CRYING_OBSIDIAN);
            world.getBlockAt(x - 3, centerY, z + 3).setType(Material.CRYING_OBSIDIAN);
            world.getBlockAt(x + 3, centerY, z - 3).setType(Material.CRYING_OBSIDIAN);
            world.getBlockAt(x - 3, centerY, z - 3).setType(Material.CRYING_OBSIDIAN);
            
            // Cuerpo del pilar MASIVO (5x5 en base, 3x3 en centro, 1x1 en punta)
            for (int y = 0; y < altura; y++) {
                Material mat = (y % 6 == 0) ? Material.PURPUR_PILLAR : Material.POLISHED_BLACKSTONE_BRICKS;
                
                // Determinar tamaño según altura
                int size = (y < altura / 4) ? 2 : (y < altura * 3 / 4) ? 1 : 0;
                
                for (int xOff = -size; xOff <= size; xOff++) {
                    for (int zOff = -size; zOff <= size; zOff++) {
                        world.getBlockAt(x + xOff, centerY + y, z + zOff).setType(mat);
                        
                        // Decoración con glowstone cada 8 bloques
                        if (y % 8 == 0 && Math.abs(xOff) + Math.abs(zOff) == size * 2) {
                            world.getBlockAt(x + xOff, centerY + y, z + zOff).setType(Material.GLOWSTONE);
                        }
                    }
                }
                
                // Líneas verticales de redstone para efecto
                if (y % 3 == 0 && y > 5 && y < altura - 5) {
                    world.getBlockAt(x + size + 1, centerY + y, z).setType(Material.REDSTONE_BLOCK);
                    world.getBlockAt(x - size - 1, centerY + y, z).setType(Material.REDSTONE_BLOCK);
                    world.getBlockAt(x, centerY + y, z + size + 1).setType(Material.REDSTONE_BLOCK);
                    world.getBlockAt(x, centerY + y, z - size - 1).setType(Material.REDSTONE_BLOCK);
                }
            }
            
            // CIMA DEL PILAR - Faro ÉPICO (5x5)
            for (int xOff = -1; xOff <= 1; xOff++) {
                for (int zOff = -1; zOff <= 1; zOff++) {
                    world.getBlockAt(x + xOff, centerY + altura, z + zOff).setType(Material.SEA_LANTERN);
                }
            }
            
            // Torre de End Rods en la cima
            for (int y = 1; y <= 5; y++) {
                world.getBlockAt(x, centerY + altura + y, z).setType(Material.END_ROD);
            }
            
            // Corona luminosa MASIVA (8 bloques alrededor del faro)
            world.getBlockAt(x + 2, centerY + altura, z).setType(Material.GLOWSTONE);
            world.getBlockAt(x - 2, centerY + altura, z).setType(Material.GLOWSTONE);
            world.getBlockAt(x, centerY + altura, z + 2).setType(Material.GLOWSTONE);
            world.getBlockAt(x, centerY + altura, z - 2).setType(Material.GLOWSTONE);
            world.getBlockAt(x + 2, centerY + altura + 1, z + 2).setType(Material.RESPAWN_ANCHOR);
            world.getBlockAt(x - 2, centerY + altura + 1, z + 2).setType(Material.RESPAWN_ANCHOR);
            world.getBlockAt(x + 2, centerY + altura + 1, z - 2).setType(Material.RESPAWN_ANCHOR);
            world.getBlockAt(x - 2, centerY + altura + 1, z - 2).setType(Material.RESPAWN_ANCHOR);
        }
    }
    
    /**
     * Construye 4 torres esquineras MASIVAS con cristales (35 bloques altura)
     */
    private void construirTorresEsquineras(World world, int centerX, int centerY, int centerZ) {
        int[][] esquinas = {{28, 28}, {-28, 28}, {28, -28}, {-28, -28}};
        
        for (int[] esquina : esquinas) {
            int x = centerX + esquina[0];
            int z = centerZ + esquina[1];
            int altura = 35; // AUMENTADO desde 20
            
            // Base MASIVA de la torre (11x11)
            for (int xOff = -5; xOff <= 5; xOff++) {
                for (int zOff = -5; zOff <= 5; zOff++) {
                    world.getBlockAt(x + xOff, centerY - 2, z + zOff).setType(Material.BLACKSTONE);
                    world.getBlockAt(x + xOff, centerY - 1, z + zOff).setType(Material.PURPUR_BLOCK);
                    
                    // Decoración en bordes
                    if (Math.abs(xOff) == 5 || Math.abs(zOff) == 5) {
                        world.getBlockAt(x + xOff, centerY, z + zOff).setType(Material.POLISHED_BLACKSTONE_BRICKS);
                    }
                }
            }
            
            // Cuerpo de la torre (cónico - más grande abajo, más pequeño arriba)
            for (int y = 0; y < altura; y++) {
                int size = 4 - (y / 10); // Reduce tamaño cada 10 bloques
                if (size < 1) size = 1;
                
                // Esquinas de la torre
                world.getBlockAt(x - size, centerY + y, z - size).setType(Material.PURPUR_PILLAR);
                world.getBlockAt(x + size, centerY + y, z - size).setType(Material.PURPUR_PILLAR);
                world.getBlockAt(x - size, centerY + y, z + size).setType(Material.PURPUR_PILLAR);
                world.getBlockAt(x + size, centerY + y, z + size).setType(Material.PURPUR_PILLAR);
                
                // Paredes entre esquinas
                for (int off = -size + 1; off < size; off++) {
                    world.getBlockAt(x + off, centerY + y, z - size).setType(Material.PURPUR_BLOCK);
                    world.getBlockAt(x + off, centerY + y, z + size).setType(Material.PURPUR_BLOCK);
                    world.getBlockAt(x - size, centerY + y, z + off).setType(Material.PURPUR_BLOCK);
                    world.getBlockAt(x + size, centerY + y, z + off).setType(Material.PURPUR_BLOCK);
                }
                
                // Centro hueco para cristal (últimos 15 bloques)
                if (y >= altura - 15) {
                    world.getBlockAt(x, centerY + y, z).setType(Material.PURPLE_STAINED_GLASS);
                    
                    // Decoración interna del cristal
                    if (y % 3 == 0) {
                        world.getBlockAt(x + 1, centerY + y, z).setType(Material.AMETHYST_BLOCK);
                        world.getBlockAt(x - 1, centerY + y, z).setType(Material.AMETHYST_BLOCK);
                        world.getBlockAt(x, centerY + y, z + 1).setType(Material.AMETHYST_BLOCK);
                        world.getBlockAt(x, centerY + y, z - 1).setType(Material.AMETHYST_BLOCK);
                    }
                }
                
                // Ventanas/huecos decorativos cada 7 bloques
                if (y % 7 == 0 && y > 5 && y < altura - 10) {
                    world.getBlockAt(x, centerY + y, z - size).setType(Material.SEA_LANTERN);
                    world.getBlockAt(x, centerY + y, z + size).setType(Material.SEA_LANTERN);
                    world.getBlockAt(x - size, centerY + y, z).setType(Material.SEA_LANTERN);
                    world.getBlockAt(x + size, centerY + y, z).setType(Material.SEA_LANTERN);
                }
            }
            
            // Cristal gigante MASIVO en la cima (12 bloques)
            for (int y = 0; y < 12; y++) {
                Material cristal;
                if (y < 3) {
                    cristal = Material.AMETHYST_BLOCK;
                } else if (y < 6) {
                    cristal = Material.BUDDING_AMETHYST;
                } else if (y < 9) {
                    cristal = Material.PURPLE_STAINED_GLASS;
                } else {
                    cristal = Material.SEA_LANTERN; // Punta brillante
                }
                
                world.getBlockAt(x, centerY + altura + y, z).setType(cristal);
                
                // Cristales laterales decorativos
                if (y < 8 && y % 2 == 0) {
                    world.getBlockAt(x + 1, centerY + altura + y, z).setType(Material.LARGE_AMETHYST_BUD);
                    world.getBlockAt(x - 1, centerY + altura + y, z).setType(Material.LARGE_AMETHYST_BUD);
                    world.getBlockAt(x, centerY + altura + y, z + 1).setType(Material.LARGE_AMETHYST_BUD);
                    world.getBlockAt(x, centerY + altura + y, z - 1).setType(Material.LARGE_AMETHYST_BUD);
                }
            }
            
            // Punta ULTRA brillante
            world.getBlockAt(x, centerY + altura + 12, z).setType(Material.BEACON);
            world.getBlockAt(x, centerY + altura + 13, z).setType(Material.END_ROD);
        }
    }
    
    /**
     * Construye runas luminosas en 5 círculos concéntricos (EXPANDIDO)
     */
    private void construirRunasLuminosas(World world, int centerX, int centerY, int centerZ) {
        // 5 círculos de runas (AUMENTADO desde 3)
        int[] radios = {8, 13, 19, 26, 34};
        int[] separaciones = {12, 15, 18, 20, 25}; // Ángulo entre runas
        
        for (int i = 0; i < radios.length; i++) {
            int radio = radios[i];
            int separacion = separaciones[i];
            
            for (double angle = 0; angle < 360; angle += separacion) {
                double rad = Math.toRadians(angle);
                int x = centerX + (int)(Math.cos(rad) * radio);
                int z = centerZ + (int)(Math.sin(rad) * radio);
                
                // Runa EXPANDIDA (3x3 con cruz de glowstone/redstone)
                world.getBlockAt(x, centerY + 1, z).setType(Material.GLOWSTONE);
                world.getBlockAt(x + 1, centerY + 1, z).setType(Material.REDSTONE_BLOCK);
                world.getBlockAt(x - 1, centerY + 1, z).setType(Material.REDSTONE_BLOCK);
                world.getBlockAt(x, centerY + 1, z + 1).setType(Material.REDSTONE_BLOCK);
                world.getBlockAt(x, centerY + 1, z - 1).setType(Material.REDSTONE_BLOCK);
                
                // Esquinas de la runa (NUEVO)
                if (i >= 2) { // Solo en círculos grandes
                    world.getBlockAt(x + 1, centerY + 1, z + 1).setType(Material.GOLD_BLOCK);
                    world.getBlockAt(x - 1, centerY + 1, z + 1).setType(Material.GOLD_BLOCK);
                    world.getBlockAt(x + 1, centerY + 1, z - 1).setType(Material.GOLD_BLOCK);
                    world.getBlockAt(x - 1, centerY + 1, z - 1).setType(Material.GOLD_BLOCK);
                }
                
                // Pequeño pilar elevado en el centro de cada runa
                world.getBlockAt(x, centerY + 2, z).setType(Material.END_ROD);
                if (i >= 3) { // Pilares más altos en círculos grandes
                    world.getBlockAt(x, centerY + 3, z).setType(Material.SEA_LANTERN);
                }
            }
        }
    }
    
    /**
     * Genera fragmentos flotantes MASIVOS épicos alrededor de la arena (80-100 fragmentos)
     */
    private void generarFragmentosFlotantesEpicos(World world, int centerX, int centerY, int centerZ) {
        int cantidadFragmentos = 80 + random.nextInt(21); // 80-100 fragmentos (DUPLICADO)
        
        for (int i = 0; i < cantidadFragmentos; i++) {
            // Posición aleatoria alrededor (pero no muy cerca del centro)
            double angle = Math.random() * Math.PI * 2;
            double distancia = 35 + Math.random() * 35; // Entre 35-70 bloques (EXPANDIDO)
            int x = centerX + (int)(Math.cos(angle) * distancia);
            int z = centerZ + (int)(Math.sin(angle) * distancia);
            int y = centerY + 5 + random.nextInt(35); // Entre 5-40 bloques de altura (MÁS ALTO)
            
            // Tamaño del fragmento MAYOR (3-8 bloques)
            int tamano = 3 + random.nextInt(6);
            
            Material[] materiales = {
                Material.END_STONE,
                Material.END_STONE_BRICKS,
                Material.PURPUR_BLOCK,
                Material.OBSIDIAN,
                Material.CRYING_OBSIDIAN,
                Material.POLISHED_BLACKSTONE, // NUEVO
                Material.POLISHED_DEEPSLATE,  // NUEVO
                Material.NETHERITE_BLOCK      // NUEVO (raros)
            };
            Material mat = materiales[random.nextInt(materiales.length)];
            
            // Generar fragmento irregular MÁS DENSO
            for (int dx = -tamano; dx <= tamano; dx++) {
                for (int dy = -tamano; dy <= tamano; dy++) {
                    for (int dz = -tamano; dz <= tamano; dz++) {
                        double fragDist = Math.sqrt(dx * dx + dy * dy + dz * dz);
                        if (fragDist <= tamano && Math.random() < 0.85) { // Más denso (0.7 → 0.85)
                            world.getBlockAt(x + dx, y + dy, z + dz).setType(mat);
                        }
                    }
                }
            }
            
            // Luces en fragmentos (MÁS FRECUENTES)
            if (tamano >= 4 && Math.random() < 0.6) { // 40% → 60%
                world.getBlockAt(x, y + tamano + 1, z).setType(Material.GLOWSTONE);
            }
            
            // Cadenas colgantes en fragmentos grandes (NUEVO)
            if (tamano >= 5 && Math.random() < 0.4) {
                int chainLength = 3 + random.nextInt(5);
                for (int chain = 0; chain < chainLength; chain++) {
                    world.getBlockAt(x, y - tamano - chain - 1, z).setType(Material.CHAIN);
                }
                // Lámpara al final de la cadena
                world.getBlockAt(x, y - tamano - chainLength - 1, z).setType(Material.LANTERN);
            }
            
            // Cristales pequeños en algunos fragmentos (NUEVO)
            if (tamano >= 5 && Math.random() < 0.3) {
                world.getBlockAt(x, y + tamano + 1, z).setType(Material.MEDIUM_AMETHYST_BUD);
                world.getBlockAt(x + 1, y + tamano, z).setType(Material.SMALL_AMETHYST_BUD);
                world.getBlockAt(x - 1, y + tamano, z).setType(Material.SMALL_AMETHYST_BUD);
            }
        }
    }
    
    /**
     * Genera cristales gigantes decorativos
     */
    private void generarCristalesGigantesBatalla(World world, int centerX, int centerY, int centerZ) {
        int[][] posiciones = {
            {15, 15}, {-15, 15}, {15, -15}, {-15, -15},
            {22, 0}, {-22, 0}, {0, 22}, {0, -22}
        };
        
        for (int[] pos : posiciones) {
            int x = centerX + pos[0];
            int z = centerZ + pos[1];
            int altura = 8 + random.nextInt(7); // 8-15 bloques
            
            for (int y = 0; y < altura; y++) {
                Material mat;
                if (y < altura / 3) {
                    mat = Material.AMETHYST_BLOCK;
                } else if (y < altura * 2 / 3) {
                    mat = Material.BUDDING_AMETHYST;
                } else {
                    mat = Material.PURPLE_STAINED_GLASS;
                }
                
                world.getBlockAt(x, centerY + y, z).setType(mat);
                
                // Ramificaciones cada 3 bloques
                if (y % 3 == 0 && y > 0 && y < altura - 1) {
                    world.getBlockAt(x + 1, centerY + y, z).setType(Material.SMALL_AMETHYST_BUD);
                    world.getBlockAt(x - 1, centerY + y, z).setType(Material.MEDIUM_AMETHYST_BUD);
                    world.getBlockAt(x, centerY + y, z + 1).setType(Material.LARGE_AMETHYST_BUD);
                    world.getBlockAt(x, centerY + y, z - 1).setType(Material.AMETHYST_CLUSTER);
                }
            }
            
            // Punta luminosa
            world.getBlockAt(x, centerY + altura, z).setType(Material.SEA_LANTERN);
        }
    }
    
    /**
     * Construye altar central elevado con portal decorativo End
     */
    /**
     * ═══════════════════════════════════════════════════════════════════
     * CONSTRUIR ALTAR CENTRAL ÉPICO LEGENDARIO
     * ═══════════════════════════════════════════════════════════════════
     * Altar masivo en el centro de la arena con:
     * - Plataforma elevada de 15x15 bloques (8 niveles escalonados)
     * - 8 pilares monumentales alrededor (altura 12 bloques)
     * - Portal decorativo dimensional en el centro (no funcional)
     * - Obelisco central flotante (altura 20 bloques)
     * - Runas luminosas en el suelo formando estrella
     * - Fuentes de partículas End (decorativo)
     * - Cristales de amatista en los pilares
     * - Iluminación épica con beacons y sea lanterns
     */
    private void construirAltarCentral(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena End] Construyendo altar central épico...");
        
        int radioBase = 7; // Plataforma de 15x15
        
        // ═══════════════════════════════════════════════════════════════
        // PLATAFORMA ESCALONADA (8 niveles hacia arriba)
        // ═══════════════════════════════════════════════════════════════
        for (int nivel = 0; nivel < 8; nivel++) {
            int radioNivel = radioBase - nivel;
            
            for (int x = -radioNivel; x <= radioNivel; x++) {
                for (int z = -radioNivel; z <= radioNivel; z++) {
                    double dist = Math.sqrt(x * x + z * z);
                    if (dist > radioNivel) continue;
                    
                    Material mat;
                    if (nivel == 0) {
                        mat = Material.POLISHED_BLACKSTONE_BRICKS;
                    } else if (nivel < 4) {
                        mat = Material.PURPUR_BLOCK;
                    } else {
                        mat = Material.CRYING_OBSIDIAN;
                    }
                    
                    world.getBlockAt(centerX + x, centerY + nivel, centerZ + z).setType(mat);
                }
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // RUNAS LUMINOSAS EN EL SUELO (patrón de estrella de 8 puntas)
        // ═══════════════════════════════════════════════════════════════
        for (int i = 0; i < 8; i++) {
            double angle = (i * Math.PI / 4);
            
            // Líneas desde el centro hacia afuera
            for (int r = 2; r <= 6; r++) {
                int runaX = centerX + (int)(Math.cos(angle) * r);
                int runaZ = centerZ + (int)(Math.sin(angle) * r);
                
                world.getBlockAt(runaX, centerY, runaZ).setType(Material.GLOWSTONE);
            }
        }
        
        // Círculo de glowstone en radio 5
        for (int i = 0; i < 24; i++) {
            double angle = (i * 2 * Math.PI / 24);
            int circX = centerX + (int)(Math.cos(angle) * 5);
            int circZ = centerZ + (int)(Math.sin(angle) * 5);
            
            world.getBlockAt(circX, centerY, circZ).setType(Material.SEA_LANTERN);
        }
        
        // ═══════════════════════════════════════════════════════════════
        // 8 PILARES MONUMENTALES alrededor del altar
        // ═══════════════════════════════════════════════════════════════
        for (int i = 0; i < 8; i++) {
            double angle = (i * Math.PI / 4);
            int pilarX = centerX + (int)(Math.cos(angle) * 6);
            int pilarZ = centerZ + (int)(Math.sin(angle) * 6);
            
            // Base del pilar (3x3)
            for (int xOff = -1; xOff <= 1; xOff++) {
                for (int zOff = -1; zOff <= 1; zOff++) {
                    world.getBlockAt(pilarX + xOff, centerY + 7, pilarZ + zOff).setType(Material.NETHERITE_BLOCK);
                }
            }
            
            // Cuerpo del pilar (altura 12 bloques)
            for (int y = 8; y < 20; y++) {
                Material mat = (y % 3 == 0) ? Material.PURPUR_PILLAR : Material.POLISHED_BLACKSTONE_BRICKS;
                world.getBlockAt(pilarX, centerY + y, pilarZ).setType(mat);
                
                // Decoración con crying obsidian cada 4 bloques
                if (y % 4 == 0) {
                    world.getBlockAt(pilarX + 1, centerY + y, pilarZ).setType(Material.CRYING_OBSIDIAN);
                    world.getBlockAt(pilarX - 1, centerY + y, pilarZ).setType(Material.CRYING_OBSIDIAN);
                    world.getBlockAt(pilarX, centerY + y, pilarZ + 1).setType(Material.CRYING_OBSIDIAN);
                    world.getBlockAt(pilarX, centerY + y, pilarZ - 1).setType(Material.CRYING_OBSIDIAN);
                }
            }
            
            // Cima del pilar con cristal de amatista
            world.getBlockAt(pilarX, centerY + 20, pilarZ).setType(Material.AMETHYST_BLOCK);
            world.getBlockAt(pilarX, centerY + 21, pilarZ).setType(Material.AMETHYST_CLUSTER);
            
            // Sea lantern flotante sobre el pilar
            world.getBlockAt(pilarX, centerY + 22, pilarZ).setType(Material.SEA_LANTERN);
        }
        
        // ═══════════════════════════════════════════════════════════════
        // PORTAL DECORATIVO DIMENSIONAL (marco de 5x5)
        // ═══════════════════════════════════════════════════════════════
        // Marco inferior
        for (int x = -2; x <= 2; x++) {
            world.getBlockAt(centerX + x, centerY + 8, centerZ).setType(Material.OBSIDIAN);
        }
        
        // Pilares laterales
        for (int y = 9; y <= 12; y++) {
            world.getBlockAt(centerX - 2, centerY + y, centerZ).setType(Material.OBSIDIAN);
            world.getBlockAt(centerX + 2, centerY + y, centerZ).setType(Material.OBSIDIAN);
        }
        
        // Marco superior
        for (int x = -2; x <= 2; x++) {
            world.getBlockAt(centerX + x, centerY + 13, centerZ).setType(Material.OBSIDIAN);
        }
        
        // Interior del portal (purple stained glass)
        for (int x = -1; x <= 1; x++) {
            for (int y = 9; y <= 12; y++) {
                world.getBlockAt(centerX + x, centerY + y, centerZ).setType(Material.PURPLE_STAINED_GLASS);
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // OBELISCO CENTRAL FLOTANTE (sobre el portal)
        // ═══════════════════════════════════════════════════════════════
        for (int y = 14; y < 34; y++) {
            // El obelisco se adelgaza hacia arriba
            Material mat;
            if (y < 20) {
                mat = Material.CRYING_OBSIDIAN;
                // Base más ancha
                world.getBlockAt(centerX, centerY + y, centerZ).setType(mat);
                if (y % 2 == 0) {
                    world.getBlockAt(centerX + 1, centerY + y, centerZ).setType(Material.OBSIDIAN);
                    world.getBlockAt(centerX - 1, centerY + y, centerZ).setType(Material.OBSIDIAN);
                    world.getBlockAt(centerX, centerY + y, centerZ + 1).setType(Material.OBSIDIAN);
                    world.getBlockAt(centerX, centerY + y, centerZ - 1).setType(Material.OBSIDIAN);
                }
            } else if (y < 28) {
                mat = Material.PURPUR_PILLAR;
                world.getBlockAt(centerX, centerY + y, centerZ).setType(mat);
            } else {
                // Punta del obelisco
                mat = Material.END_ROD;
                world.getBlockAt(centerX, centerY + y, centerZ).setType(mat);
            }
            
            // Anillos luminosos cada 6 bloques
            if (y % 6 == 0 && y < 28) {
                for (int i = 0; i < 4; i++) {
                    double ringAngle = (i * Math.PI / 2);
                    int ringX = centerX + (int)(Math.cos(ringAngle) * 2);
                    int ringZ = centerZ + (int)(Math.sin(ringAngle) * 2);
                    world.getBlockAt(ringX, centerY + y, ringZ).setType(Material.GLOWSTONE);
                }
            }
        }
        
        // ═══════════════════════════════════════════════════════════════
        // BEACON EN LA CIMA DEL OBELISCO
        // ═══════════════════════════════════════════════════════════════
        world.getBlockAt(centerX, centerY + 34, centerZ).setType(Material.BEACON);
        
        // Corona de sea lanterns alrededor del beacon
        for (int i = 0; i < 4; i++) {
            double crownAngle = (i * Math.PI / 2);
            int crownX = centerX + (int)(Math.cos(crownAngle));
            int crownZ = centerZ + (int)(Math.sin(crownAngle));
            world.getBlockAt(crownX, centerY + 34, crownZ).setType(Material.SEA_LANTERN);
        }
        
        // ═══════════════════════════════════════════════════════════════
        // ESCALERAS DE ACCESO (4 escaleras hacia el altar)
        // ═══════════════════════════════════════════════════════════════
        for (int i = 0; i < 4; i++) {
            double stairAngle = (i * Math.PI / 2);
            
            for (int step = 0; step < 8; step++) {
                int stairX = centerX + (int)(Math.cos(stairAngle) * (7 + step));
                int stairZ = centerZ + (int)(Math.sin(stairAngle) * (7 + step));
                
                world.getBlockAt(stairX, centerY + step, stairZ).setType(Material.POLISHED_BLACKSTONE_STAIRS);
                
                // Barandillas con cadenas
                if (step % 2 == 0) {
                    int railX = stairX + (int)(Math.cos(stairAngle + Math.PI/2));
                    int railZ = stairZ + (int)(Math.sin(stairAngle + Math.PI/2));
                    world.getBlockAt(railX, centerY + step + 1, railZ).setType(Material.CHAIN);
                }
            }
        }
        
        plugin.getLogger().info("[Arena End] ✓ Altar central épico construido:");
        plugin.getLogger().info("[Arena End]   - Plataforma escalonada 15x15 (8 niveles)");
        plugin.getLogger().info("[Arena End]   - 8 pilares monumentales con cristales");
        plugin.getLogger().info("[Arena End]   - Portal dimensional decorativo");
        plugin.getLogger().info("[Arena End]   - Obelisco flotante (altura 20)");
        plugin.getLogger().info("[Arena End]   - Beacon en la cima");
    }
    
    /**
     * Construye puentes de obsidiana llorona conectando los 12 pilares
     */
    private void construirPuentesPilares(World world, int centerX, int centerY, int centerZ) {
        int distanciaPilares = 32;
        int alturaPuente = centerY + 35; // A la altura media de los pilares
        
        // Conectar los 12 pilares en círculo
        for (int i = 0; i < 12; i++) {
            double angle1 = (i * Math.PI * 2) / 12;
            double angle2 = ((i + 1) * Math.PI * 2) / 12;
            
            int x1 = centerX + (int)(Math.cos(angle1) * distanciaPilares);
            int z1 = centerZ + (int)(Math.sin(angle1) * distanciaPilares);
            int x2 = centerX + (int)(Math.cos(angle2) * distanciaPilares);
            int z2 = centerZ + (int)(Math.sin(angle2) * distanciaPilares);
            
            // Dibujar línea entre pilares (interpolación)
            int steps = 30;
            for (int step = 0; step <= steps; step++) {
                double t = (double) step / steps;
                int x = (int)(x1 + t * (x2 - x1));
                int z = (int)(z1 + t * (z2 - z1));
                
                // Puente de 3 bloques de ancho
                world.getBlockAt(x, alturaPuente, z).setType(Material.CRYING_OBSIDIAN);
                world.getBlockAt(x + 1, alturaPuente, z).setType(Material.OBSIDIAN);
                world.getBlockAt(x - 1, alturaPuente, z).setType(Material.OBSIDIAN);
                
                // Barandillas
                if (step % 3 == 0) {
                    world.getBlockAt(x + 2, alturaPuente + 1, z).setType(Material.IRON_BARS);
                    world.getBlockAt(x - 2, alturaPuente + 1, z).setType(Material.IRON_BARS);
                }
            }
        }
    }
    
    /**
     * Construye murallas con almenas alrededor del perímetro
     */
    private void construirMurallasPerimetro(World world, int centerX, int centerY, int centerZ) {
        int radioMuralla = 38;
        int alturaMuralla = 5;
        
        for (double angle = 0; angle < 360; angle += 8) {
            double rad = Math.toRadians(angle);
            int x = centerX + (int)(Math.cos(rad) * radioMuralla);
            int z = centerZ + (int)(Math.sin(rad) * radioMuralla);
            
            // Muralla base
            for (int y = 0; y < alturaMuralla; y++) {
                world.getBlockAt(x, centerY + y, z).setType(Material.POLISHED_BLACKSTONE_BRICKS);
            }
            
            // Almenas (patrón dentado)
            if (angle % 16 == 0) {
                world.getBlockAt(x, centerY + alturaMuralla, z).setType(Material.POLISHED_BLACKSTONE_BRICK_WALL);
                world.getBlockAt(x, centerY + alturaMuralla + 1, z).setType(Material.POLISHED_BLACKSTONE_BRICK_WALL);
            }
        }
    }
    
    /**
     * Construye fosas de lava/agua entre anillos concéntricos
     */
    private void construirFosasElementales(World world, int centerX, int centerY, int centerZ) {
        // 2 fosas: una de lava (radio 16-18), otra de agua (radio 28-30)
        int[][] fosas = {{16, 18, 1}, {28, 30, 0}}; // {radioMin, radioMax, tipo: 0=agua, 1=lava}
        
        for (int[] fosa : fosas) {
            int radioMin = fosa[0];
            int radioMax = fosa[1];
            boolean esLava = (fosa[2] == 1);
            
            for (int x = -radioMax; x <= radioMax; x++) {
                for (int z = -radioMax; z <= radioMax; z++) {
                    double dist = Math.sqrt(x * x + z * z);
                    if (dist >= radioMin && dist <= radioMax) {
                        // Cavar 3 bloques de profundidad
                        world.getBlockAt(centerX + x, centerY - 1, centerZ + z).setType(Material.AIR);
                        world.getBlockAt(centerX + x, centerY - 2, centerZ + z).setType(Material.AIR);
                        world.getBlockAt(centerX + x, centerY - 3, centerZ + z).setType(Material.AIR);
                        
                        // Llenar con lava o agua
                        Material fluido = esLava ? Material.LAVA : Material.WATER;
                        world.getBlockAt(centerX + x, centerY - 3, centerZ + z).setType(fluido);
                    }
                }
            }
        }
    }
    
    /**
     * Construye escaleras monumentales hacia el altar central (4 direcciones)
     */
    private void construirEscalerasMonumentales(World world, int centerX, int centerY, int centerZ) {
        // 4 escaleras en direcciones cardinales
        for (int i = 0; i < 4; i++) {
            double angle = (i * Math.PI / 2);
            
            for (int step = 0; step < 15; step++) {
                int x = centerX + (int)(Math.cos(angle) * (7 + step));
                int z = centerZ + (int)(Math.sin(angle) * (7 + step));
                int y = centerY + (step / 2); // Sube cada 2 bloques
                
                // Escalón (3 bloques de ancho)
                for (int w = -1; w <= 1; w++) {
                    int xOff = (int)(-Math.sin(angle) * w);
                    int zOff = (int)(Math.cos(angle) * w);
                    
                    world.getBlockAt(x + xOff, y, z + zOff).setType(Material.PURPUR_STAIRS);
                    
                    // Alfombra púrpura encima
                    if (step % 2 == 0) {
                        world.getBlockAt(x + xOff, y + 1, z + zOff).setType(Material.PURPLE_CARPET);
                    }
                }
            }
        }
    }
    
    /**
     * Construye estatuas de guardianes End en las esquinas
     */
    private void construirEstatuasGuardianes(World world, int centerX, int centerY, int centerZ) {
        int[][] posiciones = {{35, 35}, {-35, 35}, {35, -35}, {-35, -35}};
        
        for (int[] pos : posiciones) {
            int x = centerX + pos[0];
            int z = centerZ + pos[1];
            int altura = 12;
            
            // Base de la estatua (5x5)
            for (int xOff = -2; xOff <= 2; xOff++) {
                for (int zOff = -2; zOff <= 2; zOff++) {
                    world.getBlockAt(x + xOff, centerY - 1, z + zOff).setType(Material.POLISHED_BLACKSTONE);
                    world.getBlockAt(x + xOff, centerY, z + zOff).setType(Material.CHISELED_POLISHED_BLACKSTONE);
                }
            }
            
            // Cuerpo de la estatua (forma de enderman estilizado)
            // Piernas (2 pilares)
            for (int y = 1; y <= 4; y++) {
                world.getBlockAt(x - 1, centerY + y, z).setType(Material.PURPUR_PILLAR);
                world.getBlockAt(x + 1, centerY + y, z).setType(Material.PURPUR_PILLAR);
            }
            
            // Torso (3x2)
            for (int y = 5; y <= 8; y++) {
                world.getBlockAt(x - 1, centerY + y, z).setType(Material.PURPUR_BLOCK);
                world.getBlockAt(x, centerY + y, z).setType(Material.PURPUR_BLOCK);
                world.getBlockAt(x + 1, centerY + y, z).setType(Material.PURPUR_BLOCK);
                
                // Brazos
                if (y == 6 || y == 7) {
                    world.getBlockAt(x - 2, centerY + y, z).setType(Material.PURPUR_PILLAR);
                    world.getBlockAt(x + 2, centerY + y, z).setType(Material.PURPUR_PILLAR);
                }
            }
            
            // Cabeza (3x3)
            for (int xOff = -1; xOff <= 1; xOff++) {
                for (int zOff = -1; zOff <= 1; zOff++) {
                    world.getBlockAt(x + xOff, centerY + 9, z + zOff).setType(Material.PURPUR_BLOCK);
                }
            }
            
            // Ojos brillantes
            world.getBlockAt(x - 1, centerY + 10, z).setType(Material.GLOWSTONE);
            world.getBlockAt(x + 1, centerY + 10, z).setType(Material.GLOWSTONE);
            
            // Corona de cristal
            world.getBlockAt(x, centerY + 11, z).setType(Material.AMETHYST_BLOCK);
            world.getBlockAt(x, centerY + 12, z).setType(Material.END_ROD);
        }
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * GENERAR ESFERAS FLOTANTES DE END STONE (decoración aérea épica)
     * ═══════════════════════════════════════════════════════════════════
     * Crea 25 esferas flotantes de diferentes tamaños distribuidas
     * alrededor de la arena a diferentes alturas
     */
    private void generarEsferasFlotantes(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena End] Generando esferas flotantes de end stone...");
        
        for (int i = 0; i < 25; i++) {
            // Posición aleatoria alrededor del centro
            double angle = Math.random() * 2 * Math.PI;
            int distancia = 45 + (int)(Math.random() * 40); // 45-85 bloques del centro
            int esferaX = centerX + (int)(Math.cos(angle) * distancia);
            int esferaZ = centerZ + (int)(Math.sin(angle) * distancia);
            int esferaY = centerY + 80 + (int)(Math.random() * 25); // Altura 144-169
            
            // Tamaño aleatorio de la esfera (radio 2-5)
            int radio = 2 + (int)(Math.random() * 4);
            
            // Construir esfera
            for (int x = -radio; x <= radio; x++) {
                for (int y = -radio; y <= radio; y++) {
                    for (int z = -radio; z <= radio; z++) {
                        double dist = Math.sqrt(x * x + y * y + z * z);
                        if (dist <= radio) {
                            Material mat;
                            if (dist < radio - 1) {
                                mat = Material.END_STONE;
                            } else {
                                mat = (Math.random() < 0.3) ? Material.END_STONE_BRICKS : Material.END_STONE;
                            }
                            world.getBlockAt(esferaX + x, esferaY + y, esferaZ + z).setType(mat);
                        }
                    }
                }
            }
            
            // Núcleo luminoso en el centro
            if (radio >= 4) {
                world.getBlockAt(esferaX, esferaY, esferaZ).setType(Material.GLOWSTONE);
            }
        }
        
        plugin.getLogger().info("[Arena End] ✓ 25 esferas flotantes generadas");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * CONSTRUIR COLUMNAS DE OBSIDIANA GIGANTES (8 columnas verticales)
     * ═══════════════════════════════════════════════════════════════════
     * Columnas masivas que van desde el suelo hasta el cielo
     * - Altura: 50 bloques
     * - Grosor: 3x3
     * - Decoración con crying obsidian
     */
    private void construirColumnasObsidianaGigantes(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena End] Construyendo 8 columnas de obsidiana gigantes...");
        
        for (int i = 0; i < 8; i++) {
            double angle = (i * Math.PI * 2) / 8;
            int distancia = 90; // 90 bloques del centro
            int columnaX = centerX + (int)(Math.cos(angle) * distancia);
            int columnaZ = centerZ + (int)(Math.sin(angle) * distancia);
            
            // Construir columna desde Y=60 hasta Y=110 (50 bloques altura)
            for (int y = centerY - 4; y < centerY + 46; y++) {
                // Centro de la columna (1x1)
                world.getBlockAt(columnaX, y, columnaZ).setType(Material.OBSIDIAN);
                
                // Expandir a 3x3 cada 10 bloques
                if (y % 10 == 0) {
                    for (int xOff = -1; xOff <= 1; xOff++) {
                        for (int zOff = -1; zOff <= 1; zOff++) {
                            if (xOff == 0 && zOff == 0) continue; // Ya se puso el centro
                            world.getBlockAt(columnaX + xOff, y, columnaZ + zOff).setType(Material.CRYING_OBSIDIAN);
                        }
                    }
                }
                
                // Decoración con glowstone cada 15 bloques
                if (y % 15 == 0) {
                    world.getBlockAt(columnaX + 1, y, columnaZ).setType(Material.GLOWSTONE);
                    world.getBlockAt(columnaX - 1, y, columnaZ).setType(Material.GLOWSTONE);
                    world.getBlockAt(columnaX, y, columnaZ + 1).setType(Material.GLOWSTONE);
                    world.getBlockAt(columnaX, y, columnaZ - 1).setType(Material.GLOWSTONE);
                }
            }
            
            // Cima de la columna con beacon
            world.getBlockAt(columnaX, centerY + 46, columnaZ).setType(Material.BEACON);
        }
        
        plugin.getLogger().info("[Arena End] ✓ 8 columnas gigantes construidas (altura 50)");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * GENERAR PLATAFORMAS FLOTANTES SECUNDARIAS (16 plataformas pequeñas)
     * ═══════════════════════════════════════════════════════════════════
     * Plataformas pequeñas de 7x7 distribuidas en dos anillos
     * - Anillo interior: 8 plataformas a radio 55
     * - Anillo exterior: 8 plataformas a radio 95
     * - Altura variable
     */
    private void generarPlataformasFlotantesSecundarias(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena End] Generando 16 plataformas flotantes secundarias...");
        
        int[][] configuraciones = {
            {55, 85},  // Anillo interior: radio 55, altura Y=85
            {95, 78}   // Anillo exterior: radio 95, altura Y=78
        };
        
        for (int[] config : configuraciones) {
            int radio = config[0];
            int altura = config[1];
            
            for (int i = 0; i < 8; i++) {
                double angle = (i * Math.PI * 2) / 8;
                int plataformaX = centerX + (int)(Math.cos(angle) * radio);
                int plataformaZ = centerZ + (int)(Math.sin(angle) * radio);
                
                // Plataforma de 7x7
                for (int x = -3; x <= 3; x++) {
                    for (int z = -3; z <= 3; z++) {
                        double dist = Math.sqrt(x * x + z * z);
                        if (dist > 3.5) continue;
                        
                        Material mat;
                        if (dist < 1) {
                            mat = Material.POLISHED_BLACKSTONE;
                        } else if (dist < 2) {
                            mat = Material.END_STONE_BRICKS;
                        } else {
                            mat = Material.END_STONE;
                        }
                        
                        world.getBlockAt(plataformaX + x, altura, plataformaZ + z).setType(mat);
                    }
                }
                
                // Pilar decorativo en el centro (5 bloques altura)
                for (int y = 1; y <= 5; y++) {
                    world.getBlockAt(plataformaX, altura + y, plataformaZ).setType(Material.PURPUR_PILLAR);
                }
                world.getBlockAt(plataformaX, altura + 6, plataformaZ).setType(Material.SEA_LANTERN);
            }
        }
        
        plugin.getLogger().info("[Arena End] ✓ 16 plataformas secundarias generadas");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * CONSTRUIR FUENTES DE LAVA DECORATIVAS (4 fuentes en esquinas)
     * ═══════════════════════════════════════════════════════════════════
     * Fuentes decorativas de lava en las 4 esquinas diagonales
     * - Base de netherite y blackstone
     * - Lava cayendo desde altura elevada
     * - Iluminación con glowstone
     */
    private void construirFuentesLavaDecorativas(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena End] Construyendo 4 fuentes de lava decorativas...");
        
        int[][] posiciones = {{65, 65}, {-65, 65}, {65, -65}, {-65, -65}};
        
        for (int[] pos : posiciones) {
            int fuenteX = centerX + pos[0];
            int fuenteZ = centerZ + pos[1];
            
            // Base de la fuente (9x9)
            for (int x = -4; x <= 4; x++) {
                for (int z = -4; z <= 4; z++) {
                    double dist = Math.sqrt(x * x + z * z);
                    if (dist > 4.5) continue;
                    
                    world.getBlockAt(fuenteX + x, centerY - 1, fuenteZ + z).setType(Material.NETHERITE_BLOCK);
                    world.getBlockAt(fuenteX + x, centerY, fuenteZ + z).setType(Material.POLISHED_BLACKSTONE);
                }
            }
            
            // Pilares en las esquinas (altura 10)
            int[][] esquinasPilares = {{3, 3}, {-3, 3}, {3, -3}, {-3, -3}};
            for (int[] esquina : esquinasPilares) {
                for (int y = 1; y <= 10; y++) {
                    world.getBlockAt(fuenteX + esquina[0], centerY + y, fuenteZ + esquina[1]).setType(Material.POLISHED_BLACKSTONE_BRICKS);
                }
            }
            
            // Estructura de la fuente (3x3 elevada)
            for (int x = -1; x <= 1; x++) {
                for (int z = -1; z <= 1; z++) {
                    // Suelo elevado
                    for (int y = 1; y <= 8; y++) {
                        if (Math.abs(x) == 1 || Math.abs(z) == 1) {
                            world.getBlockAt(fuenteX + x, centerY + y, fuenteZ + z).setType(Material.NETHER_BRICKS);
                        }
                    }
                }
            }
            
            // Lava en el centro (altura 9)
            world.getBlockAt(fuenteX, centerY + 9, fuenteZ).setType(Material.LAVA);
            
            // Decoración con glowstone alrededor
            for (int i = 0; i < 4; i++) {
                double angle = (i * Math.PI / 2);
                int glowX = fuenteX + (int)(Math.cos(angle) * 2);
                int glowZ = fuenteZ + (int)(Math.sin(angle) * 2);
                world.getBlockAt(glowX, centerY + 8, glowZ).setType(Material.GLOWSTONE);
            }
        }
        
        plugin.getLogger().info("[Arena End] ✓ 4 fuentes de lava decorativas construidas");
    }
    
    /**
     * Inicia efectos visuales permanentes en la arena
     */
    private void iniciarEfectosArenaBatalla(Location centro) {
        new BukkitRunnable() {
            int ticks = 0;
            
            @Override
            public void run() {
                if (faseEvento != EventPhase.COMBATE && faseEvento != EventPhase.VICTORIA) {
                    cancel();
                    return;
                }
                
                ticks++;
                World world = centro.getWorld();
                if (world == null) return;
                
                // Partículas en pilares (cada 2 segundos)
                if (ticks % 40 == 0) {
                    for (int i = 0; i < 8; i++) {
                        double angle = (i * Math.PI * 2) / 8;
                        int x = (int)(centro.getX() + Math.cos(angle) * 25);
                        int z = (int)(centro.getZ() + Math.sin(angle) * 25);
                        
                        Location pilarLoc = new Location(world, x, centro.getY() + 30, z);
                        world.spawnParticle(Particle.END_ROD, pilarLoc, 10, 0.3, 2, 0.3, 0.05);
                    }
                }
                
                // Espiral central (constante)
                double radioEspiral = 3 + Math.sin(ticks * 0.1) * 1;
                for (int i = 0; i < 10; i++) {
                    double angulo = (ticks + i * 36) * 0.1;
                    double x = centro.getX() + radioEspiral * Math.cos(angulo);
                    double z = centro.getZ() + radioEspiral * Math.sin(angulo);
                    double y = centro.getY() + ((ticks + i * 14) % 100) * 0.15;
                    
                    Location spiralLoc = new Location(world, x, y, z);
                    world.spawnParticle(Particle.PORTAL, spiralLoc, 2, 0, 0, 0, 0);
                }
                
                // Runas pulsantes (cada 5 segundos)
                if (ticks % 100 == 0) {
                    int[] radios = {10, 17, 24};
                    for (int radio : radios) {
                        for (double angle = 0; angle < 360; angle += 15) {
                            double rad = Math.toRadians(angle);
                            int x = (int)(centro.getX() + Math.cos(rad) * radio);
                            int z = (int)(centro.getZ() + Math.sin(rad) * radio);
                            
                            Location runaLoc = new Location(world, x, centro.getY() + 1, z);
                            world.spawnParticle(Particle.ENCHANT, runaLoc, 15, 0.3, 0.5, 0.3, 0);
                        }
                    }
                }
            }
        }.runTaskTimer(plugin, 0L, 1L);
    }
    
    /**
     * Spawnea el dragón con efectos sutiles
     */
    private void spawnearDragon() {
        World endWorld = Bukkit.getWorld(config.getString("evento.mundo_end", "world_the_end"));
        
        if (endWorld == null) {
            plugin.getLogger().severe("[Apertura End] ¡Mundo End no encontrado!");
            Bukkit.broadcastMessage("§c§lERROR: No se pudo spawnear el dragón.");
            onStop();
            return;
        }
        
        // LIMPIEZA: Eliminar cualquier dragón existente antes de spawnear
        limpiarDragonesExistentes(endWorld);
        
        // Spawn EN EL AIRE sobre la arena (NO dentro del altar)
        // Posición: 40 bloques al norte, altura 100 (bien arriba)
        Location spawnLoc = new Location(endWorld, 0, 100, -40);
        
        // Calcular jugadores para escalar HP
        int jugadoresEnEnd = (int) Bukkit.getOnlinePlayers().stream()
            .filter(p -> p.getWorld().getEnvironment() == World.Environment.THE_END)
            .count();
        
        dragonMaxHP = calcularHPEscalado(jugadoresEnEnd);
        
        // ═══════════════════════════════════════════════════════════════
        // SECUENCIA CINEMÁTICA DE SPAWN (ÉPICA Y DRAMÁTICA)
        // ═══════════════════════════════════════════════════════════════
        
        // T+0s: Oscuridad total y ceguera
        endWorld.setTime(18000); // Medianoche
        for (Player p : Bukkit.getOnlinePlayers()) {
            if (p.getWorld().equals(endWorld)) {
                p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                    org.bukkit.potion.PotionEffectType.BLINDNESS, 120, 1, false, false));
                p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                    org.bukkit.potion.PotionEffectType.SLOWNESS, 120, 2, false, false));
                p.playSound(p.getLocation(), Sound.AMBIENT_CAVE, 2.0f, 0.3f);
            }
        }
        
        // T+1s: Primer diálogo del Observador
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §5Algo antiguo despierta...");
                Bukkit.broadcastMessage("§8[§5...§8] §5El vacío reclama lo que es suyo.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_AMBIENT, 1.0f, 0.5f);
                }
            }
        }.runTaskLater(plugin, 20L); // 1 segundo
        
        // T+3s: Temblor y partículas iniciales
        new BukkitRunnable() {
            @Override
            public void run() {
                // Efecto de terremoto (sonidos)
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.playSound(p.getLocation(), Sound.ENTITY_WITHER_SPAWN, 0.8f, 0.4f);
                        p.playSound(p.getLocation(), Sound.ENTITY_LIGHTNING_BOLT_THUNDER, 0.5f, 0.6f);
                    }
                }
                
                // Partículas oscuras en el spawn point
                spawnLoc.getWorld().spawnParticle(Particle.SMOKE, spawnLoc, 100, 5, 5, 5, 0.1);
                spawnLoc.getWorld().spawnParticle(Particle.LARGE_SMOKE, spawnLoc, 50, 3, 3, 3, 0.05);
            }
        }.runTaskLater(plugin, 60L); // 3 segundos
        
        // T+5s: Explosión de partículas y rayos
        new BukkitRunnable() {
            @Override
            public void run() {
                // Explosión masiva de partículas
                spawnLoc.getWorld().spawnParticle(Particle.PORTAL, spawnLoc, 500, 10, 10, 10, 1.0);
                spawnLoc.getWorld().spawnParticle(Particle.DRAGON_BREATH, spawnLoc, 300, 8, 8, 8, 0.5);
                spawnLoc.getWorld().spawnParticle(Particle.END_ROD, spawnLoc, 100, 5, 5, 5, 0.3);
                spawnLoc.getWorld().spawnParticle(Particle.SOUL_FIRE_FLAME, spawnLoc, 200, 7, 7, 7, 0.2);
                
                // Rayos visuales (sin daño)
                for (int i = 0; i < 3; i++) {
                    Location randomLoc = spawnLoc.clone().add(
                        (Math.random() - 0.5) * 20,
                        0,
                        (Math.random() - 0.5) * 20
                    );
                    endWorld.strikeLightningEffect(randomLoc);
                }
                
                // Sonidos épicos
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.playSound(p.getLocation(), Sound.ENTITY_LIGHTNING_BOLT_IMPACT, 1.5f, 0.7f);
                        p.playSound(p.getLocation(), Sound.ENTITY_GENERIC_EXPLODE, 1.0f, 0.5f);
                    }
                }
            }
        }.runTaskLater(plugin, 100L); // 5 segundos
        
        // T+7s: SPAWN DEL DRAGÓN + Título épico
        new BukkitRunnable() {
            @Override
            public void run() {
                // ═══════════════════════════════════════════════════════════════
                // MEJORA ÉPICA: SPAWN DEL DRAGÓN VANILLA (ENGAÑO INICIAL)
                // ═══════════════════════════════════════════════════════════════
                // Los jugadores creen que este es el verdadero dragón del evento
                // Pero cuando lo maten... la verdad será revelada
                // ═══════════════════════════════════════════════════════════════
                
                // Mensaje y título antes del spawn (genérico)
                String titulo = "§8§l⚠";
                String subtitulo = "§c§lEL DRAGÓN DEL END DESPIERTA";
                
                for (Player player : Bukkit.getOnlinePlayers()) {
                    player.sendTitle(titulo, subtitulo, 10, 80, 20);
                    player.playSound(player.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 2.0f, 0.6f);
                    player.playSound(player.getLocation(), Sound.AMBIENT_CAVE, 1.0f, 0.4f);
                }
                
                // SPAWN DEL DRAGÓN VANILLA (sin MythicMobs - siempre vanilla primero)
                tipoDragonActual = DragonType.VANILLA;
                spawnearDragonVanillaPrimerFase(spawnLoc, jugadoresEnEnd);
                
                // Actualizar BossBar (genérico, no revelar que es especial)
                bossBar.setTitle("§c§lEnder Dragon");
                bossBar.setColor(BarColor.PINK);
                bossBar.setProgress(1.0);
                
                plugin.getLogger().info("[Apertura End] Dragón VANILLA spawneado - HP: " + dragonMaxHP + " (Jugadores: " + jugadoresEnEnd + ")");
                plugin.getLogger().info("[Apertura End] ⚡ Sistema de doble dragón activo - Este es solo el engaño...");
            }
        }.runTaskLater(plugin, 140L); // 7 segundos
        
        // T+9s: Diálogo final del Observador
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §dAntes era un final.");
                Bukkit.broadcastMessage("§8[§5...§8] §dAhora… es solo otro paso.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§5§l¡COMBATE INICIADO!");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    p.playSound(p.getLocation(), Sound.ENTITY_PLAYER_LEVELUP, 1.0f, 0.8f);
                }
            }
        }.runTaskLater(plugin, 180L); // 9 segundos
        
        // T+10s: Iniciar tracking del dragón
        new BukkitRunnable() {
            @Override
            public void run() {
                iniciarTrackingDragon();
            }
        }.runTaskLater(plugin, 200L); // 10 segundos
        
        // T+12s: Mensaje sobre cristales del End
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§d§l⚠ MECÁNICA IMPORTANTE ⚠");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§7Los §5§lCRISTALES DEL END §7protegen al dragón");
                Bukkit.broadcastMessage("§7Debes §c§lDESTRUIRLOS §7para poder dañarlo");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().getEnvironment() == World.Environment.THE_END) {
                        p.sendTitle("§5§l⚠", "§d§lDestruye los Cristales del End", 10, 60, 20);
                        p.playSound(p.getLocation(), Sound.BLOCK_BEACON_ACTIVATE, 1.0f, 1.5f);
                    }
                }
            }
        }.runTaskLater(plugin, 240L); // 12 segundos
    }
    
    /**
     * Spawnea dragón usando MythicMobs (con Model Engine integrado)
     * 
     * IMPORTANTE - CONFIGURACIÓN DE MYTHICMOBS:
     * Para evitar que el dragón se quede atrapado/inmóvil, asegúrate de que
     * el mob 'toro_enderdragon' en plugins/MythicMobs/Mobs/ tenga:
     * 
     * toro_enderdragon:
     *   Type: ENDER_DRAGON
     *   Display: '§8El Desolador del Vacío'
     *   Health: 500
     *   Damage: 10
     *   AIGoalSelectors:
     *   - clear
     *   - meleeattack
     *   - randomstroll
     *   Options:
     *     MovementSpeed: 0.25
     *     PreventOtherDrops: true
     *     AlwaysShowName: false
     *     Silent: false
     *     Despawn: false
     *   Skills:
     *   - skill{s=dragon_breath} @target ~onTimer:100
     *   - skill{s=dragon_fireball} @target ~onTimer:60
     * 
     * Si el dragón sigue atrapado, verifica que no haya conflictos con:
     * - Dragon.Phase (puede forzar fase de aterrizaje permanente)
     * - PreventMovement: false (debe permitir movimiento)
     * - Plugins que modifiquen AI del dragón
     */
    private void spawnearDragonModelEngine(Location loc, int jugadores) {
        try {
            // Usar reflexión para acceder a MythicMobs sin dependencia directa
            Class<?> mythicBukkitClass = Class.forName("io.lumine.mythic.bukkit.MythicBukkit");
            Object mythicBukkit = mythicBukkitClass.getMethod("inst").invoke(null);
            
            if (mythicBukkit == null) {
                plugin.getLogger().warning("[Apertura End] ⚠ MythicMobs no encontrado - usando vanilla");
                fallbackVanilla();
                return;
            }
            
            // Spawnear el mob "toro_enderdragon" de MythicMobs
            Object mobManager = mythicBukkitClass.getMethod("getMobManager").invoke(mythicBukkit);
            Object activeMob = mobManager.getClass().getMethod("spawnMob", String.class, Location.class)
                .invoke(mobManager, "toro_enderdragon", loc);
            
            if (activeMob == null) {
                plugin.getLogger().warning("[Apertura End] ⚠ No se pudo spawnear 'toro_enderdragon' - verifica la configuración de MythicMobs");
                fallbackVanilla();
                return;
            }
            
            // Obtener la entidad Bukkit del mob
            Object mobEntity = activeMob.getClass().getMethod("getEntity").invoke(activeMob);
            Entity entity = (Entity) mobEntity.getClass().getMethod("getBukkitEntity").invoke(mobEntity);
            
            if (entity instanceof LivingEntity) {
                LivingEntity livingEntity = (LivingEntity) entity;
                
                // GUARDAR REFERENCIA GENÉRICA (funciona con HUSK o cualquier tipo)
                dragonEntity = livingEntity;
                
                // Configurar HP escalado
                livingEntity.setMaxHealth(dragonMaxHP);
                livingEntity.setHealth(dragonMaxHP);
                
                // Si es un dragón, guardarlo en la variable
                if (entity instanceof EnderDragon) {
                    dragon = (EnderDragon) entity;
                    
                    // SOLUCIÓN ULTRA MEJORADA: Limpiar dragones vanilla agresivamente
                    // MythicMobs a veces genera un dragón vanilla adicional - eliminarlo completamente
                    // Ejecutar limpieza MÚLTIPLE para asegurar eliminación total
                    // Delays: 1, 5, 10, 20, 40, 80, 160 ticks (0.05s hasta 8s)
                    for (int delay : new int[]{1, 5, 10, 20, 40, 80, 160}) {
                        new BukkitRunnable() {
                            @Override
                            public void run() {
                                World endWorld = loc.getWorld();
                                if (endWorld != null && dragon != null && !dragon.isDead()) {
                                    int eliminados = 0;
                                    UUID dragonUUID = dragon.getUniqueId();
                                    
                                    // Buscar TODOS los dragones en el End
                                    for (Entity ent : endWorld.getEntities()) {
                                        if (ent instanceof EnderDragon) {
                                            EnderDragon dragonCheck = (EnderDragon) ent;
                                            
                                            // Eliminar si NO es nuestro dragón de MythicMobs
                                            if (!ent.getUniqueId().equals(dragonUUID)) {
                                                plugin.getLogger().warning("[Apertura End] ⚠ Dragón vanilla detectado (UUID: " + ent.getUniqueId() + ") - ELIMINANDO");
                                                dragonCheck.remove();
                                                eliminados++;
                                            }
                                        }
                                    }
                                    
                                    if (eliminados > 0) {
                                        plugin.getLogger().info("[Apertura End] ✓ Eliminados " + eliminados + " dragón(es) vanilla duplicado(s)");
                                    }
                                }
                            }
                        }.runTaskLater(plugin, delay);
                    }
                    
                    // VERIFICACIÓN FINAL: Asegurar que solo hay UN dragón después de 10 segundos
                    new BukkitRunnable() {
                        @Override
                        public void run() {
                            World endWorld = loc.getWorld();
                            if (endWorld != null) {
                                int totalDragones = 0;
                                for (Entity ent : endWorld.getEntities()) {
                                    if (ent instanceof EnderDragon) {
                                        totalDragones++;
                                    }
                                }
                                
                                if (totalDragones == 1) {
                                    plugin.getLogger().info("[Apertura End] ✓✓✓ VERIFICACIÓN: Solo 1 dragón activo (CORRECTO)");
                                } else if (totalDragones > 1) {
                                    plugin.getLogger().severe("[Apertura End] ✖✖✖ ERROR: " + totalDragones + " dragones detectados - Limpieza fallida");
                                } else {
                                    plugin.getLogger().severe("[Apertura End] ✖✖✖ ERROR: Ningún dragón detectado");
                                }
                            }
                        }
                    }.runTaskLater(plugin, 200L); // 10 segundos
                }
                
                plugin.getLogger().info("[Apertura End] ✓ Dragón MythicMobs 'toro_enderdragon' spawneado exitosamente");
                plugin.getLogger().info("[Apertura End] ✓ HP configurado: " + dragonMaxHP);
                plugin.getLogger().info("[Apertura End] ✓ Habilidades, sonidos y modelo de MythicMobs activos");
                
                // Efectos visuales épicos (solo al spawnear)
                loc.getWorld().spawnParticle(Particle.PORTAL, loc, 200, 2.0, 2.0, 2.0, 0.5);
                loc.getWorld().spawnParticle(Particle.DRAGON_BREATH, loc, 100, 3.0, 3.0, 3.0, 0.1);
                loc.getWorld().spawnParticle(Particle.END_ROD, loc, 50, 1.0, 1.0, 1.0, 0.2);
                
                Bukkit.broadcastMessage("§8[§5...§8] §d§lEl Desolador del Vacío ha despertado.");
            } else {
                plugin.getLogger().warning("[Apertura End] ⚠ La entidad spawneada no es LivingEntity - usando vanilla");
                fallbackVanilla();
            }
            
        } catch (ClassNotFoundException e) {
            plugin.getLogger().info("[Apertura End] MythicMobs no instalado - usando modo vanilla");
            fallbackVanilla();
        } catch (Exception e) {
            plugin.getLogger().severe("[Apertura End] ✖ Error al spawnear con MythicMobs: " + e.getMessage());
            e.printStackTrace();
            fallbackVanilla();
        }
    }
    
    /**
     * Spawnea dragón vanilla mejorado (modo compatibilidad)
     */
    private void spawnearDragonVanilla(Location loc) {
        dragon = (EnderDragon) loc.getWorld().spawnEntity(loc, EntityType.ENDER_DRAGON);
        dragon.setCustomName("§8El Desolador del Vacío");
        dragon.setCustomNameVisible(false);
        dragon.setMaxHealth(dragonMaxHP);
        dragon.setHealth(dragonMaxHP);
        dragon.setInvisible(false); // Asegurar que es visible
        dragon.setSilent(false);
        dragon.setAI(true);
        
        // NOTA: Los EnderDragon no tienen atributos de attack_damage ni movement_speed
        // El daño y la velocidad se controlan a través de MythicMobs o las fases del dragón
        
        // Efectos visuales vanilla mejorados
        loc.getWorld().spawnParticle(Particle.PORTAL, loc, 100, 2.0, 2.0, 2.0, 0.3);
        loc.getWorld().spawnParticle(Particle.SMOKE, loc, 50, 1.0, 1.0, 1.0, 0.1);
        
        Bukkit.broadcastMessage("§8[§7...§8] §7Un dragón antiguo emerge de las sombras.");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * SISTEMA DE DOBLE DRAGÓN - FASE 1: VANILLA (ENGAÑO)
     * ═══════════════════════════════════════════════════════════════════
     * Spawnea el dragón vanilla "normal" que los jugadores creen que es
     * el jefe del evento. Este dragón es más débil y cuando muera,
     * revelará que NO era el verdadero enemigo...
     * ═══════════════════════════════════════════════════════════════════
     */
    private void spawnearDragonVanillaPrimerFase(Location loc, int jugadores) {
        // Limpiar cualquier dragón existente
        limpiarDragonesExistentes(loc.getWorld());
        
        // HP reducido para el dragón vanilla (30% del HP real)
        double hpVanilla = dragonMaxHP * 0.3; // Solo 30% del HP total
        
        dragonVanilla = (EnderDragon) loc.getWorld().spawnEntity(loc, EntityType.ENDER_DRAGON);
        dragon = dragonVanilla; // Asignar a dragon para compatibilidad con sistemas existentes
        
        // Forzar fase de vuelo libre para que no se quede atascado
        dragonVanilla.setPhase(EnderDragon.Phase.CIRCLING);
        
        dragonVanilla.setCustomName("§c§lEnder Dragon");
        dragonVanilla.setCustomNameVisible(false);
        dragonVanilla.setMaxHealth(hpVanilla);
        dragonVanilla.setHealth(hpVanilla);
        dragonVanilla.setInvisible(false);
        dragonVanilla.setSilent(false);
        dragonVanilla.setAI(true);
        
        // Efectos visuales genéricos (no épicos)
        loc.getWorld().spawnParticle(Particle.PORTAL, loc, 80, 2.0, 2.0, 2.0, 0.2);
        loc.getWorld().spawnParticle(Particle.SMOKE, loc, 40, 1.5, 1.5, 1.5, 0.1);
        loc.getWorld().spawnParticle(Particle.DRAGON_BREATH, loc, 50, 2.5, 2.5, 2.5, 0.1);
        
        // Mensaje genérico (sin revelar nada especial)
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§c§lEl Ender Dragon ha aparecido");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§7Derrótalo para completar el evento");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        
        // Sonidos normales
        for (Player p : Bukkit.getOnlinePlayers()) {
            if (p.getWorld().equals(loc.getWorld())) {
                p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_AMBIENT, 1.5f, 1.0f);
            }
        }
        
        plugin.getLogger().info("[Apertura End] ⚡ DRAGÓN VANILLA (ENGAÑO) spawneado - HP: " + hpVanilla + " (" + ((int)(hpVanilla/dragonMaxHP*100)) + "% del HP real)");
        plugin.getLogger().info("[Apertura End] ⚡ Los jugadores creen que este es el dragón final...");
    }
    
    /**
     * ═══════════════════════════════════════════════════════════════════
     * CINEMÁTICA ÉPICA: MUERTE DEL DRAGÓN VANILLA → SPAWN DRAGÓN MYTHIC
     * ═══════════════════════════════════════════════════════════════════
     * Cuando muere el dragón vanilla, se revela que NO era el verdadero.
     * El Observador explica la verdad: este dragón ha estado en mundos
     * anteriores, es parte de un ciclo eterno. Luego aparece el VERDADERO
     * dragón (MythicMobs) con efectos épicos masivos.
     * 
     * CONEXIÓN CON LA HISTORIA:
     * - Menciona los eventos Eco (Brasas, Sombras, Piedra)
     * - Habla de "mundos anteriores" y "ciclos repetidos"
     * - Revela que el dragón es parte de algo más grande
     * - El portal del overworld desaparece (ya no es necesario)
     * ═══════════════════════════════════════════════════════════════════
     */
    private void cinematicaTransicionDragonVanillaAMythic() {
        World endWorld = dragonVanilla != null ? dragonVanilla.getWorld() : 
                         Bukkit.getWorld(config.getString("evento.mundo_end", "world_the_end"));
        
        Location deathLoc = dragonVanilla != null ? dragonVanilla.getLocation().clone() : 
                           new Location(endWorld, 0, 80, 0);
        
        plugin.getLogger().info("[Apertura End] ⚡⚡⚡ CINEMÁTICA DE TRANSICIÓN INICIADA ⚡⚡⚡");
        plugin.getLogger().info("[Apertura End] ⚡ Dragón vanilla derrotado, revelando la verdad...");
        
        // Marcar que el vanilla murió
        dragonVanillaMuerto = true;
        
        // ═══════════════════════════════════════════════════════════════
        // T+0s: ELIMINAR PORTAL DEL END (el que se crea automáticamente)
        // ═══════════════════════════════════════════════════════════════
        // Cuando muere el dragón vanilla, Minecraft crea automáticamente
        // un portal de salida en el End. Necesitamos eliminarlo porque
        // este no era el verdadero dragón final.
        new BukkitRunnable() {
            @Override
            public void run() {
                eliminarPortalSalidaEnd(endWorld);
            }
        }.runTaskLater(plugin, 20L); // 1 segundo después para dar tiempo a que se genere
        
        // También eliminar el portal del Overworld (ya no es necesario)
        eliminarPortalOverworld();
        
        // ═══════════════════════════════════════════════════════════════
        // T+0s: SILENCIO INICIAL + PANTALLA OSCURA
        // ═══════════════════════════════════════════════════════════════
        for (Player p : Bukkit.getOnlinePlayers()) {
            if (p.getWorld().equals(endWorld)) {
                p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                    org.bukkit.potion.PotionEffectType.BLINDNESS, 200, 2, false, false));
                p.sendTitle("§0 ", "§0 ", 10, 100, 20);
                p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_DEATH, 1.5f, 0.8f);
            }
        }
        
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8...");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        
        // ═══════════════════════════════════════════════════════════════
        // T+3s: PRIMER DIÁLOGO - LA REVELACIÓN
        // ═══════════════════════════════════════════════════════════════
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §7¿Ese... era el dragón?");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.sendTitle("§8§l...", "§7¿Ese... era el dragón?", 10, 60, 20);
                        p.playSound(p.getLocation(), Sound.AMBIENT_CAVE, 1.5f, 0.3f);
                    }
                }
            }
        }.runTaskLater(plugin, 60L);
        
        // ═══════════════════════════════════════════════════════════════
        // T+6s: SEGUNDO DIÁLOGO - NEGACIÓN
        // ═══════════════════════════════════════════════════════════════
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §c§lNo.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §7Ese no era §c§lEL §7dragón.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.sendTitle("§c§lNO", "§7Ese no era el dragón verdadero", 10, 70, 20);
                        p.playSound(p.getLocation(), Sound.ENTITY_WITHER_AMBIENT, 1.0f, 0.5f);
                    }
                }
            }
        }.runTaskLater(plugin, 120L);
        
        // ═══════════════════════════════════════════════════════════════
        // T+9s: TERCER DIÁLOGO - CONEXIÓN CON EVENTOS ECO
        // ═══════════════════════════════════════════════════════════════
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §5Las brasas... las sombras... la piedra rota...");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §7Todo eran §c§lfragmentos§7.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §7Fragmentos de §5§lESTO§7.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.sendTitle("§5§l...", "§7Fragmentos de ESTO", 10, 60, 20);
                        p.playSound(p.getLocation(), Sound.BLOCK_PORTAL_AMBIENT, 1.5f, 0.4f);
                    }
                }
            }
        }.runTaskLater(plugin, 180L);
        
        // ═══════════════════════════════════════════════════════════════
        // T+13s: CUARTO DIÁLOGO - MUNDOS ANTERIORES + CURACIÓN/REPARACIÓN
        // ═══════════════════════════════════════════════════════════════
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §dEste dragón ha estado en §5§lmundos anteriores§d.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §dCiclos. Siglos. §c§lÉpocas enteras§d.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §7Y siempre... §c§lvuelve§7.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.sendTitle("§5§lMUNDOS ANTERIORES", "§7Y siempre... vuelve", 10, 80, 20);
                        p.playSound(p.getLocation(), Sound.ENTITY_ENDERMAN_SCREAM, 1.0f, 0.3f);
                    }
                }
                
                // ═══════════════════════════════════════════════════════════════
                // CURACIÓN Y REPARACIÓN COMPLETA (3 segundos después)
                // ═══════════════════════════════════════════════════════════════
                new BukkitRunnable() {
                    @Override
                    public void run() {
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§5...§8] §7No están §c§lpreparados§7.");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§5...§8] §a§lPero puedo ayudarles.");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        Bukkit.broadcastMessage("");
                        
                        // Curar y reparar a TODOS los jugadores en el End
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            if (p.getWorld().equals(endWorld)) {
                                // CURACIÓN COMPLETA
                                p.setHealth(p.getMaxHealth());
                                p.setFoodLevel(20);
                                p.setSaturation(20.0f);
                                p.setFireTicks(0);
                                
                                // Limpiar efectos negativos
                                for (org.bukkit.potion.PotionEffect effect : p.getActivePotionEffects()) {
                                    org.bukkit.potion.PotionEffectType type = effect.getType();
                                    if (type.equals(org.bukkit.potion.PotionEffectType.POISON) ||
                                        type.equals(org.bukkit.potion.PotionEffectType.WITHER) ||
                                        type.equals(org.bukkit.potion.PotionEffectType.SLOWNESS) ||
                                        type.equals(org.bukkit.potion.PotionEffectType.WEAKNESS) ||
                                        type.equals(org.bukkit.potion.PotionEffectType.MINING_FATIGUE) ||
                                        type.equals(org.bukkit.potion.PotionEffectType.NAUSEA)) {
                                        p.removePotionEffect(type);
                                    }
                                }
                                
                                // REPARAR TODO EL EQUIPO
                                // Armadura
                                if (p.getInventory().getHelmet() != null) {
                                    p.getInventory().getHelmet().setDurability((short) 0);
                                }
                                if (p.getInventory().getChestplate() != null) {
                                    p.getInventory().getChestplate().setDurability((short) 0);
                                }
                                if (p.getInventory().getLeggings() != null) {
                                    p.getInventory().getLeggings().setDurability((short) 0);
                                }
                                if (p.getInventory().getBoots() != null) {
                                    p.getInventory().getBoots().setDurability((short) 0);
                                }
                                
                                // Item en mano principal y secundaria
                                if (p.getInventory().getItemInMainHand() != null) {
                                    p.getInventory().getItemInMainHand().setDurability((short) 0);
                                }
                                if (p.getInventory().getItemInOffHand() != null) {
                                    p.getInventory().getItemInOffHand().setDurability((short) 0);
                                }
                                
                                // TODO el inventario
                                for (org.bukkit.inventory.ItemStack item : p.getInventory().getContents()) {
                                    if (item != null && item.getType() != Material.AIR) {
                                        item.setDurability((short) 0);
                                    }
                                }
                                
                                // EFECTOS VISUALES DE CURACIÓN ÉPICOS
                                p.spawnParticle(Particle.HEART, p.getLocation().add(0, 2, 0), 20, 0.5, 0.5, 0.5, 0.1);
                                p.spawnParticle(Particle.TOTEM_OF_UNDYING, p.getLocation().add(0, 1, 0), 50, 0.5, 1.0, 0.5, 0.2);
                                p.spawnParticle(Particle.ENCHANT, p.getLocation().add(0, 1, 0), 40, 0.5, 1.0, 0.5, 0.5);
                                p.spawnParticle(Particle.END_ROD, p.getLocation().add(0, 1, 0), 30, 0.5, 1.0, 0.5, 0.1);
                                p.spawnParticle(Particle.GLOW, p.getLocation(), 25, 0.5, 1.0, 0.5, 0.05);
                                
                                // SONIDOS DE CURACIÓN
                                p.playSound(p.getLocation(), Sound.ENTITY_PLAYER_LEVELUP, 1.5f, 1.2f);
                                p.playSound(p.getLocation(), Sound.BLOCK_ENCHANTMENT_TABLE_USE, 1.0f, 1.5f);
                                p.playSound(p.getLocation(), Sound.BLOCK_BEACON_POWER_SELECT, 1.2f, 1.8f);
                                p.playSound(p.getLocation(), Sound.ITEM_TOTEM_USE, 0.8f, 1.5f);
                                
                                // TÍTULO INDIVIDUAL
                                p.sendTitle("§a§l✓ RESTAURADO", "§7Salud, equipo y efectos", 10, 60, 20);
                                
                                // Mensaje personal
                                p.sendMessage("");
                                p.sendMessage("§a§l✓ Has sido completamente restaurado:");
                                p.sendMessage("§7  • Salud: §c❤ §a" + (int)p.getMaxHealth() + "/" + (int)p.getMaxHealth());
                                p.sendMessage("§7  • Hambre: §6🍖 §a20/20");
                                p.sendMessage("§7  • Armadura: §b⚔ §aReparada");
                                p.sendMessage("§7  • Herramientas: §e🔧 §aReparadas");
                                p.sendMessage("§7  • Efectos: §d✨ §aLimpiados");
                                p.sendMessage("");
                            }
                        }
                        
                        plugin.getLogger().info("[Apertura End] ⚡ Todos los jugadores curados y reparados completamente");
                    }
                }.runTaskLater(plugin, 60L); // 3 segundos después (260+60=320 ticks)
            }
        }.runTaskLater(plugin, 260L);
        
