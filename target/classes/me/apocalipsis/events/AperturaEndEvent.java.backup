        // ═══════════════════════════════════════════════════════════════
        new BukkitRunnable() {
            @Override
            public void run() {
                // Explosiones de partículas masivas
                deathLoc.getWorld().spawnParticle(Particle.PORTAL, deathLoc, 2000, 20, 20, 20, 3.0);
                deathLoc.getWorld().spawnParticle(Particle.DRAGON_BREATH, deathLoc, 1500, 15, 15, 15, 1.0);
                deathLoc.getWorld().spawnParticle(Particle.END_ROD, deathLoc, 1000, 12, 12, 12, 0.8);
                deathLoc.getWorld().spawnParticle(Particle.REVERSE_PORTAL, deathLoc, 1200, 18, 18, 18, 2.0);
                deathLoc.getWorld().spawnParticle(Particle.SOUL_FIRE_FLAME, deathLoc, 800, 10, 10, 10, 0.5);
                
                // Rayos en círculo
                for (int i = 0; i < 12; i++) {
                    double angle = (i * Math.PI * 2) / 12;
                    double x = deathLoc.getX() + Math.cos(angle) * 20;
                    double z = deathLoc.getZ() + Math.sin(angle) * 20;
                    Location lightningLoc = new Location(endWorld, x, deathLoc.getY(), z);
                    endWorld.strikeLightningEffect(lightningLoc);
                }
                
                // Sonidos apocalípticos
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 2.5f, 0.3f);
                        p.playSound(p.getLocation(), Sound.ENTITY_WITHER_DEATH, 2.0f, 0.2f);
                        p.playSound(p.getLocation(), Sound.BLOCK_END_PORTAL_SPAWN, 2.5f, 0.5f);
                        p.playSound(p.getLocation(), Sound.ENTITY_LIGHTNING_BOLT_IMPACT, 2.0f, 0.4f);
                    }
                }
            }
        }.runTaskLater(plugin, 500L); // T+25s (500 ticks / 20 = 25 segundos)
        
