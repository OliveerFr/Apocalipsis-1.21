package me.apocalipsis.events.apertura;

import org.bukkit.*;
import org.bukkit.scheduler.BukkitRunnable;
import org.bukkit.scheduler.BukkitTask;

import me.apocalipsis.Apocalipsis;

/**
 * AperturaEndArenaBuilder
 * 
 * Constructor modular para la arena épica del evento Apertura del End.
 * 
 * CARACTERÍSTICAS:
 * - Construcción progresiva de múltiples estructuras
 * - Plataforma de spawn épica
 * - Puente monumental hacia arena central
 * - Altar central legendario
 * - Pilares de batalla espaciados
 * - Torres esquineras y runas luminosas
 * - Portal épico y estructuras decorativas
 */
public class AperturaEndArenaBuilder {
    
    // ═══════════════════════════════════════════════════════════════════
    // REFERENCIAS
    // ═══════════════════════════════════════════════════════════════════
    
    private final Apocalipsis plugin;
    private World endWorld;
    
    // Coordenadas de construcción
    private int spawnX = 100, spawnY = 48, spawnZ = 0;
    private int centerX = 0, centerY = 70, centerZ = 0;
    
    // ═══════════════════════════════════════════════════════════════════
    // CONSTRUCTOR
    // ═══════════════════════════════════════════════════════════════════
    
    public AperturaEndArenaBuilder(Apocalipsis plugin) {
        this.plugin = plugin;
        this.endWorld = Bukkit.getWorld("world_the_end");
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // MÉTODOS PÚBLICOS
    // ═══════════════════════════════════════════════════════════════════
    
    /**
     * Construye toda la arena del evento
     */
    public void construirArenaCompleta() {
        if (endWorld == null) {
            plugin.getLogger().severe("[Arena Builder] ¡Mundo End no encontrado!");
            return;
        }
        
        plugin.getLogger().info("[Arena Builder] Iniciando construcción de arena épica...");
        
        // Construcción en secuencia
        construirPlataformaSpawnEpica(endWorld, spawnX, spawnY, spawnZ);
        construirPuenteMonumental(endWorld, spawnX, spawnY, spawnZ, centerX, centerY, centerZ);
        construirPlataformaBatallaEpica(endWorld, centerX, centerY, centerZ);
        construirAltarCentral(endWorld, centerX, centerY, centerZ);
        construirPilaresBatallaEspaciados(endWorld, centerX, centerY, centerZ);
        construirRunasLuminosasSimples(endWorld, centerX, centerY, centerZ);
        
        plugin.getLogger().info("[Arena Builder] ✅ Arena épica construida exitosamente");
    }
    
    /**
     * Construye portal épico en ubicación específica
     */
    public void construirPortalEpico(Location portalLocation) {
        if (portalLocation == null) {
            return;
        }
        
        World world = portalLocation.getWorld();
        int x = portalLocation.getBlockX();
        int y = portalLocation.getBlockY();
        int z = portalLocation.getBlockZ();
        
        // Estructura del portal 5x5
        for (int dx = -2; dx <= 2; dx++) {
            for (int dz = -2; dz <= 2; dz++) {
                // Marco exterior de obsidiana
                if (Math.abs(dx) == 2 || Math.abs(dz) == 2) {
                    world.getBlockAt(x + dx, y, z + dz).setType(Material.OBSIDIAN);
                    world.getBlockAt(x + dx, y + 1, z + dz).setType(Material.OBSIDIAN);
                    world.getBlockAt(x + dx, y + 2, z + dz).setType(Material.OBSIDIAN);
                    world.getBlockAt(x + dx, y + 3, z + dz).setType(Material.OBSIDIAN);
                    world.getBlockAt(x + dx, y + 4, z + dz).setType(Material.OBSIDIAN);
                }
                // Interior del portal
                else if (Math.abs(dx) <= 1 && Math.abs(dz) <= 1) {
                    world.getBlockAt(x + dx, y + 1, z + dz).setType(Material.NETHER_PORTAL);
                    world.getBlockAt(x + dx, y + 2, z + dz).setType(Material.NETHER_PORTAL);
                    world.getBlockAt(x + dx, y + 3, z + dz).setType(Material.NETHER_PORTAL);
                }
            }
        }
        
        // Decoración con crying obsidian en esquinas
        world.getBlockAt(x - 2, y + 2, z - 2).setType(Material.CRYING_OBSIDIAN);
        world.getBlockAt(x + 2, y + 2, z - 2).setType(Material.CRYING_OBSIDIAN);
        world.getBlockAt(x - 2, y + 2, z + 2).setType(Material.CRYING_OBSIDIAN);
        world.getBlockAt(x + 2, y + 2, z + 2).setType(Material.CRYING_OBSIDIAN);
        
        plugin.getLogger().info("[Arena Builder] Portal épico construido en " + portalLocation);
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // MÉTODOS PRIVADOS - CONSTRUCCIÓN DE ESTRUCTURAS
    // ═══════════════════════════════════════════════════════════════════
    
    /**
     * CONSTRUIR PLATAFORMA DE SPAWN ÉPICA (donde aparecen los jugadores)
     * 
     * Plataforma circular de 25x25 con detalles ornamentales
     * Materiales: End Stone Bricks, Purpur, Obsidiana
     * Ubicación: Coordenadas específicas del spawn (100, 48, 0)
     * 
     * DISEÑO:
     * - Centro: Círculo de End Stone Bricks (radio 12)
     * - Anillos: Purpur y obsidiana alternados
     * - Esquinas: Torres pequeñas con luces
     * - Bordes: Barandillas decorativas
     */
    private void construirPlataformaSpawnEpica(World world, int spawnX, int spawnY, int spawnZ) {
        plugin.getLogger().info("[Arena Builder] Construyendo plataforma de spawn épica...");
        
        // PASO 1: Plataforma base circular (radio 12)
        for (int x = spawnX - 12; x <= spawnX + 12; x++) {
            for (int z = spawnZ - 12; z <= spawnZ + 12; z++) {
                double distancia = Math.sqrt(Math.pow(x - spawnX, 2) + Math.pow(z - spawnZ, 2));
                
                if (distancia <= 12.0) {
                    // Limpiar área arriba
                    for (int y = spawnY + 1; y <= spawnY + 10; y++) {
                        world.getBlockAt(x, y, z).setType(Material.AIR);
                    }
                    
                    // Base sólida
                    world.getBlockAt(x, spawnY, z).setType(Material.END_STONE_BRICKS);
                    world.getBlockAt(x, spawnY - 1, z).setType(Material.END_STONE);
                    
                    // Patrones decorativos según la distancia
                    if (distancia <= 3.0) {
                        // Centro: Purpur con diseño
                        if ((x + z) % 2 == 0) {
                            world.getBlockAt(x, spawnY, z).setType(Material.PURPUR_BLOCK);
                        }
                    } else if (distancia >= 10.0 && distancia <= 12.0) {
                        // Borde exterior: Obsidiana
                        world.getBlockAt(x, spawnY, z).setType(Material.OBSIDIAN);
                    }
                }
            }
        }
        
        // PASO 2: Torres esquineras (4 torres en esquinas principales)
        int[] esquinasX = {spawnX - 10, spawnX + 10, spawnX - 10, spawnX + 10};
        int[] esquinasZ = {spawnZ - 10, spawnZ - 10, spawnZ + 10, spawnZ + 10};
        
        for (int i = 0; i < 4; i++) {
            int torreX = esquinasX[i];
            int torreZ = esquinasZ[i];
            
            // Torre 3x3 altura 6
            for (int dx = -1; dx <= 1; dx++) {
                for (int dz = -1; dz <= 1; dz++) {
                    // Columnas en esquinas
                    if (Math.abs(dx) == 1 && Math.abs(dz) == 1) {
                        for (int dy = 1; dy <= 6; dy++) {
                            world.getBlockAt(torreX + dx, spawnY + dy, torreZ + dz).setType(Material.PURPUR_PILLAR);
                        }
                    }
                    // Centro de torre
                    else if (dx == 0 && dz == 0) {
                        world.getBlockAt(torreX, spawnY + 1, torreZ).setType(Material.END_ROD);
                        world.getBlockAt(torreX, spawnY + 6, torreZ).setType(Material.SEA_LANTERN);
                    }
                }
            }
        }
        
        // PASO 3: Runas circulares decorativas
        for (double angle = 0; angle < 360; angle += 45) {
            double rad = Math.toRadians(angle);
            int runaX = (int)(spawnX + Math.cos(rad) * 8);
            int runaZ = (int)(spawnZ + Math.sin(rad) * 8);
            
            world.getBlockAt(runaX, spawnY + 1, runaZ).setType(Material.END_ROD);
            
            // Círculo de purpur alrededor de cada runa
            for (int dx = -1; dx <= 1; dx++) {
                for (int dz = -1; dz <= 1; dz++) {
                    if (dx == 0 && dz == 0) continue;
                    world.getBlockAt(runaX + dx, spawnY, runaZ + dz).setType(Material.PURPUR_BLOCK);
                }
            }
        }
        
        // PASO 4: Escaleras de acceso (4 direcciones)
        int[] direccionesX = {0, 0, 1, -1};
        int[] direccionesZ = {1, -1, 0, 0};
        
        for (int i = 0; i < 4; i++) {
            int dirX = direccionesX[i];
            int dirZ = direccionesZ[i];
            
            // Escaleras hacia afuera de la plataforma (5 bloques)
            for (int paso = 1; paso <= 5; paso++) {
                int escaleraX = spawnX + (dirX * (12 + paso));
                int escaleraZ = spawnZ + (dirZ * (12 + paso));
                int escaleraY = spawnY - paso;
                
                world.getBlockAt(escaleraX, escaleraY, escaleraZ).setType(Material.PURPUR_STAIRS);
                world.getBlockAt(escaleraX, escaleraY - 1, escaleraZ).setType(Material.END_STONE_BRICKS);
            }
        }
        
        // PASO 5: Detalle central épico
        world.getBlockAt(spawnX, spawnY + 1, spawnZ).setType(Material.END_PORTAL_FRAME);
        world.getBlockAt(spawnX, spawnY + 2, spawnZ).setType(Material.BEACON);
        
        plugin.getLogger().info("[Arena Builder] ✅ Plataforma de spawn épica completada");
    }
    
    /**
     * CONSTRUIR PUENTE MONUMENTAL desde spawn hacia la plataforma central
     * 
     * Puente de 15 bloques de ancho que conecta spawn (100,48,0) con centro (0,70,0)
     * Incluye torres, arcos decorativos y iluminación
     */
    private void construirPuenteMonumental(World world, int startX, int startY, int startZ, 
                                         int endX, int endY, int endZ) {
        plugin.getLogger().info("[Arena Builder] Construyendo puente monumental...");
        
        // Calcular distancia y dirección
        double distanciaTotal = Math.sqrt(Math.pow(endX - startX, 2) + Math.pow(endZ - startZ, 2));
        double deltaX = (endX - startX) / distanciaTotal;
        double deltaZ = (endZ - startZ) / distanciaTotal;
        double deltaY = (endY - startY) / distanciaTotal;
        
        // CONSTRUIR PUENTE BLOQUE POR BLOQUE
        for (int i = 0; i <= distanciaTotal; i++) {
            int currentX = (int)(startX + deltaX * i);
            int currentY = (int)(startY + deltaY * i);
            int currentZ = (int)(startZ + deltaZ * i);
            
            // Superficie del puente (7 bloques de ancho)
            for (int ancho = -3; ancho <= 3; ancho++) {
                // Calcular posición perpendicular
                int perpX = (int)(currentX + ancho * deltaZ);
                int perpZ = (int)(currentZ - ancho * deltaX);
                
                // Superficie principal
                world.getBlockAt(perpX, currentY, perpZ).setType(Material.END_STONE_BRICKS);
                
                // Barandillas en los bordes
                if (Math.abs(ancho) == 3) {
                    world.getBlockAt(perpX, currentY + 1, perpZ).setType(Material.END_STONE_BRICK_WALL);
                }
                
                // Centro del puente - diseño especial
                if (ancho == 0) {
                    if (i % 10 == 0) { // Cada 10 bloques
                        world.getBlockAt(perpX, currentY + 1, perpZ).setType(Material.END_ROD);
                    }
                }
                
                // Laterales decorativos
                if (Math.abs(ancho) == 1) {
                    if (i % 5 == 0) {
                        world.getBlockAt(perpX, currentY, perpZ).setType(Material.PURPUR_BLOCK);
                    }
                }
            }
            
            // Torres intermedias cada 25 bloques
            if (i % 25 == 0 && i > 0 && i < distanciaTotal) {
                construirTorreIntermediadPuente(world, currentX, currentY, currentZ);
            }
        }
        
        plugin.getLogger().info("[Arena Builder] ✅ Puente monumental completado");
    }
    
    private void construirTorreIntermediadPuente(World world, int x, int y, int z) {
        // Torre 5x5 altura 8
        for (int dx = -2; dx <= 2; dx++) {
            for (int dz = -2; dz <= 2; dz++) {
                // Columnas esquineras
                if (Math.abs(dx) == 2 && Math.abs(dz) == 2) {
                    for (int dy = 1; dy <= 8; dy++) {
                        world.getBlockAt(x + dx, y + dy, z + dz).setType(Material.PURPUR_PILLAR);
                    }
                }
                // Base de la torre
                if (Math.abs(dx) <= 2 && Math.abs(dz) <= 2) {
                    world.getBlockAt(x + dx, y, z + dz).setType(Material.OBSIDIAN);
                }
            }
        }
        // Luz en la cima
        world.getBlockAt(x, y + 8, z).setType(Material.SEA_LANTERN);
    }
    
    /**
     * CONSTRUIR PLATAFORMA DE BATALLA ÉPICA
     * 
     * Plataforma circular masiva de radio 30 con múltiples niveles
     * Material principal: End Stone Bricks con detalles de Purpur y Obsidiana
     */
    private void construirPlataformaBatallaEpica(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena Builder] Construyendo plataforma de batalla épica...");
        
        int radio = 30;
        
        // NIVEL BASE (Y=centerY)
        for (int x = centerX - radio; x <= centerX + radio; x++) {
            for (int z = centerZ - radio; z <= centerZ + radio; z++) {
                double distancia = Math.sqrt(Math.pow(x - centerX, 2) + Math.pow(z - centerZ, 2));
                
                if (distancia <= radio) {
                    // Limpiar área hacia arriba
                    for (int y = centerY + 1; y <= centerY + 20; y++) {
                        world.getBlockAt(x, y, z).setType(Material.AIR);
                    }
                    
                    // Base sólida
                    world.getBlockAt(x, centerY, z).setType(Material.END_STONE_BRICKS);
                    world.getBlockAt(x, centerY - 1, z).setType(Material.END_STONE);
                    world.getBlockAt(x, centerY - 2, z).setType(Material.END_STONE);
                    
                    // Patrones concéntricos
                    if (distancia <= 5) {
                        // Centro - área del altar (se construye por separado)
                        world.getBlockAt(x, centerY, z).setType(Material.OBSIDIAN);
                    }
                    else if (distancia >= 15 && distancia <= 17) {
                        // Anillo intermedio - Purpur
                        world.getBlockAt(x, centerY, z).setType(Material.PURPUR_BLOCK);
                    }
                    else if (distancia >= 28 && distancia <= 30) {
                        // Borde exterior - Obsidiana
                        world.getBlockAt(x, centerY, z).setType(Material.OBSIDIAN);
                        
                        // Muros perimetrales
                        if (distancia >= 29.5) {
                            world.getBlockAt(x, centerY + 1, z).setType(Material.END_STONE_BRICK_WALL);
                            if (Math.random() < 0.3) {
                                world.getBlockAt(x, centerY + 2, z).setType(Material.END_STONE_BRICK_WALL);
                            }
                        }
                    }
                }
            }
        }
        
        // ESTRUCTURAS ADICIONALES
        construirPilaresBatalla(world, centerX, centerY, centerZ);
        construirTorresEsquineras(world, centerX, centerY, centerZ);
        construirRunasLuminosas(world, centerX, centerY, centerZ);
        
        plugin.getLogger().info("[Arena Builder] ✅ Plataforma de batalla épica completada");
    }
    
    private void construirPilaresBatalla(World world, int centerX, int centerY, int centerZ) {
        // 8 pilares alrededor del centro
        for (int i = 0; i < 8; i++) {
            double angle = i * 45; // 360°/8 = 45°
            double rad = Math.toRadians(angle);
            int pilarX = (int)(centerX + Math.cos(rad) * 20);
            int pilarZ = (int)(centerZ + Math.sin(rad) * 20);
            
            // Pilar principal (altura 12)
            for (int y = centerY + 1; y <= centerY + 12; y++) {
                world.getBlockAt(pilarX, y, pilarZ).setType(Material.PURPUR_PILLAR);
            }
            
            // Base del pilar (3x3)
            for (int dx = -1; dx <= 1; dx++) {
                for (int dz = -1; dz <= 1; dz++) {
                    world.getBlockAt(pilarX + dx, centerY, pilarZ + dz).setType(Material.OBSIDIAN);
                    if (Math.abs(dx) == 1 || Math.abs(dz) == 1) {
                        world.getBlockAt(pilarX + dx, centerY + 1, pilarZ + dz).setType(Material.END_STONE_BRICK_STAIRS);
                    }
                }
            }
            
            // Cima del pilar con luz
            world.getBlockAt(pilarX, centerY + 12, pilarZ).setType(Material.SEA_LANTERN);
            
            // Decoración en forma de cruz en la cima
            world.getBlockAt(pilarX + 1, centerY + 11, pilarZ).setType(Material.PURPUR_BLOCK);
            world.getBlockAt(pilarX - 1, centerY + 11, pilarZ).setType(Material.PURPUR_BLOCK);
            world.getBlockAt(pilarX, centerY + 11, pilarZ + 1).setType(Material.PURPUR_BLOCK);
            world.getBlockAt(pilarX, centerY + 11, pilarZ - 1).setType(Material.PURPUR_BLOCK);
        }
    }
    
    private void construirTorresEsquineras(World world, int centerX, int centerY, int centerZ) {
        // 4 torres en las esquinas principales
        int[] esquinasX = {centerX - 25, centerX + 25, centerX - 25, centerX + 25};
        int[] esquinasZ = {centerZ - 25, centerZ - 25, centerZ + 25, centerZ + 25};
        
        for (int i = 0; i < 4; i++) {
            int torreX = esquinasX[i];
            int torreZ = esquinasZ[i];
            
            // Torre 7x7 altura 15
            for (int dx = -3; dx <= 3; dx++) {
                for (int dz = -3; dz <= 3; dz++) {
                    // Estructura principal
                    if (Math.abs(dx) == 3 || Math.abs(dz) == 3) {
                        // Paredes exteriores
                        for (int dy = 1; dy <= 15; dy++) {
                            world.getBlockAt(torreX + dx, centerY + dy, torreZ + dz).setType(Material.END_STONE_BRICKS);
                        }
                    }
                    else if (Math.abs(dx) <= 1 && Math.abs(dz) <= 1) {
                        // Centro hueco (para futuras características)
                        for (int dy = 1; dy <= 14; dy++) {
                            world.getBlockAt(torreX + dx, centerY + dy, torreZ + dz).setType(Material.AIR);
                        }
                    }
                    
                    // Base sólida
                    world.getBlockAt(torreX + dx, centerY, torreZ + dz).setType(Material.OBSIDIAN);
                    world.getBlockAt(torreX + dx, centerY - 1, torreZ + dz).setType(Material.END_STONE);
                }
            }
            
            // Columnas esquineras decorativas
            for (int dx = -3; dx <= 3; dx += 6) {
                for (int dz = -3; dz <= 3; dz += 6) {
                    for (int dy = 1; dy <= 15; dy++) {
                        world.getBlockAt(torreX + dx, centerY + dy, torreZ + dz).setType(Material.PURPUR_PILLAR);
                    }
                }
            }
            
            // Cima de la torre con beacon
            world.getBlockAt(torreX, centerY + 15, torreZ).setType(Material.BEACON);
            
            // Plataforma en la cima
            for (int dx = -1; dx <= 1; dx++) {
                for (int dz = -1; dz <= 1; dz++) {
                    world.getBlockAt(torreX + dx, centerY + 14, torreZ + dz).setType(Material.PURPUR_BLOCK);
                }
            }
        }
    }
    
    private void construirRunasLuminosas(World world, int centerX, int centerY, int centerZ) {
        // 12 runas distribuidas en 3 anillos concéntricos
        int[] radios = {10, 17, 24};
        int[] cantidadPorAnillo = {4, 6, 8};
        
        for (int anillo = 0; anillo < 3; anillo++) {
            int radio = radios[anillo];
            int cantidad = cantidadPorAnillo[anillo];
            double anguloIncremento = 360.0 / cantidad;
            
            for (int i = 0; i < cantidad; i++) {
                double angle = i * anguloIncremento;
                double rad = Math.toRadians(angle);
                int runaX = (int)(centerX + Math.cos(rad) * radio);
                int runaZ = (int)(centerZ + Math.sin(rad) * radio);
                
                // Runa principal
                world.getBlockAt(runaX, centerY + 1, runaZ).setType(Material.END_ROD);
                
                // Base de la runa (3x3 cross pattern)
                world.getBlockAt(runaX, centerY, runaZ).setType(Material.PURPUR_BLOCK);
                world.getBlockAt(runaX + 1, centerY, runaZ).setType(Material.PURPUR_BLOCK);
                world.getBlockAt(runaX - 1, centerY, runaZ).setType(Material.PURPUR_BLOCK);
                world.getBlockAt(runaX, centerY, runaZ + 1).setType(Material.PURPUR_BLOCK);
                world.getBlockAt(runaX, centerY, runaZ - 1).setType(Material.PURPUR_BLOCK);
                
                // Runa secundaria más alta (solo en anillo exterior)
                if (anillo == 2) {
                    world.getBlockAt(runaX, centerY + 3, runaZ).setType(Material.SEA_LANTERN);
                    world.getBlockAt(runaX, centerY + 2, runaZ).setType(Material.END_STONE_BRICK_WALL);
                }
            }
        }
    }
    
    /**
     * CONSTRUIR ALTAR CENTRAL ÉPICO LEGENDARIO
     * 
     * Estructura circular de 11x11 en el centro exacto de la arena
     * Múltiples niveles con escaleras, pilares y un beacon central
     */
    private void construirAltarCentral(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena Builder] Construyendo altar central épico...");
        
        // NIVEL 1: Base circular (radio 5)
        for (int x = centerX - 5; x <= centerX + 5; x++) {
            for (int z = centerZ - 5; z <= centerZ + 5; z++) {
                double distancia = Math.sqrt(Math.pow(x - centerX, 2) + Math.pow(z - centerZ, 2));
                
                if (distancia <= 5.0) {
                    // Limpiar hacia arriba
                    for (int y = centerY + 1; y <= centerY + 10; y++) {
                        world.getBlockAt(x, y, z).setType(Material.AIR);
                    }
                    
                    // Base del altar
                    world.getBlockAt(x, centerY, z).setType(Material.OBSIDIAN);
                    
                    // Diseño concéntrico
                    if (distancia <= 1.5) {
                        // Centro - nivel superior
                        world.getBlockAt(x, centerY + 2, z).setType(Material.OBSIDIAN);
                    }
                    else if (distancia <= 3.0) {
                        // Anillo intermedio - nivel medio
                        world.getBlockAt(x, centerY + 1, z).setType(Material.PURPUR_BLOCK);
                    }
                }
            }
        }
        
        // NIVEL 2: Pilares esquineros (altura 8)
        int[] pillarPositions = {-4, 0, 4};
        for (int i = 0; i < pillarPositions.length; i++) {
            for (int j = 0; j < pillarPositions.length; j++) {
                int pillarX = centerX + pillarPositions[i];
                int pillarZ = centerZ + pillarPositions[j];
                
                // Evitar el centro exacto
                if (i == 1 && j == 1) continue;
                
                // Solo pilares en esquinas y puntos cardinales
                if ((i != 1 && j != 1) || (i == 1 || j == 1)) {
                    for (int y = centerY + 1; y <= centerY + 8; y++) {
                        world.getBlockAt(pillarX, y, pillarZ).setType(Material.PURPUR_PILLAR);
                    }
                    
                    // Cima de pilar con luz
                    world.getBlockAt(pillarX, centerY + 8, pillarZ).setType(Material.SEA_LANTERN);
                }
            }
        }
        
        // NIVEL 3: Centro épico con beacon
        world.getBlockAt(centerX, centerY + 3, centerZ).setType(Material.BEACON);
        world.getBlockAt(centerX, centerY + 4, centerZ).setType(Material.END_PORTAL_FRAME);
        
        // Anillo de end portal frames alrededor del beacon
        for (double angle = 0; angle < 360; angle += 45) {
            double rad = Math.toRadians(angle);
            int frameX = (int)(centerX + Math.cos(rad) * 2);
            int frameZ = (int)(centerZ + Math.sin(rad) * 2);
            
            world.getBlockAt(frameX, centerY + 2, frameZ).setType(Material.END_PORTAL_FRAME);
        }
        
        // NIVEL 4: Escaleras de acceso (4 direcciones)
        int[] direcciones = {-1, 0, 1};
        for (int dir = 0; dir < 4; dir++) {
            int dirX = (dir == 1) ? 1 : (dir == 3) ? -1 : 0;
            int dirZ = (dir == 0) ? 1 : (dir == 2) ? -1 : 0;
            
            // Escaleras desde el exterior hacia el centro
            for (int paso = 6; paso <= 8; paso++) {
                world.getBlockAt(centerX + (dirX * paso), centerY + (9 - paso), centerZ + (dirZ * paso))
                    .setType(Material.PURPUR_STAIRS);
            }
        }
        
        plugin.getLogger().info("[Arena Builder] ✅ Altar central épico completado");
    }
    
    /**
     * Pilares de batalla espaciados alrededor de la arena
     */
    private void construirPilaresBatallaEspaciados(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena Builder] Construyendo pilares de batalla espaciados...");
        
        // 16 pilares distribuidos en 2 anillos
        int[] radios = {12, 22};
        int[] cantidadPorAnillo = {8, 8};
        
        for (int anillo = 0; anillo < 2; anillo++) {
            int radio = radios[anillo];
            int cantidad = cantidadPorAnillo[anillo];
            double anguloIncremento = 360.0 / cantidad;
            
            for (int i = 0; i < cantidad; i++) {
                double angle = i * anguloIncremento + (anillo * 22.5); // Offset para alternar
                double rad = Math.toRadians(angle);
                int pilarX = (int)(centerX + Math.cos(rad) * radio);
                int pilarZ = (int)(centerZ + Math.sin(rad) * radio);
                
                // Altura variable según el anillo
                int altura = (anillo == 0) ? 6 : 10;
                
                // Pilar principal
                for (int y = centerY + 1; y <= centerY + altura; y++) {
                    world.getBlockAt(pilarX, y, pilarZ).setType(Material.PURPUR_PILLAR);
                }
                
                // Base decorativa
                for (int dx = -1; dx <= 1; dx++) {
                    for (int dz = -1; dz <= 1; dz++) {
                        if (dx != 0 || dz != 0) {
                            world.getBlockAt(pilarX + dx, centerY, pilarZ + dz).setType(Material.END_STONE_BRICKS);
                        }
                    }
                }
                
                // Cima con luz
                world.getBlockAt(pilarX, centerY + altura, pilarZ).setType(Material.END_ROD);
            }
        }
        
        plugin.getLogger().info("[Arena Builder] ✅ Pilares de batalla espaciados completados");
    }
    
    /**
     * Runas luminosas simples para efectos atmosféricos
     */
    private void construirRunasLuminosasSimples(World world, int centerX, int centerY, int centerZ) {
        plugin.getLogger().info("[Arena Builder] Construyendo runas luminosas simples...");
        
        // Runas dispersas en posiciones estratégicas
        int[][] posicionesRunas = {
            {centerX + 8, centerZ + 8}, {centerX - 8, centerZ + 8}, 
            {centerX + 8, centerZ - 8}, {centerX - 8, centerZ - 8},
            {centerX + 15, centerZ}, {centerX - 15, centerZ}, 
            {centerX, centerZ + 15}, {centerX, centerZ - 15}
        };
        
        for (int[] pos : posicionesRunas) {
            int runaX = pos[0];
            int runaZ = pos[1];
            
            // Runa simple con end rod
            world.getBlockAt(runaX, centerY + 1, runaZ).setType(Material.END_ROD);
            world.getBlockAt(runaX, centerY, runaZ).setType(Material.PURPUR_BLOCK);
            
            // Pequeña decoración alrededor
            world.getBlockAt(runaX + 1, centerY, runaZ).setType(Material.END_STONE_BRICKS);
            world.getBlockAt(runaX - 1, centerY, runaZ).setType(Material.END_STONE_BRICKS);
            world.getBlockAt(runaX, centerY, runaZ + 1).setType(Material.END_STONE_BRICKS);
            world.getBlockAt(runaX, centerY, runaZ - 1).setType(Material.END_STONE_BRICKS);
        }
        
        plugin.getLogger().info("[Arena Builder] ✅ Runas luminosas simples completadas");
    }
}