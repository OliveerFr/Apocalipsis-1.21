package me.apocalipsis.events.apertura;

import org.bukkit.Bukkit;
import org.bukkit.Location;
import org.bukkit.Sound;
import org.bukkit.boss.BarColor;
import org.bukkit.boss.BarStyle;
import org.bukkit.boss.BossBar;
import org.bukkit.entity.Player;
import org.bukkit.scheduler.BukkitRunnable;
import org.bukkit.scheduler.BukkitTask;

import me.apocalipsis.Apocalipsis;
import me.apocalipsis.ui.MessageBus;
import me.apocalipsis.ui.SoundUtil;

/**
 * Gestiona las fases narrativas del evento Apertura del End
 */
public class AperturaEndPhaseManager {
    
    /**
     * Fases narrativas del evento
     */
    public enum EventPhase {
        INACTIVO,
        DESCUBRIMIENTO,    // Fase 1: Overworld, viaje al portal
        LLEGADA,           // Fase 2: Portal se activa
        PORTAL_ABIERTO,    // Fase 2b: Portal activado, esperando entrada
        COMBATE,           // Fase 3: Batalla en el End
        VICTORIA,          // Fase 4: Dragón muerto, silencio
        CLIFFHANGER        // Fase 5: Mensaje final
    }
    
    private final Apocalipsis plugin;
    private final MessageBus messageBus;
    private final SoundUtil soundUtil;
    
    private EventPhase faseEvento = EventPhase.INACTIVO;
    private int descubrimientoTimer = 2700; // 45 minutos
    private boolean direccionRevelada = false;
    
    // UI
    private BossBar bossBar;
    
    // Tareas
    private BukkitTask preparacionTask;
    
    // Referencias a otros managers
    private AperturaEndWaypointManager waypointManager;
    private AperturaEndEffectsManager effectsManager;
    private AperturaEndDragonController dragonController;
    private AperturaEndArenaBuilder arenaBuilder;
    private me.apocalipsis.events.AperturaEndEvent eventRef; // Referencia al evento principal
    
    public AperturaEndPhaseManager(Apocalipsis plugin, MessageBus messageBus, SoundUtil soundUtil) {
        this.plugin = plugin;
        this.messageBus = messageBus;
        this.soundUtil = soundUtil;
    }
    
    public void setManagers(AperturaEndWaypointManager waypointManager, AperturaEndEffectsManager effectsManager, 
                           AperturaEndDragonController dragonController, AperturaEndArenaBuilder arenaBuilder,
                           me.apocalipsis.events.AperturaEndEvent eventRef) {
        this.waypointManager = waypointManager;
        this.effectsManager = effectsManager;
        this.dragonController = dragonController;
        this.arenaBuilder = arenaBuilder;
        this.eventRef = eventRef;
    }
    
    public void iniciarFaseDescubrimiento(int duracionSegundos) {
        faseEvento = EventPhase.DESCUBRIMIENTO;
        descubrimientoTimer = duracionSegundos;
        direccionRevelada = false;
        
        // Crear BossBar
        bossBar = Bukkit.createBossBar(
            "§8Descubrimiento: 30:00",
            BarColor.PURPLE,
            BarStyle.SEGMENTED_10
        );
        
        // Añadir jugadores
        for (Player player : Bukkit.getOnlinePlayers()) {
            bossBar.addPlayer(player);
        }
        bossBar.setVisible(true);
        
        iniciarCountdown();
    }
    
    private void iniciarCountdown() {
        preparacionTask = new BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO) {
                    cancel();
                    return;
                }
                
                descubrimientoTimer--;
                
                // Actualizar BossBar
                int minutos = descubrimientoTimer / 60;
                int segundos = descubrimientoTimer % 60;
                bossBar.setTitle(String.format("§8Descubrimiento: %02d:%02d", minutos, segundos));
                bossBar.setProgress(Math.max(0.0, (double) descubrimientoTimer / 2700.0));
                
                // Eventos de tiempo específicos
                procesarEventosTiempo();
                
                // COUNTDOWN FINAL - Últimos 10 segundos (Intensidad máxima)
                if (descubrimientoTimer <= 10 && descubrimientoTimer > 0) {
                    countdownFinalIntenso();
                }
                
                // Verificar si es tiempo de transición
                if (descubrimientoTimer <= 0 && !direccionRevelada) {
                    revelarDireccion();
                }
            }
        }.runTaskTimer(plugin, 0L, 20L);
    }
    
    private void procesarEventosTiempo() {
        // 40 minutos (2400s) - DIÁLOGO INICIAL ÉPICO + WAYPOINT 1
        if (descubrimientoTimer == 2400) {
            secuenciaDialogoInicial();
        }
        
        // 35 minutos (2100s) - PRIMERA TAREA + WAYPOINT ESPECIAL
        if (descubrimientoTimer == 2100) {
            secuenciaTareaEnderman();
        }
        
        // 30 minutos (1800s) - DIÁLOGO MISTERIOSO WARDEN #1
        if (descubrimientoTimer == 1800) {
            secuenciaDialogoWarden1();
        }
        
        // 25 minutos (1500s) - TRISTEZA PROFUNDA + TAREA 2
        if (descubrimientoTimer == 1500) {
            secuenciaTareaObsidiana();
        }
        
        // 20 minutos (1200s) - TENSIÓN CRECIENTE + TAREA 3
        if (descubrimientoTimer == 1200) {
            secuenciaTareaOjoEnder();
        }
        
        // 15 minutos (900s) - URGENCIA + efectos épicos
        if (descubrimientoTimer == 900) {
            secuenciaUrgencia();
        }
        
        // 12 minutos (720s) - DIÁLOGO MISTERIOSO WARDEN #3 (ADVERTENCIA CRÍTICA)
        if (descubrimientoTimer == 720) {
            secuenciaAdvertenciaWardenCritica();
        }
        
        // 10 minutos (600s) - VACÍO ENVOLVENTE + EMPUJES + BRÚJULA
        if (descubrimientoTimer == 600) {
            secuenciaVacioEnvolvente();
        }
        
        // 5 minutos (300s) - ALTA TENSIÓN + DARKNESS
        if (descubrimientoTimer == 300) {
            secuenciaAltaTension();
        }
        
        // 3 minutos (180s) - ADVERTENCIA FINAL + TELETRANSPORTE
        if (descubrimientoTimer == 180) {
            secuenciaAdvertenciaFinal();
        }
        
        // 1 minuto (60s) - MÁXIMA TENSIÓN + secuencia épica final
        if (descubrimientoTimer == 60) {
            secuenciaMaximaTension();
        }
        
        // 0 segundos - TRANSICIÓN A LLEGADA
        if (descubrimientoTimer <= 0) {
            if (!direccionRevelada) {
                revelarDireccion();
            }
        }
    }
    
    /**
     * 40 minutos - Diálogo inicial épico con el Observador
     */
    private void secuenciaDialogoInicial() {
        new org.bukkit.scheduler.BukkitRunnable() {
            int etapa = 0;
            
            @Override
            public void run() {
                switch (etapa) {
                    case 0:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§5§l⚡ EL OBSERVADOR SUSURRA:");
                        break;
                    case 1:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §7Ha pasado tanto tiempo...");
                        break;
                    case 2:
                        Bukkit.broadcastMessage("§8[§7...§8] §7El portal está §5manifestándose §7de nuevo.");
                        // Efectos místicos
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, p.getLocation(), 30, 2, 1, 2, 0.1);
                            p.playSound(p.getLocation(), org.bukkit.Sound.BLOCK_END_PORTAL_SPAWN, 0.3f, 1.5f);
                        }
                        break;
                    case 3:
                        Bukkit.broadcastMessage("§8[§7...§8] §8Como un eco del pasado que no quiere morir.");
                        break;
                    case 4:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §7Pero esta vez es §c§ldiferente§7.");
                        break;
                    case 5:
                        Bukkit.broadcastMessage("§8[§7...§8] §7Puedo sentir algo... §4§lmás oscuro§7.");
                        // Efectos de oscuridad
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                                org.bukkit.potion.PotionEffectType.DARKNESS, 60, 0, false, false, false));
                            p.getWorld().spawnParticle(org.bukkit.Particle.SOUL_FIRE_FLAME, p.getLocation(), 20, 1.5, 0.5, 1.5, 0.02);
                        }
                        break;
                    case 6:
                        mostrarTituloObserver("§8§o...", "§7§oEste umbral… lo recuerdo sellado.", 10, 80, 30);
                        break;
                    case 7:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        
                        // WAYPOINT 1: Crear primer waypoint
                        if (waypointManager != null) {
                            new org.bukkit.scheduler.BukkitRunnable() {
                                @Override
                                public void run() {
                                    waypointManager.intentarCrearWaypoint(0.8, "§5§l⚡ ECO DISTANTE", "§7Algo resuena al norte...");
                                }
                            }.runTaskLater(plugin, 20L);
                        }
                        
                        this.cancel();
                        break;
                }
                etapa++;
            }
        }.runTaskTimer(plugin, 0L, 60L); // Cada 3 segundos
    }
    
    /**
     * 35 minutos - Primera tarea con efectos cinematográficos
     */
    private void secuenciaTareaEnderman() {
        // Efectos de revelación
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.sendTitle("§5§l⚡", "§8§l▬▬▬▬▬▬▬▬▬▬▬▬▬", 10, 40, 10);
        }
        
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                mostrarTituloObserver("§5§l35 MINUTOS", "§7La primera prueba se acerca", 10, 60, 20);
                
                // Efectos épicos
                for (Player p : Bukkit.getOnlinePlayers()) {
                    Location loc = p.getLocation();
                    p.getWorld().spawnParticle(org.bukkit.Particle.END_ROD, loc.clone().add(0, 3, 0), 40, 1, 2, 1, 0.2);
                    p.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, loc, 80, 2.5, 1.5, 2.5, 0.5);
                    p.getWorld().spawnParticle(org.bukkit.Particle.DRAGON_BREATH, loc, 30, 2, 1, 2, 0.05);
                    
                    p.playSound(loc, org.bukkit.Sound.BLOCK_END_PORTAL_FRAME_FILL, 1.2f, 0.8f);
                    p.playSound(loc, org.bukkit.Sound.ENTITY_ENDER_DRAGON_GROWL, 0.8f, 0.5f);
                }
                
                // Mostrar tarea después de efectos
                new org.bukkit.scheduler.BukkitRunnable() {
                    @Override
                    public void run() {
                        effectsManager.mostrarTareaEnderman();
                    }
                }.runTaskLater(plugin, 60L);
            }
        }.runTaskLater(plugin, 30L);
        
        programarMensajeRetrasado("§8[§7...§8] §7Como la última vez. Como todas las veces.", 120);
    }
    
    /**
     * 30 minutos - Primer diálogo misterioso sobre el Warden
     */
    private void secuenciaDialogoWarden1() {
        new org.bukkit.scheduler.BukkitRunnable() {
            int etapa = 0;
            
            @Override
            public void run() {
                switch (etapa) {
                    case 0:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
