                // Partículas de condena
                for (Player p : Bukkit.getOnlinePlayers()) {
                    Location loc = p.getLocation();
                    p.getWorld().spawnParticle(org.bukkit.Particle.SCULK_CHARGE, loc, 40, 3, 1, 3, 0.5);
                    p.getWorld().spawnParticle(org.bukkit.Particle.CRIMSON_SPORE, loc, 50, 2, 2, 2, 0.1);
                    p.playSound(loc, org.bukkit.Sound.ENTITY_WARDEN_AMBIENT, 1.0f, 0.6f);
                    p.playSound(loc, org.bukkit.Sound.BLOCK_SCULK_SHRIEKER_SHRIEK, 0.5f, 0.7f);
