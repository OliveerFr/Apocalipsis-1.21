        }.runTaskLater(plugin, 100L);
        
        // TELETRANSPORTE MÁS AGRESIVO cada 15 segundos
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                iniciarTeletransporteIntensivo();
            }
        }.runTaskLater(plugin, 120L);
    }
    
    /**
     * 1 minuto - Máxima tensión + secuencia épica final
     */
    private void secuenciaMaximaTension() {
        // Secuencia cinematográfica final
        new org.bukkit.scheduler.BukkitRunnable() {
            int tick = 0;
            
            @Override
            public void run() {
                if (tick == 0) {
                    // Pantalla negra inicial + DARKNESS máxima
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        p.sendTitle("§0§l███████", "§0§l███████", 10, 30, 10);
                        
                        // DARKNESS TOTAL - 15 segundos
                        p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                            org.bukkit.potion.PotionEffectType.DARKNESS, 300, 0, false, false, false));
                    }
                } else if (tick == 40) {
                    // Revelación dramática
                    mostrarTituloObserver("§c§l1 MINUTO", "§8§oEl portal despierta", 15, 70, 25);
                    
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        Location loc = p.getLocation();
                        
                        // Explosión masiva de efectos
                        p.getWorld().spawnParticle(org.bukkit.Particle.EXPLOSION, loc.clone().add(0, 2, 0), 3);
                        p.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, loc, 200, 5, 3, 5, 2.0);
                        p.getWorld().spawnParticle(org.bukkit.Particle.DRAGON_BREATH, loc, 120, 4, 2, 4, 0.5);
                        p.getWorld().spawnParticle(org.bukkit.Particle.END_ROD, loc.clone().add(0, 4, 0), 80, 2, 3, 2, 0.5);
                        p.getWorld().spawnParticle(org.bukkit.Particle.REVERSE_PORTAL, loc, 100, 3, 2, 3, 1.0);
                        
                        p.playSound(loc, org.bukkit.Sound.ENTITY_ENDER_DRAGON_DEATH, 1.0f, 2.0f);
                        p.playSound(loc, org.bukkit.Sound.ENTITY_WARDEN_HEARTBEAT, 1.5f, 0.5f);
                        p.playSound(loc, org.bukkit.Sound.ENTITY_GENERIC_EXPLODE, 1.0f, 0.6f);
                        p.playSound(loc, org.bukkit.Sound.BLOCK_END_PORTAL_SPAWN, 1.5f, 0.5f);
                    }
                }
                
                tick++;
                if (tick >= 80) {
                    this.cancel();
                }
            }
        }.runTaskTimer(plugin, 0L, 1L); // Más rápido para mayor intensidad
        
        programarMensajeRetrasado("§8[§7...§8] §7Deberían haber traído más que armadura.", 100);
        
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                mostrarTituloObserver("§8§o...", "§7§oDeberían haber traído esperanza.", 15, 80, 25);
                
                // Partículas de desesperanza
                for (Player p : Bukkit.getOnlinePlayers()) {
                    Location loc = p.getLocation();
                    p.getWorld().spawnParticle(org.bukkit.Particle.SOUL, loc, 60, 3, 2, 3, 0.05);
                    p.getWorld().spawnParticle(org.bukkit.Particle.ASH, loc, 80, 3, 2, 3, 0.1);
                }
            }
        }.runTaskLater(plugin, 160L);
    }
    
    /**
     * Programa un mensaje retrasado
     */
    private void programarMensajeRetrasado(String mensaje, long ticks) {
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage(mensaje);
            }
        }.runTaskLater(plugin, ticks);
    }
    
    /**
     * Countdown final intenso - Últimos 10 segundos
     */
    private void countdownFinalIntenso() {
        for (Player player : Bukkit.getOnlinePlayers()) {
            player.sendTitle("§c§l" + descubrimientoTimer, "§8§oEl vacío espera", 5, 10, 5);
            
            Location loc = player.getLocation();
            // Efectos crecientes según se acerca el final
            int intensidad = (11 - descubrimientoTimer) * 10;
            player.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, loc, intensidad, 1, 1, 1, 0.5);
            player.getWorld().spawnParticle(org.bukkit.Particle.END_ROD, loc.clone().add(0, 2, 0), intensidad / 2, 0.5, 1, 0.5, 0.1);
            
            player.playSound(loc, org.bukkit.Sound.BLOCK_NOTE_BLOCK_HAT, 1.5f, 0.8f);
            player.playSound(loc, org.bukkit.Sound.ENTITY_WARDEN_HEARTBEAT, 1.0f + (intensidad * 0.01f), 1.0f);
            
            if (descubrimientoTimer <= 5) {
                player.playSound(loc, org.bukkit.Sound.BLOCK_END_PORTAL_SPAWN, 0.5f, 2.0f);
                
                // DARKNESS pulsante en últimos 5 segundos
                if (descubrimientoTimer % 2 == 0) {
                    player.addPotionEffect(new org.bukkit.potion.PotionEffect(
                        org.bukkit.potion.PotionEffectType.DARKNESS, 40, 0, false, false, false));
                }
            }
        }
        
        // Verificar si hay jugadores cerca del portal para activación
        if (waypointManager != null && waypointManager.getPortalLocation() != null) {
            checkJugadoresCercaPortal();
        }
    }
    
    /**
     * Inicia sistema de empujes suaves hacia el portal (cada 30 segundos)
     */
    private void iniciarEmpujesHaciaPortal() {
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || waypointManager.getPortalLocation() == null) {
                    cancel();
                    return;
                }
                
                Location portalLocation = waypointManager.getPortalLocation();
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(portalLocation.getWorld())) continue;
                    
                    double distancia = p.getLocation().distance(portalLocation);
                    
                    // Solo empujar si están lejos (más de 100 bloques)
                    if (distancia > 100) {
                        // Vector hacia el portal
                        org.bukkit.util.Vector direction = portalLocation.toVector()
                            .subtract(p.getLocation().toVector())
                            .normalize()
                            .multiply(0.3); // Empuje suave
                        
                        p.setVelocity(p.getVelocity().add(direction));
                        
                        // Efectos visuales
                        p.spawnParticle(org.bukkit.Particle.PORTAL, p.getLocation(), 20, 1, 1, 1, 0.1);
                        p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_ENDERMAN_TELEPORT, 0.3f, 1.5f);
                        p.sendActionBar("§5§l» §7Algo te atrae hacia el portal... §5§l«");
                    }
                }
            }
        }.runTaskTimer(plugin, 100L, 600L); // Cada 30 segundos
    }
    
    /**
     * Inicia teletransporte intensivo hacia el portal (últimos 3 minutos)
     */
    private void iniciarTeletransporteIntensivo() {
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || waypointManager.getPortalLocation() == null) {
                    cancel();
                    return;
                }
                
                Location portalLocation = waypointManager.getPortalLocation();
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(portalLocation.getWorld())) continue;
                    
                    double distancia = p.getLocation().distance(portalLocation);
                    
                    // Teletransportar si están muy lejos (más de 200 bloques)
                    if (distancia > 200) {
                        // Calcular punto intermedio (acercar 100 bloques hacia el portal)
                        org.bukkit.util.Vector direction = portalLocation.toVector()
                            .subtract(p.getLocation().toVector())
                            .normalize()
                            .multiply(100);
                        
                        Location newLoc = p.getLocation().clone().add(direction);
                        newLoc.setY(portalLocation.getWorld().getHighestBlockYAt(newLoc) + 1);
                        
                        // Efectos pre-teletransporte
                        p.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, p.getLocation(), 100, 1, 2, 1, 1.0);
                        p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_ENDERMAN_TELEPORT, 1.0f, 0.8f);
                        
                        // Teletransportar
                        p.teleport(newLoc);
                        
                        // Efectos post-teletransporte
                        p.getWorld().spawnParticle(org.bukkit.Particle.REVERSE_PORTAL, newLoc, 100, 1, 2, 1, 1.0);
                        p.playSound(newLoc, org.bukkit.Sound.ENTITY_ENDERMAN_TELEPORT, 1.0f, 1.2f);
                        
                        p.sendTitle("§5§l⚡", "§7El Vacío te arrastra", 10, 30, 10);
                        p.sendMessage("§8[§7...§8] §5El portal te llama...");
                    }
                }
            }
        }.runTaskTimer(plugin, 100L, 300L); // Cada 15 segundos
    }
    
    /**
     * Muestra brújula direccional con flechas en ActionBar
     * Activa desde los 10 minutos restantes para guiar a los jugadores al portal
     */
    private void iniciarBrujulaDireccional() {
        // Mensaje informativo
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§5§l⚡ BRÚJULA ACTIVADA ⚡");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§7Las flechas ahora guían §lconstantemente§7.");
        Bukkit.broadcastMessage("§8El portal está muy cerca...");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                if (faseEvento != EventPhase.DESCUBRIMIENTO || waypointManager.getPortalLocation() == null) {
                    cancel();
                    return;
                }
                
                Location portalLocation = waypointManager.getPortalLocation();
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (!p.getWorld().equals(portalLocation.getWorld())) continue;
                    
                    Location playerLoc = p.getLocation();
                    double distancia = playerLoc.distance(portalLocation);
                    
                    // Calcular dirección
                    org.bukkit.util.Vector toPortal = portalLocation.toVector().subtract(playerLoc.toVector());
                    double angle = Math.atan2(toPortal.getZ(), toPortal.getX());
                    
                    // Convertir a dirección del jugador
                    float playerYaw = playerLoc.getYaw();
                    double playerAngle = Math.toRadians(playerYaw + 90); // Ajuste por sistema de coordenadas
                    
                    // Calcular diferencia angular
                    double diffAngle = angle - playerAngle;
                    
                    // Normalizar a -PI a PI
                    while (diffAngle > Math.PI) diffAngle -= 2 * Math.PI;
                    while (diffAngle < -Math.PI) diffAngle += 2 * Math.PI;
                    
                    // Determinar flecha según ángulo
                    String flecha;
                    String direccion;
                    
                    if (Math.abs(diffAngle) < Math.PI / 8) {
                        // Adelante
                        flecha = "↑↑↑";
                        direccion = "§a§lADELANTE";
                    } else if (Math.abs(diffAngle) > 7 * Math.PI / 8) {
                        // Atrás
                        flecha = "↓↓↓";
                        direccion = "§c§lATRÁS";
                    } else if (diffAngle > 0) {
                        // Izquierda
                        if (diffAngle < 3 * Math.PI / 8) {
                            flecha = "↖↖↖";
                            direccion = "§e§lIZQUIERDA ADELANTE";
                        } else if (diffAngle < 5 * Math.PI / 8) {
                            flecha = "←←←";
                            direccion = "§e§lIZQUIERDA";
                        } else {
                            flecha = "↙↙↙";
                            direccion = "§6§lIZQUIERDA ATRÁS";
                        }
                    } else {
                        // Derecha
                        if (diffAngle > -3 * Math.PI / 8) {
                            flecha = "↗↗↗";
                            direccion = "§b§lDERECHA ADELANTE";
                        } else if (diffAngle > -5 * Math.PI / 8) {
                            flecha = "→→→";
                            direccion = "§b§lDERECHA";
                        } else {
                            flecha = "↘↘↘";
                            direccion = "§3§lDERECHA ATRÁS";
                        }
                    }
                    
                    // Mostrar en ActionBar
                    String distanciaStr = distancia < 1000 ? String.format("§b%d bloques", (int)distancia) : String.format("§b%.1fkm", distancia / 1000);
                    p.sendActionBar("§5§l⚡ PORTAL §8§l| " + flecha + " " + direccion + " §8§l| " + distanciaStr);
                }
            }
        }.runTaskTimer(plugin, 20L, 20L); // Cada segundo
    }
    
    /**
     * Verifica si hay jugadores cerca del portal para activar Fase 2
     * REQUISITO: El iniciador del evento DEBE estar cerca del portal para que se active
     */
    private void checkJugadoresCercaPortal() {
        if (waypointManager.getPortalLocation() == null) return;
        if (faseEvento != EventPhase.DESCUBRIMIENTO) return;
        
        Location portalLocation = waypointManager.getPortalLocation();
        int radioDeteccion = 30; // Reducido a 30 bloques (debe estar MUY cerca)
        
        for (Player player : Bukkit.getOnlinePlayers()) {
            if (player.getWorld().equals(portalLocation.getWorld())) {
                double distancia = player.getLocation().distance(portalLocation);
                
                // DEBUG: Mostrar distancia al jugador si está relativamente cerca
                // PERO solo si NO está activa la brújula direccional (timer > 600 seg)
                if (distancia <= 200 && descubrimientoTimer > 600) {
                    player.sendActionBar("§8[§7Portal§8] §7Distancia: §b" + (int)distancia + " bloques §8(Activación: §a<" + radioDeteccion + "§8)");
                }
                
                if (distancia <= radioDeteccion) {
                    // ¡Jugadores llegaron al portal!
                    plugin.getLogger().info("[Apertura End] ✓ Jugador " + player.getName() + " detectado a " + (int)distancia + " bloques del portal");
                    Bukkit.broadcastMessage("§a§l✓ " + player.getName() + " ha llegado al portal!");
                    iniciarFaseLlegadaEpica();
                    return;
                }
            }
        }
    }
    
    /**
     * FASE 2: Llegada al portal
     * Jugadores detectados cerca, portal se activa lentamente
     */
    private void iniciarFaseLlegadaEpica() {
        cambiarFase(EventPhase.LLEGADA);
        
        // ========================================
        // CINEMÁTICO ÉPICO - PORTAL ACTIVANDOSE
        // ========================================
        
        Location portalLocation = waypointManager.getPortalLocation();
        if (portalLocation != null) {
            org.bukkit.World world = portalLocation.getWorld();
            
            // 1. CAMBIAR A NOCHE INSTANTÁNEA
            world.setTime(18000); // Medianoche
            world.setStorm(true); // Iniciar tormenta
            world.setThunderDuration(12000); // Duración de la tormenta (10 minutos)
            world.setWeatherDuration(12000);
            
            plugin.getLogger().info("[Apertura End] ⚡ CINEMÁTICO ACTIVADO: Noche + Tormenta");
        }
        
        // 2. EFECTOS VISUALES MASIVOS DE OSCURIDAD PARA TODOS
        for (Player p : Bukkit.getOnlinePlayers()) {
            // Fade to black completo
            p.sendTitle("§8§l█████████████", "§8§l█████████████", 10, 60, 30);
            
            // Aplicar ceguera breve para efecto oscuro
            p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                org.bukkit.potion.PotionEffectType.BLINDNESS, 
                60, // 3 segundos
                1, 
                false, 
                false, 
                false
            ));
            
            // Sonidos de terror
            p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_WITHER_SPAWN, 1.5f, 0.5f);
            p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_ENDER_DRAGON_GROWL, 2.0f, 0.4f);
            p.playSound(p.getLocation(), org.bukkit.Sound.AMBIENT_CAVE, 1.0f, 0.5f);
        }
        
        // 3. ANUNCIO DRÁMATICO CON RETRASO
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§5§l⚡ EL PORTAL DESPIERTA ⚡");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§7...§8] §7Aquí fue donde todo terminó… más de una vez.");
                Bukkit.broadcastMessage("§8[§7...§8] §7Y aun así, siguen entrando.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                
                // Título épico
                for (Player p : Bukkit.getOnlinePlayers()) {
                    p.sendTitle("§8§l⚠ §4EL PORTAL DESPIERTA", "§5Una grieta entre mundos se abre...", 10, 80, 20);
                }
            }
        }.runTaskLater(plugin, 60L); // 3 segundos después
        
        // 4. ACTIVAR PORTAL EN EL EVENTO PRINCIPAL
        if (eventRef != null) {
            new org.bukkit.scheduler.BukkitRunnable() {
                @Override
                public void run() {
                    eventRef.activarPortalLentamente();
                }
            }.runTaskLater(plugin, 100L); // 5 segundos después
        }
    }
    
    /**
     * Muestra título del Observador a todos los jugadores
     */
    private void mostrarTituloObserver(String titulo, String subtitulo, int fadeIn, int stay, int fadeOut) {
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.sendTitle(titulo, subtitulo, fadeIn, stay, fadeOut);
        }
    }
    
    public void revelarDireccion() {
        direccionRevelada = true;
        
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§5§l⚡ DIRECCIÓN REVELADA ⚡");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.playSound(p.getLocation(), Sound.BLOCK_END_PORTAL_SPAWN, 1.5f, 1.0f);
        }
        
        // Revelar coordenadas a través del waypoint manager
        if (waypointManager != null) {
            waypointManager.revelarDireccion();
        }
        
        // Cambiar a fase de llegada después de revelar
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                cambiarFase(EventPhase.LLEGADA);
            }
        }.runTaskLater(plugin, 100L); // 5 segundos después
    }
    
    public void cambiarFase(EventPhase nuevaFase) {
        this.faseEvento = nuevaFase;
        
        switch (nuevaFase) {
            case LLEGADA:
                if (bossBar != null) {
                    bossBar.setTitle("§8El portal se activa...");
                    bossBar.setColor(BarColor.WHITE);
                }
                
                // Construir arena épica cuando se activa la llegada
                if (arenaBuilder != null) {
                    new org.bukkit.scheduler.BukkitRunnable() {
                        @Override
                        public void run() {
                            arenaBuilder.construirArenaCompleta();
                        }
                    }.runTaskLater(plugin, 20L); // 1 segundo después
                }
                
                // Activar portal lentamente
                if (eventRef != null) {
                    new org.bukkit.scheduler.BukkitRunnable() {
                        @Override
                        public void run() {
                            eventRef.activarPortalLentamente();
                        }
                    }.runTaskLater(plugin, 40L); // 2 segundos después
                }
                break;
                
            case PORTAL_ABIERTO:
                if (bossBar != null) {
                    bossBar.setTitle("§8El portal está activo - Entra al End");
                    bossBar.setColor(BarColor.PURPLE);
                }
                break;
                
            case COMBATE:
                if (bossBar != null) {
                    bossBar.setTitle("§c§lDesolador del Vacío");
                    bossBar.setColor(BarColor.RED);
                }
                
                // Spawnear dragón cuando inicia el combate
                if (dragonController != null) {
                    new org.bukkit.scheduler.BukkitRunnable() {
                        @Override
                        public void run() {
                            dragonController.spawnearDragon();
                        }
                    }.runTaskLater(plugin, 40L); // 2 segundos después
                }
                break;
                
            case CLIFFHANGER:
                if (bossBar != null) {
                    bossBar.setTitle("§8§lEvento completado");
                    bossBar.setColor(BarColor.GREEN);
                }
                break;
        }
    }
    
    public void detener() {
        if (bossBar != null) {
            bossBar.removeAll();
            bossBar.setVisible(false);
        }
        
        if (preparacionTask != null) {
            preparacionTask.cancel();
        }
        
        faseEvento = EventPhase.INACTIVO;
    }
    
    // Getters
    public EventPhase getFaseEvento() { return faseEvento; }
    public int getDescubrimientoTimer() { return descubrimientoTimer; }
    public boolean isDireccionRevelada() { return direccionRevelada; }
    public BossBar getBossBar() { return bossBar; }
}