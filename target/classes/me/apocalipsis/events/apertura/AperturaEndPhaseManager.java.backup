                    case 7:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        this.cancel();
                        break;
                }
                etapa++;
            }
        }.runTaskTimer(plugin, 0L, 50L); // Cada 2.5 segundos
    }
    
    /**
     * 25 minutos - Tristeza profunda + Segunda tarea
     */
    private void secuenciaTareaObsidiana() {
        // Fade oscuro dramático + DARKNESS
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.sendTitle("§8§l█", "§8§l█", 20, 60, 20);
            
            // DARKNESS - Oscuridad profunda (8 segundos)
            p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                org.bukkit.potion.PotionEffectType.DARKNESS, 160, 0, false, false, false));
        }
        
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                mostrarTituloObserver("§8§o...", "§7§oCuántas veces he visto este momento.", 10, 100, 30);
                
                // Efectos de tristeza (warped spore + soul)
                for (Player p : Bukkit.getOnlinePlayers()) {
                    Location loc = p.getLocation();
                    p.getWorld().spawnParticle(org.bukkit.Particle.WARPED_SPORE, loc, 40, 3, 2, 3, 0.02);
                    p.getWorld().spawnParticle(org.bukkit.Particle.SOUL, loc.clone().add(0, 0.5, 0), 15, 1, 0.5, 1, 0.01);
                    p.playSound(loc, org.bukkit.Sound.ENTITY_ELDER_GUARDIAN_AMBIENT, 0.4f, 0.5f);
                    p.playSound(loc, org.bukkit.Sound.PARTICLE_SOUL_ESCAPE, 0.8f, 0.6f);
                }
            }
        }.runTaskLater(plugin, 80L);
        
        programarMensajeRetrasado("§8[§7...§8] §7Y cuántas más faltan.", 140);
        
        // Mostrar tarea después del diálogo
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                effectsManager.mostrarTareaObsidiana();
            }
        }.runTaskLater(plugin, 180L);
    }
    
    /**
     * 20 minutos - Tensión creciente + Tercera tarea
     */
    private void secuenciaTareaOjoEnder() {
        Bukkit.broadcastMessage("§8[§7...§8] §7El mundo está… apurado.");
        
        // Efectos de persecución
        for (Player p : Bukkit.getOnlinePlayers()) {
            Location loc = p.getLocation();
            p.getWorld().spawnParticle(org.bukkit.Particle.SCULK_SOUL, loc.clone().add(0, 0.2, 0), 25, 2, 0.2, 2, 0.1);
            p.playSound(loc, org.bukkit.Sound.BLOCK_SCULK_SHRIEKER_SHRIEK, 0.3f, 0.8f);
        }
        
        new org.bukkit.scheduler.BukkitRunnable() {
            int tick = 0;
            
            @Override
            public void run() {
                if (tick == 0) {
                    mostrarTituloObserver("§8§o...", "§7§oComo si algo lo persiguiera.", 10, 70, 20);
                }
                
                // Latidos aumentando
                for (Player p : Bukkit.getOnlinePlayers()) {
                    p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_WARDEN_HEARTBEAT, 0.5f + (tick * 0.1f), 0.8f);
                    
                    if (tick % 20 == 0) {
                        Location loc = p.getLocation();
                        p.getWorld().spawnParticle(org.bukkit.Particle.CRIMSON_SPORE, loc, 10, 1.5, 1, 1.5, 0.05);
                    }
                }
                
                tick++;
                if (tick >= 60) {
                    this.cancel();
                    
                    // Mostrar tarea después de efectos
                    new org.bukkit.scheduler.BukkitRunnable() {
                        @Override
                        public void run() {
                            effectsManager.mostrarTareaOjoEnder();
                        }
                    }.runTaskLater(plugin, 20L);
                }
            }
        }.runTaskTimer(plugin, 40L, 10L);
    }
    
    /**
     * 15 minutos - Urgencia + efectos épicos
     */
    private void secuenciaUrgencia() {
        // Efecto de revelación cinematográfico
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.sendTitle("§5§l⚡", "§8§l▬▬▬▬▬▬▬▬▬▬▬▬▬", 10, 40, 10);
        }
        
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                mostrarTituloObserver("§8§l15 MINUTOS", "§7El portal se acerca", 10, 60, 20);
                
                // Explosión de partículas épica
                for (Player p : Bukkit.getOnlinePlayers()) {
                    Location loc = p.getLocation();
                    p.getWorld().spawnParticle(org.bukkit.Particle.END_ROD, loc.clone().add(0, 3, 0), 50, 0.5, 2, 0.5, 0.2);
                    p.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, loc, 100, 3, 2, 3, 1.0);
                    p.getWorld().spawnParticle(org.bukkit.Particle.DRAGON_BREATH, loc, 40, 2, 1, 2, 0.05);
                    
                    p.playSound(loc, org.bukkit.Sound.BLOCK_END_PORTAL_FRAME_FILL, 1.2f, 0.8f);
                    p.playSound(loc, org.bukkit.Sound.BLOCK_END_PORTAL_SPAWN, 0.5f, 1.5f);
                    p.playSound(loc, org.bukkit.Sound.ENTITY_LIGHTNING_BOLT_THUNDER, 0.4f, 1.8f);
                }
            }
        }.runTaskLater(plugin, 30L);
        
        programarMensajeRetrasado("§8[§7...§8] §7No fueron suficientes la última vez.", 80);
        programarMensajeRetrasado("§8[§7...§8] §7Ni la anterior.", 140);
    }
    
    /**
     * 12 minutos - Diálogo misterioso crítico sobre el Warden
     */
    private void secuenciaAdvertenciaWardenCritica() {
        new org.bukkit.scheduler.BukkitRunnable() {
            int etapa = 0;
            
            @Override
            public void run() {
                switch (etapa) {
                    case 0:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§5§l⚡ EL OBSERVADOR §8[PERTURBADO]:");
                        // Título dramático
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.sendTitle("§4§l⚠", "§8§oEl Observador tiembla...", 10, 50, 20);
                        }
                        break;
                    case 1:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §c§lDebo decirlo.");
                        break;
                    case 2:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §7Aquel §4§lGuardián§7… no era del End.");
                        // Sonido del Warden - más fuerte
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_WARDEN_ROAR, 0.5f, 0.6f);
                            p.getWorld().spawnParticle(org.bukkit.Particle.SCULK_SOUL, p.getLocation(), 40, 2.5, 1.5, 2.5, 0.15);
                        }
                        break;
                    case 3:
                        Bukkit.broadcastMessage("§8[§7...§8] §8Venía desde §4§lLAS PROFUNDIDADES§8.");
                        break;
                    case 4:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §7Un lugar que §cni siquiera yo§7 conozco del todo.");
                        break;
                    case 5:
                        Bukkit.broadcastMessage("§8[§7...§8] §8§oMás allá del Overworld. Más allá del Nether.");
                        break;
                    case 6:
                        Bukkit.broadcastMessage("§8[§7...§8] §8§oMás allá del End.");
                        // Efectos de oscuridad profunda
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                                org.bukkit.potion.PotionEffectType.DARKNESS, 100, 0, false, false, false));
                            p.getWorld().spawnParticle(org.bukkit.Particle.ASH, p.getLocation().add(0, 2, 0), 50, 3, 2, 3, 0.05);
                        }
                        break;
                    case 7:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §c§lY si ESO fue enviado como guardián…");
                        break;
                    case 8:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §4§l§o…temo lo que vendrá después.");
                        // Latidos del corazón acelerados
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_WARDEN_HEARTBEAT, 0.8f, 0.7f);
                        }
                        break;
                    case 9:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §7El End no es el final.");
                        break;
                    case 10:
                        Bukkit.broadcastMessage("§8[§7...§8] §8§oEs solo… §5el principio§8§o de algo mucho peor.");
                        // Efecto final dramático
                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.playSound(p.getLocation(), org.bukkit.Sound.ENTITY_WARDEN_SONIC_BOOM, 0.3f, 0.5f);
                            p.playSound(p.getLocation(), org.bukkit.Sound.AMBIENT_CAVE, 1.0f, 0.4f);
                            p.getWorld().spawnParticle(org.bukkit.Particle.SCULK_CHARGE, p.getLocation().add(0, 1, 0), 30, 2, 1.5, 2, 0.2);
                            p.sendTitle("§4§l⚠ ADVERTENCIA ⚠", "§8§oLas Profundidades aguardan...", 10, 70, 30);
                        }
                        break;
                    case 11:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                        Bukkit.broadcastMessage("");
                        this.cancel();
                        break;
                }
                etapa++;
            }
        }.runTaskTimer(plugin, 0L, 50L); // Cada 2.5 segundos
    }
    
    /**
     * 10 minutos - Vacío envolvente + empujes + brújula
     */
    private void secuenciaVacioEnvolvente() {
        // Pantalla de vacío + DARKNESS
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.sendTitle("§0§l████", "§0§l████", 20, 60, 20);
            
            // DARKNESS - Vacío total (10 segundos)
            p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                org.bukkit.potion.PotionEffectType.DARKNESS, 200, 0, false, false, false));
        }
        
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                mostrarTituloObserver("§8§o...", "§7§oPuedo sentir el vacío desde aquí.", 15, 80, 25);
                
                // Vacío envolvente
                for (Player p : Bukkit.getOnlinePlayers()) {
                    Location loc = p.getLocation();
                    p.getWorld().spawnParticle(org.bukkit.Particle.SQUID_INK, loc.clone().add(0, 2, 0), 60, 3, 2, 3, 0.02);
                    p.getWorld().spawnParticle(org.bukkit.Particle.SMOKE, loc, 80, 2, 1, 2, 0.05);
                    p.getWorld().spawnParticle(org.bukkit.Particle.SCULK_SOUL, loc, 30, 2, 1.5, 2, 0.1);
                    
                    p.playSound(loc, org.bukkit.Sound.AMBIENT_CAVE, 2.0f, 0.4f);
                    p.playSound(loc, org.bukkit.Sound.ENTITY_WARDEN_AMBIENT, 0.6f, 0.5f);
                    p.playSound(loc, org.bukkit.Sound.AMBIENT_BASALT_DELTAS_MOOD, 0.8f, 0.3f);
                }
            }
        }.runTaskLater(plugin, 80L);
        
        programarMensajeRetrasado("§8[§7...§8] §7Frío. Silencioso. Esperando.", 160);
        
        // ACTIVAR SISTEMAS DE LLEGADA
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                // EMPEZAR EMPUJES HACIA EL PORTAL cada 30 segundos
                iniciarEmpujesHaciaPortal();
                
                // INICIAR BRÚJULA DIRECCIONAL CON FLECHAS (obligatorio desde los 10 minutos)
                iniciarBrujulaDireccional();
                
                // Revelar dirección si no se ha hecho
                if (!direccionRevelada) {
                    revelarDireccion();
                }
            }
        }.runTaskLater(plugin, 200L);
    }
    
    /**
     * 5 minutos - Alta tensión + efectos apocalípticos
     */
    private void secuenciaAltaTension() {
        // Secuencia apocalíptica
        new org.bukkit.scheduler.BukkitRunnable() {
            int fase = 0;
            
            @Override
            public void run() {
                if (fase == 0) {
                    // Flash rojo + DARKNESS
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        p.sendTitle("§4§l⚠", "§4§l⚠⚠⚠⚠⚠⚠⚠⚠⚠", 5, 15, 5);
                        
                        // DARKNESS - Terror creciente (6 segundos)
                        p.addPotionEffect(new org.bukkit.potion.PotionEffect(
                            org.bukkit.potion.PotionEffectType.DARKNESS, 120, 0, false, false, false));
                    }
                } else if (fase == 1) {
                    mostrarTituloObserver("§c§l5 MINUTOS", "§7§oYa casi están ahí", 10, 60, 20);
                    
                    // Efectos apocalípticos
                    for (Player p : Bukkit.getOnlinePlayers()) {
                        Location loc = p.getLocation();
                        
                        // Explosión de partículas dramática
                        p.getWorld().spawnParticle(org.bukkit.Particle.EXPLOSION, loc.clone().add(0, 1, 0), 5);
                        p.getWorld().spawnParticle(org.bukkit.Particle.LAVA, loc, 40, 2, 1, 2, 0.1);
                        p.getWorld().spawnParticle(org.bukkit.Particle.DRAGON_BREATH, loc, 80, 3, 2, 3, 0.1);
                        p.getWorld().spawnParticle(org.bukkit.Particle.PORTAL, loc, 150, 4, 2, 4, 1.5);
                        p.getWorld().spawnParticle(org.bukkit.Particle.END_ROD, loc.clone().add(0, 3, 0), 60, 1, 2, 1, 0.3);
                        
                        p.playSound(loc, org.bukkit.Sound.ENTITY_ENDER_DRAGON_GROWL, 1.5f, 0.7f);
                        p.playSound(loc, org.bukkit.Sound.ENTITY_WARDEN_ROAR, 0.8f, 0.5f);
                        p.playSound(loc, org.bukkit.Sound.ENTITY_GENERIC_EXPLODE, 0.8f, 0.8f);
                    }
                }
                
                fase++;
                if (fase >= 2) {
                    this.cancel();
                }
            }
        }.runTaskTimer(plugin, 0L, 20L);
        
        programarMensajeRetrasado("§8[§7...§8] §7Si cruzan ese umbral, no hay marcha atrás.", 80);
        
        new org.bukkit.scheduler.BukkitRunnable() {
            @Override
            public void run() {
                mostrarTituloObserver("§8§o...", "§7§oNunca la hay.", 10, 60, 20);
                
                // Eco oscuro
                for (Player p : Bukkit.getOnlinePlayers()) {
                    Location loc = p.getLocation();
                    p.getWorld().spawnParticle(org.bukkit.Particle.SOUL_FIRE_FLAME, loc.clone().add(0, 0.3, 0), 30, 2, 0.5, 2, 0.02);
                    p.getWorld().spawnParticle(org.bukkit.Particle.SMOKE, loc, 60, 2, 2, 2, 0.05);
                    p.playSound(loc, org.bukkit.Sound.ENTITY_WARDEN_LISTENING, 0.8f, 0.5f);
                }
            }
        }.runTaskLater(plugin, 140L);
    }
    
    /**
     * 3 minutos - Advertencia final + ambiente terrorífico + TELETRANSPORTE
     */
