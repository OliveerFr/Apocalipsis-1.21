                        for (Player p : Bukkit.getOnlinePlayers()) {
                            p.getWorld().spawnParticle(org.bukkit.Particle.SCULK_SOUL, p.getLocation(), 30, 2, 1, 2, 0.1);
                        }
                        break;
                    case 5:
                        Bukkit.broadcastMessage("");
                        Bukkit.broadcastMessage("§8[§7...§8] §8§oNunca se han tocado.");
