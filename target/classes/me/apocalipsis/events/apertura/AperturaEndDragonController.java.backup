package me.apocalipsis.events.apertura;

import java.util.*;
import org.bukkit.*;
import org.bukkit.entity.*;
import org.bukkit.scheduler.BukkitRunnable;
import org.bukkit.scheduler.BukkitTask;
import org.bukkit.boss.BarColor;
import org.bukkit.boss.BossBar;
import org.bukkit.potion.PotionEffect;
import org.bukkit.potion.PotionEffectType;

import me.apocalipsis.Apocalipsis;
import me.apocalipsis.events.AperturaEndEvent;

// Model Engine imports (opcionales)
import com.ticxo.modelengine.api.model.ModeledEntity;

/**
 * AperturaEndDragonController
 * 
 * Controlador modular para el sistema de dos dragones del evento Apertura del End.
 * 
 * CARACTERÍSTICAS:
 * - Sistema de doble dragón (vanilla engaño + MythicMobs real)
 * - Soporte para Model Engine con fallback vanilla
 * - Fases de combate dinámicas
 * - Escalado de HP basado en jugadores
 * - Cinemáticas épicas de spawn
 */
public class AperturaEndDragonController {
    
    public enum DragonPhase {
        FASE_1_AEREO,
        FASE_2_DESCENSO, 
        FASE_3_TERRESTRE,
        FASE_4_FURIA,
        FASE_5_AGONIA
    }
    
    public enum DragonType {
        VANILLA,    // Dragón vanilla (engaño inicial)
        MYTHIC      // Dragón MythicMobs (verdadero jefe)
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // REFERENCIAS
    // ═══════════════════════════════════════════════════════════════════
    
    private final Apocalipsis plugin;
    private final AperturaEndEvent event;
    private final BossBar bossBar;
    
    // ═══════════════════════════════════════════════════════════════════
    // ESTADO DEL DRAGÓN
    // ═══════════════════════════════════════════════════════════════════
    
    private DragonPhase faseDragon = DragonPhase.FASE_1_AEREO;
    private DragonType tipoDragonActual = DragonType.VANILLA;
    
    // Dragones
    private EnderDragon dragonVanilla = null;  // Dragón vanilla (primer combate - engaño)
    private EnderDragon dragon = null;         // Dragón final (para compatibilidad)
    private LivingEntity dragonMythic = null;  // Dragón MythicMobs (verdadero combate)
    private LivingEntity dragonEntity = null;  // Referencia genérica (para MythicMobs HUSK)
    
    // Configuración
    private double dragonMaxHP = 500.0;
    private boolean dragonVanillaMuerto = false; // Track si el vanilla ya murió
    
    // Model Engine
    private ModeledEntity modeledDragon = null;
    private String modelId = "corrupted_dragon";
    private boolean modelEngineDisponible = false;
    
    // Tasks
    private BukkitTask dragonTrackingTask = null;
    
    // ═══════════════════════════════════════════════════════════════════
    // CONSTRUCTOR
    // ═══════════════════════════════════════════════════════════════════
    
    public AperturaEndDragonController(Apocalipsis plugin, AperturaEndEvent event, BossBar bossBar) {
        this.plugin = plugin;
        this.event = event;
        this.bossBar = bossBar;
        
        // Detectar Model Engine
        modelEngineDisponible = Bukkit.getPluginManager().isPluginEnabled("ModelEngine");
        plugin.getLogger().info("[Apertura End] Model Engine: " + (modelEngineDisponible ? "DISPONIBLE" : "NO DISPONIBLE"));
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // MÉTODOS PÚBLICOS
    // ═══════════════════════════════════════════════════════════════════
    
    /**
     * Configura el controlador con la configuración del evento
     */
    public void configurar(double maxHP, String modeloId) {
        this.dragonMaxHP = maxHP;
        this.modelId = modeloId;
    }
    
    /**
     * Spawnea el dragón con efectos sutiles
     */
    public void spawnearDragon() {
        World endWorld = Bukkit.getWorld("world_the_end");
        
        if (endWorld == null) {
            plugin.getLogger().severe("[Apertura End] ¡Mundo End no encontrado!");
            Bukkit.broadcastMessage("§c§lERROR: No se pudo spawnear el dragón.");
            return;
        }
        
        // LIMPIEZA: Eliminar cualquier dragón existente antes de spawnear
        limpiarDragonesExistentes(endWorld);
        
        // Spawn EN EL AIRE sobre la arena (NO dentro del altar)
        // Posición: 40 bloques al norte, altura 100 (bien arriba)
        Location spawnLoc = new Location(endWorld, 0, 100, -40);
        
        // Calcular jugadores para escalar HP
        int jugadoresEnEnd = (int) Bukkit.getOnlinePlayers().stream()
            .filter(p -> p.getWorld().getEnvironment() == World.Environment.THE_END)
            .count();
        
        dragonMaxHP = calcularHPEscalado(jugadoresEnEnd);
        
        // ═══════════════════════════════════════════════════════════════
        // SECUENCIA CINEMÁTICA DE SPAWN (ÉPICA Y DRAMÁTICA)
        // ═══════════════════════════════════════════════════════════════
        
        ejecutarCinematicaSpawn(endWorld, spawnLoc, jugadoresEnEnd);
    }
    
    /**
     * Limpia dragones existentes
     */
    public void limpiarDragonesExistentes(World endWorld) {
        // Eliminar todos los dragones del End
        for (Entity entity : endWorld.getEntitiesByClass(EnderDragon.class)) {
            EnderDragon enderDragon = (EnderDragon) entity;
            plugin.getLogger().info("[Apertura End] Eliminando dragón existente: " + enderDragon.getUniqueId());
            enderDragon.remove();
        }
        
        // Resetear variables
        dragon = null;
        dragonVanilla = null;
        dragonMythic = null;
        dragonEntity = null;
        
        if (modelEngineDisponible && modeledDragon != null) {
            try {
                modeledDragon.destroy();
                plugin.getLogger().info("[Apertura End] Modelo de dragón destruido");
            } catch (Exception e) {
                plugin.getLogger().warning("[Apertura End] Error al destruir modelo: " + e.getMessage());
            }
            modeledDragon = null;
        }
    }
    
    /**
     * Inicia el tracking del dragón
     */
    public void iniciarTrackingDragon() {
        if (dragonTrackingTask != null) {
            dragonTrackingTask.cancel();
        }
        
        dragonTrackingTask = new BukkitRunnable() {
            @Override
            public void run() {
                actualizarBossBarDragon();
                verificarMuerteDragon();
            }
        }.runTaskTimer(plugin, 0L, 20L); // Cada segundo
    }
    
    /**
     * Detiene el tracking del dragón
     */
    public void detenerTrackingDragon() {
        if (dragonTrackingTask != null) {
            dragonTrackingTask.cancel();
            dragonTrackingTask = null;
        }
    }
    
    /**
     * Cleanup del dragón
     */
    public void cleanup() {
        detenerTrackingDragon();
        
        if (dragon != null && !dragon.isDead()) {
            dragon.remove();
        }
        
        if (dragonVanilla != null && !dragonVanilla.isDead()) {
            dragonVanilla.remove();
        }
        
        if (modelEngineDisponible && modeledDragon != null) {
            try {
                modeledDragon.destroy();
            } catch (Exception e) {
                plugin.getLogger().warning("[Apertura End] Error al limpiar modelo: " + e.getMessage());
            }
            modeledDragon = null;
        }
        
        dragon = null;
        dragonVanilla = null;
        dragonMythic = null;
        dragonEntity = null;
    }
    
    /**
     * Obtiene el dragón actual
     */
    public EnderDragon getDragon() {
        return dragon;
    }
    
    /**
     * Obtiene el dragón vanilla
     */
    public EnderDragon getDragonVanilla() {
        return dragonVanilla;
    }
    
    /**
     * Obtiene el dragón MythicMobs (verdadero jefe)
     */
    public LivingEntity getDragonMythic() {
        return dragonMythic != null ? dragonMythic : dragonEntity;
    }
    
    /**
     * Verifica si el dragón vanilla murió
     */
    public boolean isDragonVanillaMuerto() {
        return dragonVanillaMuerto;
    }
    
    /**
     * Obtiene el tipo de dragón actual
     */
    public DragonType getTipoDragonActual() {
        return tipoDragonActual;
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // MÉTODOS PRIVADOS
    // ═══════════════════════════════════════════════════════════════════
    
    private void ejecutarCinematicaSpawn(World endWorld, Location spawnLoc, int jugadoresEnEnd) {
        // T+0s: Oscuridad total y ceguera
        endWorld.setTime(18000); // Medianoche
        for (Player p : Bukkit.getOnlinePlayers()) {
            if (p.getWorld().equals(endWorld)) {
                p.addPotionEffect(new PotionEffect(PotionEffectType.BLINDNESS, 120, 1, false, false));
                p.addPotionEffect(new PotionEffect(PotionEffectType.SLOWNESS, 120, 2, false, false));
                p.playSound(p.getLocation(), Sound.AMBIENT_CAVE, 2.0f, 0.3f);
            }
        }
        
        // T+1s: Primer diálogo del Observador
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §5Algo antiguo despierta...");
                Bukkit.broadcastMessage("§8[§5...§8] §5El vacío reclama lo que es suyo.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_AMBIENT, 1.0f, 0.5f);
                }
            }
        }.runTaskLater(plugin, 20L);
        
        // T+3s: Temblor y partículas iniciales
        new BukkitRunnable() {
            @Override
            public void run() {
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.playSound(p.getLocation(), Sound.ENTITY_WITHER_SPAWN, 0.8f, 0.4f);
                        p.playSound(p.getLocation(), Sound.ENTITY_LIGHTNING_BOLT_THUNDER, 0.5f, 0.6f);
                    }
                }
                
                spawnLoc.getWorld().spawnParticle(Particle.SMOKE, spawnLoc, 100, 5, 5, 5, 0.1);
                spawnLoc.getWorld().spawnParticle(Particle.LARGE_SMOKE, spawnLoc, 50, 3, 3, 3, 0.05);
            }
        }.runTaskLater(plugin, 60L);
        
        // T+5s: Explosión de partículas y rayos
        new BukkitRunnable() {
            @Override
            public void run() {
                spawnLoc.getWorld().spawnParticle(Particle.PORTAL, spawnLoc, 500, 10, 10, 10, 1.0);
                spawnLoc.getWorld().spawnParticle(Particle.DRAGON_BREATH, spawnLoc, 300, 8, 8, 8, 0.5);
                spawnLoc.getWorld().spawnParticle(Particle.END_ROD, spawnLoc, 100, 5, 5, 5, 0.3);
                spawnLoc.getWorld().spawnParticle(Particle.SOUL_FIRE_FLAME, spawnLoc, 200, 7, 7, 7, 0.2);
                
                for (int i = 0; i < 3; i++) {
                    Location randomLoc = spawnLoc.clone().add(
                        (Math.random() - 0.5) * 20, 0, (Math.random() - 0.5) * 20);
                    endWorld.strikeLightningEffect(randomLoc);
                }
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().equals(endWorld)) {
                        p.playSound(p.getLocation(), Sound.ENTITY_LIGHTNING_BOLT_IMPACT, 1.5f, 0.7f);
                        p.playSound(p.getLocation(), Sound.ENTITY_GENERIC_EXPLODE, 1.0f, 0.5f);
                    }
                }
            }
        }.runTaskLater(plugin, 100L);
        
        // T+7s: SPAWN DEL DRAGÓN + Título épico
        new BukkitRunnable() {
            @Override
            public void run() {
                String titulo = "§8§l⚠";
                String subtitulo = "§c§lEL DRAGÓN DEL END DESPIERTA";
                
                for (Player player : Bukkit.getOnlinePlayers()) {
                    player.sendTitle(titulo, subtitulo, 10, 80, 20);
                    player.playSound(player.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 2.0f, 0.6f);
                    player.playSound(player.getLocation(), Sound.AMBIENT_CAVE, 1.0f, 0.4f);
                }
                
                // SPAWN DEL DRAGÓN VANILLA (sin MythicMobs - siempre vanilla primero)
                tipoDragonActual = DragonType.VANILLA;
                spawnearDragonVanillaPrimerFase(spawnLoc, jugadoresEnEnd);
                
                // Actualizar BossBar
                bossBar.setTitle("§c§lEnder Dragon");
                bossBar.setColor(BarColor.PINK);
                bossBar.setProgress(1.0);
                
                plugin.getLogger().info("[Apertura End] Dragón VANILLA spawneado - HP: " + dragonMaxHP);
            }
        }.runTaskLater(plugin, 140L);
        
        // T+9s: Diálogo final
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§5...§8] §dAntes era un final.");
                Bukkit.broadcastMessage("§8[§5...§8] §dAhora… es solo otro paso.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§5§l¡COMBATE INICIADO!");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
            }
        }.runTaskLater(plugin, 180L);
        
        // T+10s: Iniciar tracking del dragón
        new BukkitRunnable() {
            @Override
            public void run() {
                iniciarTrackingDragon();
            }
        }.runTaskLater(plugin, 200L);
        
        // T+12s: Mensaje sobre cristales
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§d§l⚠ MECÁNICA IMPORTANTE ⚠");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§7Los §5§lCRISTALES DEL END §7protegen al dragón");
                Bukkit.broadcastMessage("§7Debes §c§lDESTRUIRLOS §7para poder dañarlo");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    if (p.getWorld().getEnvironment() == World.Environment.THE_END) {
                        p.sendTitle("§5§l⚠", "§d§lDestruye los Cristales del End", 10, 60, 20);
                        p.playSound(p.getLocation(), Sound.BLOCK_BEACON_ACTIVATE, 1.0f, 1.5f);
                    }
                }
            }
        }.runTaskLater(plugin, 240L);
    }
    
    private void spawnearDragonVanillaPrimerFase(Location spawnLoc, int jugadoresEnEnd) {
        dragonVanilla = spawnLoc.getWorld().spawn(spawnLoc, EnderDragon.class);
        dragon = dragonVanilla; // Para compatibilidad
        
        // Configurar dragón
        dragonVanilla.setMaxHealth(dragonMaxHP);
        dragonVanilla.setHealth(dragonMaxHP);
        dragonVanilla.setCustomName("§c§lEnder Dragon");
        dragonVanilla.setCustomNameVisible(false);
        
        plugin.getLogger().info("[Apertura End] Dragón vanilla spawneado en primera fase");
    }
    
    /**
     * Maneja la muerte del dragón vanilla y spawn del MythicMobs
     */
    public void manejarMuerteDragonVanilla(Location deathLoc) {
        if (dragonVanillaMuerto) {
            return; // Ya manejado
        }
        
        dragonVanillaMuerto = true;
        int jugadoresEnEnd = (int) Bukkit.getOnlinePlayers().stream()
            .filter(p -> p.getWorld().getEnvironment() == World.Environment.THE_END)
            .count();
        
        // Cinemática de transición épica
        ejecutarCinematicaTransicion(deathLoc, jugadoresEnEnd);
    }
    
    private void ejecutarCinematicaTransicion(Location deathLoc, int jugadoresEnEnd) {
        // REVELACIÓN ÉPICA: El dragón vanilla era solo un engaño
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8[§5Observador§8] §c¿En serio creían que eso era todo?");
        Bukkit.broadcastMessage("§8[§5Observador§8] §6Ese dragón era solo... §7un guardián menor.");
        Bukkit.broadcastMessage("§8[§5Observador§8] §dEl verdadero terror §5apenas está despertando§d...");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§c§l⚠ EL DESOLADOR DEL VACÍO EMERGE ⚠");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        
        // T+3s: Spawn del verdadero dragón
        new BukkitRunnable() {
            @Override
            public void run() {
                // Intentar MythicMobs primero, fallback a vanilla mejorado
                if (Bukkit.getPluginManager().isPluginEnabled("MythicMobs")) {
                    spawnearDragonModelEngine(deathLoc, jugadoresEnEnd);
                } else {
                    spawnearDragonVanillaModoEpico(deathLoc);
                }
            }
        }.runTaskLater(plugin, 60L);
    }
    
    private void spawnearDragonModelEngine(Location loc, int jugadores) {
        try {
            // Usar reflexión para acceder a MythicMobs sin dependencia directa
            Class<?> mythicBukkitClass = Class.forName("io.lumine.mythic.bukkit.MythicBukkit");
            Object mythicBukkit = mythicBukkitClass.getMethod("inst").invoke(null);
            
            if (mythicBukkit == null) {
                plugin.getLogger().warning("[Apertura End] ⚠ MythicMobs no encontrado - usando vanilla");
                fallbackVanilla();
                return;
            }
            
            // Spawnear el mob "toro_enderdragon" de MythicMobs
            Object mobManager = mythicBukkitClass.getMethod("getMobManager").invoke(mythicBukkit);
            Object activeMob = mobManager.getClass().getMethod("spawnMob", String.class, Location.class)
                .invoke(mobManager, "toro_enderdragon", loc);
            
            if (activeMob == null) {
                plugin.getLogger().warning("[Apertura End] ⚠ No se pudo spawnear 'toro_enderdragon'");
                fallbackVanilla();
                return;
            }
            
            // Obtener la entidad Bukkit del mob
            Object mobEntity = activeMob.getClass().getMethod("getEntity").invoke(activeMob);
            Entity entity = (Entity) mobEntity.getClass().getMethod("getBukkitEntity").invoke(mobEntity);
            
            if (entity instanceof LivingEntity) {
                LivingEntity livingEntity = (LivingEntity) entity;
                
                // GUARDAR REFERENCIA GENÉRICA
                dragonEntity = livingEntity;
                
                // Configurar HP escalado
                livingEntity.setMaxHealth(dragonMaxHP);
                livingEntity.setHealth(dragonMaxHP);
                
                // Si es un dragón, guardarlo
                if (entity instanceof EnderDragon) {
                    dragon = (EnderDragon) entity;
                }
                
                tipoDragonActual = DragonType.MYTHIC;
                dragonMythic = livingEntity;
                
                plugin.getLogger().info("[Apertura End] ✅ Dragón MythicMobs spawneado exitosamente");
                
                // Actualizar BossBar
                bossBar.setTitle("§8§lEl Desolador del Vacío");
                bossBar.setColor(BarColor.PURPLE);
                bossBar.setProgress(1.0);
                
            } else {
                plugin.getLogger().warning("[Apertura End] ⚠ Entidad spawneada no es LivingEntity");
                fallbackVanilla();
            }
            
        } catch (Exception e) {
            plugin.getLogger().warning("[Apertura End] ⚠ Error con MythicMobs: " + e.getMessage());
            fallbackVanilla();
        }
    }
    
    private void spawnearDragonVanillaModoEpico(Location loc) {
        dragon = loc.getWorld().spawn(loc, EnderDragon.class);
        
        // Configurar dragón con HP épico
        double hpEpico = dragonMaxHP * 2.0; // Doble HP para compensar falta de MythicMobs
        dragon.setMaxHealth(hpEpico);
        dragon.setHealth(hpEpico);
        dragon.setCustomName("§8§lEl Desolador del Vacío");
        dragon.setCustomNameVisible(true);
        
        tipoDragonActual = DragonType.VANILLA;
        dragonEntity = dragon;
        
        // Actualizar BossBar
        bossBar.setTitle("§8§lEl Desolador del Vacío");
        bossBar.setColor(BarColor.PURPLE);
        bossBar.setProgress(1.0);
        
        plugin.getLogger().info("[Apertura End] ✅ Dragón vanilla ÉPICO spawneado (modo fallback)");
    }
    
    private void fallbackVanilla() {
        spawnearDragonVanillaModoEpico(dragon.getLocation());
    }
    
    private double calcularHPEscalado(int jugadores) {
        // HP base: 500 para 1 jugador
        // Escalado: +200 HP por jugador adicional (máximo 1500 HP)
        double hpCalculado = 500.0 + (jugadores - 1) * 200.0;
        return Math.min(hpCalculado, 1500.0);
    }
    
    private void actualizarBossBarDragon() {
        LivingEntity dragonActual = obtenerDragonActual();
        if (dragonActual == null || dragonActual.isDead()) {
            return;
        }
        
        double vidaActual = dragonActual.getHealth();
        double vidaMaxima = dragonActual.getMaxHealth();
        double porcentaje = vidaActual / vidaMaxima;
        
        bossBar.setProgress(Math.max(0.0, porcentaje));
        
        // Cambiar color según la vida
        if (porcentaje > 0.6) {
            bossBar.setColor(tipoDragonActual == DragonType.MYTHIC ? BarColor.PURPLE : BarColor.PINK);
        } else if (porcentaje > 0.3) {
            bossBar.setColor(BarColor.YELLOW);
        } else {
            bossBar.setColor(BarColor.RED);
        }
    }
    
    private void verificarMuerteDragon() {
        LivingEntity dragonActual = obtenerDragonActual();
        
        if (dragonActual == null || dragonActual.isDead()) {
            if (tipoDragonActual == DragonType.VANILLA && !dragonVanillaMuerto) {
                // El dragón vanilla murió - iniciar transición
                manejarMuerteDragonVanilla(dragonActual != null ? dragonActual.getLocation() : new Location(Bukkit.getWorld("world_the_end"), 0, 70, 0));
            } else if (tipoDragonActual == DragonType.MYTHIC || dragonVanillaMuerto) {
                // El verdadero dragón murió - evento completado
                event.onDragonKilled();
            }
        }
    }
    
    private LivingEntity obtenerDragonActual() {
        if (tipoDragonActual == DragonType.VANILLA) {
            return dragonVanilla;
        } else {
            return dragonEntity != null ? dragonEntity : dragon;
        }
    }
}