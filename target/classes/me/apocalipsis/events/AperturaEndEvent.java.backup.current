    public void setUbicacionIniciador(Location ubicacion, UUID uuid) {
        this.ubicacionIniciador = ubicacion;
        this.iniciadorUUID = uuid;
    }
    
    // Getters para compatibilidad
    public Location getPortalLocation() { return portalLocation; }
    public AperturaEndPhaseManager.EventPhase getFaseEvento() { return phaseManager.getFaseEvento(); }
    public AperturaEndPhaseManager getPhaseManager() { return phaseManager; }
    public AperturaEndWaypointManager getWaypointManager() { return waypointManager; }
    public AperturaEndEffectsManager getEffectsManager() { return effectsManager; }
    
    // ═══════════════════════════════════════════════════════════════════
    // MÉTODOS DE COMPATIBILIDAD PARA ApocalipsisCommand
    // ═══════════════════════════════════════════════════════════════════
    
    public void setIniciador(org.bukkit.entity.Player player) {
        this.ubicacionIniciador = player.getLocation();
        this.iniciadorUUID = player.getUniqueId();
        plugin.getLogger().info("[Apertura End] Iniciador establecido: " + player.getName());
    }
    
    public String getEstadoEvento() {
        AperturaEndPhaseManager.EventPhase fase = phaseManager.getFaseEvento();
        return "Fase: " + fase.name() + " | Portal: " + (portalLocation != null ? "Generado" : "No generado");
    }
    
    public void saltarPreparacion() {
        plugin.getLogger().info("[Apertura End] Saltando fase de preparación...");
        phaseManager.cambiarFase(AperturaEndPhaseManager.EventPhase.LLEGADA);
    }
    
    public void saltarAlSiguienteDialogo() {
        plugin.getLogger().info("[Apertura End] Saltando al siguiente diálogo...");
        phaseManager.revelarDireccion();
    }
    
    public void matarDragon() {
        if (dragon != null && !dragon.isDead()) {
            dragon.remove();
            plugin.getLogger().info("[Apertura End] Dragón eliminado por comando admin");
        } else {
            plugin.getLogger().warning("[Apertura End] No hay dragón activo para eliminar");
        }
    }
    
    public void forzarGeneracionPortal() {
        if (portalLocation == null) {
            generarUbicacionPortal();
            plugin.getLogger().info("[Apertura End] Portal forzado a generar en: " + portalLocation);
        } else {
            plugin.getLogger().info("[Apertura End] Portal ya existe en: " + portalLocation);
        }
    }
    
    public void forzarFase(int numeroFase) {
        AperturaEndPhaseManager.EventPhase[] fases = AperturaEndPhaseManager.EventPhase.values();
        if (numeroFase >= 0 && numeroFase < fases.length) {
            phaseManager.cambiarFase(fases[numeroFase]);
            plugin.getLogger().info("[Apertura End] Forzado a fase: " + fases[numeroFase].name());
        }
    }
    
    public void añadirDaño(org.bukkit.entity.Player player, double cantidad) {
        damageTracker.put(player.getUniqueId(), 
            damageTracker.getOrDefault(player.getUniqueId(), 0.0) + cantidad);
        plugin.getLogger().info("[Apertura End] Añadido daño para " + player.getName() + ": " + cantidad);
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // MÉTODOS DE ACTIVACIÓN DEL PORTAL
    // ═══════════════════════════════════════════════════════════════════
    
    /**
     * Activación lenta del portal (10 segundos)
     */
    public void activarPortalLentamente() {
        if (bossBar != null) {
            bossBar.setTitle("§8El portal se activa...");
            bossBar.setColor(org.bukkit.boss.BarColor.WHITE);
        }
        
        new BukkitRunnable() {
            int ticks = 0;
            
            @Override
            public void run() {
                if (phaseManager.getFaseEvento() != AperturaEndPhaseManager.EventPhase.LLEGADA) {
                    cancel();
                    return;
                }
                
                ticks++;
                portalActivacionTicks = ticks;
                
                // Partículas y sonidos incrementales durante la activación
                if (portalLocation != null && ticks % 10 == 0) {
                    Location loc = portalLocation.clone().add(0, 1, 0);
                    
                    // Intensidad creciente
                    int intensidad = (ticks * 20) / 200; // 0-20 durante 200 ticks
                    
                    portalLocation.getWorld().spawnParticle(
                        org.bukkit.Particle.END_ROD, 
                        loc, 
                        10 + intensidad, 
                        2, 2, 2, 
                        0.02
                    );
                    
                    portalLocation.getWorld().spawnParticle(
                        org.bukkit.Particle.PORTAL,
                        loc,
                        15 + intensidad,
                        1.5, 1.5, 1.5,
                        0.05
                    );
                    
                    for (Player player : Bukkit.getOnlinePlayers()) {
                        if (player.getWorld().equals(portalLocation.getWorld())) {
                            player.playSound(portalLocation, Sound.BLOCK_END_PORTAL_SPAWN, 0.5f + (ticks / 200.0f), 0.8f);
                        }
                    }
                }
                
                // Después de 10 segundos (200 ticks), portal activado
                if (ticks >= 200) {
                    portalActivado();
                    cancel();
                }
            }
        }.runTaskTimer(plugin, 0L, 1L);
    }
    
    /**
     * Portal completamente activado - Esperando a que jugadores entren al End
     */
    private void portalActivado() {
        phaseManager.cambiarFase(AperturaEndPhaseManager.EventPhase.PORTAL_ABIERTO);
        
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§5§l⚡ PORTAL ACTIVADO ⚡");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§7El portal al End está abierto.");
        Bukkit.broadcastMessage("§dEntren para enfrentar al Desolador del Vacío.");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.playSound(p.getLocation(), Sound.BLOCK_END_PORTAL_SPAWN, 2.0f, 1.0f);
        }
        
        // Iniciar detección de entrada al End
        detectarEntradaEnd();
        
        plugin.getLogger().info("[Apertura End] Fase 2: Portal activado - Esperando jugadores");
    }
    
    /**
     * Detectar cuando jugadores entran al End
     */
    private void detectarEntradaEnd() {
        mainTask = new BukkitRunnable() {
            @Override
            public void run() {
                if (phaseManager.getFaseEvento() != AperturaEndPhaseManager.EventPhase.PORTAL_ABIERTO) {
                    cancel();
                    return;
                }
                
                // Contar jugadores en el End
                long jugadoresEnEnd = Bukkit.getOnlinePlayers().stream()
                    .filter(p -> p.getWorld().getEnvironment() == World.Environment.THE_END)
                    .count();
                
                if (jugadoresEnEnd >= 1) {
                    iniciarFaseCombate();
                    this.cancel();
                }
            }
        }.runTaskTimer(plugin, 0L, 20L);
    }
    
    /**
     * FASE 3: Combate (End) - Los jugadores entraron al End, comienza la batalla
     */
    public void iniciarFaseCombate() {
        phaseManager.cambiarFase(AperturaEndPhaseManager.EventPhase.COMBATE);
        
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8[§7...§8] §7No es el mismo lugar.");
        Bukkit.broadcastMessage("§8[§5Observador§8] §5Algo ha cambiado aquí...");
        Bukkit.broadcastMessage("§8[§5Observador§8] §dEsta dimensión... §5palpita§d.");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§c§l⚠ PREPARAOS PARA EL COMBATE ⚠");
        Bukkit.broadcastMessage("");
        Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        
        for (Player p : Bukkit.getOnlinePlayers()) {
            p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 1.0f, 0.8f);
            p.playSound(p.getLocation(), Sound.BLOCK_END_PORTAL_SPAWN, 0.5f, 1.5f);
        }
        
        // Delay dramático antes de spawnear el dragón
        new BukkitRunnable() {
            @Override
            public void run() {
                iniciarDragonBoss();
            }
        }.runTaskLater(plugin, 100L); // 5 segundos de delay
        
        plugin.getLogger().info("[Apertura End] Fase 3: COMBATE - Jugadores en el End");
    }
    
