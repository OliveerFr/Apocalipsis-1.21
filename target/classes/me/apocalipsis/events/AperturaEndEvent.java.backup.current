/**
 * La Apertura del End - Evento 5 (VERSIÓN REFACTORIZADA + EPIC MODS)
 * 
 * Evento raid épico contra el Desolador del Vacío
 * Funciona con MythicMobs + Model Engine (modo épico) o vanilla mejorado.
 * 
 * ARQUITECTURA MODULAR:
 * - AperturaEndPhaseManager: Gestión de fases del evento
 * - AperturaEndWaypointManager: Sistema de waypoints progresivos  
 * - AperturaEndEffectsManager: Efectos visuales y sonoros
 * - AperturaEndDragonController: Control del dragón (pendiente)
 * - AperturaEndArenaBuilder: Generación de arena (pendiente)
 * 
 * FUNCIONALIDADES ÉPICAS:
 * - Soporte completo MythicMobs (dragón 'toro_enderdragon')
 * - Model Engine para modelos 3D avanzados
 * - Sistema dual: Dragón vanilla como señuelo + MythicMobs como boss real
 * - Escalado dinámico basado en jugadores
 * - Limpieza automática de dragones duplicados
 */
public class AperturaEndEvent extends EventBase {
    
    // ═══════════════════════════════════════════════════════════════════
    // MANAGERS MODULARES
    // ═══════════════════════════════════════════════════════════════════
    
    private AperturaEndPhaseManager phaseManager;
    private AperturaEndWaypointManager waypointManager;
    private AperturaEndEffectsManager effectsManager;
    private AperturaEndDragonController dragonController;
    private AperturaEndArenaBuilder arenaBuilder;
    
    // ═══════════════════════════════════════════════════════════════════
    // ESTADO DEL EVENTO (REDUCIDO)
    // ═══════════════════════════════════════════════════════════════════
    
    // Portal en Overworld
    private Location portalLocation = null;
    private Location ubicacionIniciador = null;
    private UUID iniciadorUUID = null;
    private boolean portalActivandose = false;
    private int portalActivacionTicks = 0;
    private boolean portalGenerado = false;
    private BukkitTask efectosPortalTask;
    private List<Location> blocksPortalOverworld = new ArrayList<>();
    
    // Dragón (con soporte completo MythicMobs + Model Engine)
    private EnderDragon dragon = null;
    private LivingEntity dragonMythic = null;  // Dragón MythicMobs (verdadero combate)
    private LivingEntity dragonEntity = null;  // Referencia genérica (para MythicMobs HUSK o cualquier tipo)
    private double dragonMaxHP = 500.0;
    private int cristalesRestantes = 10;
    
    // Sistema de doble dragón
    private EnderDragon dragonVanilla = null;  // Dragón vanilla (engaño)
    private boolean dragonVanillaMuerto = false;
    private int combateTicks = 0;
    
    // Control de tipo de dragón activo
    public enum DragonType { VANILLA, MYTHIC }
    private DragonType tipoDragonActual = DragonType.VANILLA;
    
    // Model Engine - Sistema épico de modelos 3D
    private boolean modelEngineDisponible = false;
    private Object modeledDragon = null;  // ModeledEntity (usando Object para evitar dependencia)
    private String modelId = "corrupted_dragon";
    
    // Tracking
    private Map<UUID, Double> damageTracker = new HashMap<>();
    private Set<UUID> participantes = new HashSet<>();
    
    // BossBar
    private org.bukkit.boss.BossBar bossBar;
    
    // Sistema de desbloqueo de información
    private int tareasCompletadas = 0;
    private int tareasRequeridas = 3; // Deben completar 3 tareas para desbloquear ubicación
    private Set<String> tareasRealizadas = new HashSet<>();
    private boolean esperandoJugadoresCercaPortal = false;
    private boolean direccionRevelada = false;  // Track si ya se reveló la dirección
    
    // Sistema de spawns dramáticos
    private int proximoSpawnTicks = 0;
    
    // Sistema de mobs hostiles
    private BukkitTask spawnMobsHostilesTask;
    private List<UUID> mobsSpawneados = new ArrayList<>();
    private int mobSpawnCounter = 0;
    
    // Configuración
    private FileConfiguration config;
    
    // Tareas principales
    private BukkitTask mainTask;
    private BukkitTask spawnsTask;
    
    private Random random = new Random();
    
    // ═══════════════════════════════════════════════════════════════════
    // CONSTRUCTOR
    // ═══════════════════════════════════════════════════════════════════
    
    public AperturaEndEvent(Apocalipsis plugin, MessageBus messageBus, SoundUtil soundUtil) {
        super(plugin, messageBus, soundUtil, "apertura_end");
        
        loadConfig();
        detectarModelEngine();
        
        // Inicializar BossBar
        bossBar = Bukkit.createBossBar("§8§lApertura del End", 
                                      org.bukkit.boss.BarColor.PURPLE, 
                                      org.bukkit.boss.BarStyle.SEGMENTED_10);
        bossBar.setVisible(false);
        
        // Inicializar managers
        phaseManager = new AperturaEndPhaseManager(plugin, messageBus, soundUtil);
        waypointManager = new AperturaEndWaypointManager(plugin);
        effectsManager = new AperturaEndEffectsManager(plugin, messageBus, soundUtil);
        dragonController = new AperturaEndDragonController(plugin, this, bossBar);
        arenaBuilder = new AperturaEndArenaBuilder(plugin);
        
        // Conectar managers
        phaseManager.setManagers(waypointManager, effectsManager, dragonController, arenaBuilder, this);
        
        // Configurar dragon controller
        double maxHP = config.getDouble("evento.escalado.hp_base", 500.0);
        String modeloId = config.getString("modelo.model_engine_id", "corrupted_dragon");
        dragonController.configurar(maxHP, modeloId);
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // CONFIGURACIÓN
    // ═══════════════════════════════════════════════════════════════════
    
    private void detectarModelEngine() {
        try {
            Class.forName("com.ticxo.modelengine.api.ModelEngineAPI");
            modelEngineDisponible = Bukkit.getPluginManager().isPluginEnabled("ModelEngine");
            
            if (modelEngineDisponible) {
                plugin.getLogger().info("[Apertura End] ✓ Model Engine detectado - Modo épico activado");
                modelId = config.getString("modelo.model_engine_id", "corrupted_dragon");
                plugin.getLogger().info("[Apertura End] Modelo configurado: " + modelId);
            } else {
                plugin.getLogger().info("[Apertura End] Model Engine no detectado - Usando dragón vanilla mejorado");
            }
        } catch (ClassNotFoundException e) {
            modelEngineDisponible = false;
            plugin.getLogger().info("[Apertura End] Model Engine no instalado - Usando dragón vanilla mejorado");
        }
    }
    
    private void loadConfig() {
        File configFile = new File(plugin.getDataFolder(), "apertura_end.yml");
        
        if (!configFile.exists()) {
            plugin.saveResource("apertura_end.yml", false);
        }
        
        config = YamlConfiguration.loadConfiguration(configFile);
        
        dragonMaxHP = config.getDouble("evento.escalado.hp_base", 500.0);
        
        plugin.getLogger().info("[Apertura End] Configuración cargada");
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // IMPLEMENTACIÓN DE EventBase
    // ═══════════════════════════════════════════════════════════════════
    
    @Override
    public void onStart() {
        // Limpiar estado
        damageTracker.clear();
        participantes.clear();
        dragon = null;
        cristalesRestantes = 10;
        portalLocation = null;
        portalActivandose = false;
        portalActivacionTicks = 0;
        
        // Registrar listeners críticos
        registrarEventListeners();
        
        // Generar ubicación del portal
        generarUbicacionPortal();
        waypointManager.setPortalLocation(portalLocation);
        
        // Generar arena en el End usando ArenaBuilder
        World endWorld = Bukkit.getWorld(config.getString("evento.mundo_end", "world_the_end"));
        if (endWorld != null && arenaBuilder != null) {
            plugin.getLogger().info("[Apertura End] ⚡ Preparando arena épica del End...");
            
            new BukkitRunnable() {
                @Override
                public void run() {
                    arenaBuilder.construirArenaCompleta();
                    plugin.getLogger().info("[Apertura End] ✓ Arena del End construida");
                }
            }.runTaskLater(plugin, 40L);
        }
        
        // Mensaje inicial
        mostrarMensajeInicialSinCoordenadas();
        
        // Iniciar spawns dramáticos básicos
        iniciarSpawnsDramaticos();
        
        // Iniciar sistema de tareas de desbloqueo
        iniciarTareasDesbloqueo();
        
        // Iniciar fase de descubrimiento
        int duracion = config.getInt("evento.duracion_fase_descubrimiento_segundos", 2700);
        phaseManager.iniciarFaseDescubrimiento(duracion);
        
        plugin.getLogger().info("[Apertura End] Evento iniciado - Fase de preparación (MODULAR)");
    }
    
    @Override
    public void onStop() {
        // Limpiar BossBar
        if (bossBar != null) {
            bossBar.removeAll();
            bossBar.setVisible(false);
        }
        
        // Limpiar dragón a través del controller
        if (dragonController != null) {
            dragonController.cleanup();
        }
        
        // Limpiar dragón legacy (compatibilidad)
        if (dragon != null && !dragon.isDead()) {
            if (modelEngineDisponible && modeledDragon != null) {
                try {
                    // Usar reflexión para llamar destroy() sin dependencia directa
                    modeledDragon.getClass().getMethod("destroy").invoke(modeledDragon);
                    plugin.getLogger().info("[Apertura End] Modelo de Model Engine destruido");
                } catch (Exception e) {
                    plugin.getLogger().warning("[Apertura End] Error al destruir modelo: " + e.getMessage());
                }
                modeledDragon = null;
            }
            dragon.remove();
        }
        
        // Limpiar dragón MythicMobs si existe
        if (dragonMythic != null && !dragonMythic.isDead()) {
            dragonMythic.remove();
            plugin.getLogger().info("[Apertura End] Dragón MythicMobs eliminado");
        }
        
        // Limpiar entidad genérica
        if (dragonEntity != null && !dragonEntity.isDead()) {
            dragonEntity.remove();
            plugin.getLogger().info("[Apertura End] Entidad dragón genérica eliminada");
        }
        
        // Detener managers
        phaseManager.detener();
        waypointManager.detener();
        effectsManager.detener();
        if (dragonController != null) {
            dragonController.detenerTrackingDragon();
        }
        
        // Cancelar tareas
        if (mainTask != null) {
            mainTask.cancel();
        }
        if (efectosPortalTask != null) {
            efectosPortalTask.cancel();
        }
        if (spawnsTask != null) {
            spawnsTask.cancel();
        }
        if (spawnMobsHostilesTask != null) {
            spawnMobsHostilesTask.cancel();
        }
        
        // Limpiar mobs spawneados
        for (UUID uuid : mobsSpawneados) {
            Entity entity = Bukkit.getEntity(uuid);
            if (entity != null && !entity.isDead()) {
                entity.remove();
            }
        }
        mobsSpawneados.clear();
        
        // Resetear estado
        tareasCompletadas = 0;
        tareasRealizadas.clear();
        direccionRevelada = false;
        
        plugin.getLogger().info("[Apertura End] Evento detenido (MODULAR)");
    }
    
    @Override
    public void onTick() {
        // El tick principal se maneja en los managers
    }
    
    @Override
    public String getDisplayName() {
        return config.getString("metadata.nombre_display", "§5§lLa Apertura del End");
    }
    
    @Override
    public String getDescription() {
        return "Evento raid épico contra el Desolador del Vacío (MODULAR)";
    }
    
    // ═══════════════════════════════════════════════════════════════════
    // MÉTODOS PRINCIPALES (SIMPLIFICADOS)
    // ═══════════════════════════════════════════════════════════════════
    
    private void generarUbicacionPortal() {
        World overworld = Bukkit.getWorld(config.getString("evento.mundo_overworld", "world"));
        if (overworld == null) {
            plugin.getLogger().warning("[Apertura End] Mundo Overworld no encontrado!");
            return;
        }
        
        int minDist = config.getInt("evento.portal.distancia_minima_spawn", 2000);
        int maxDist = config.getInt("evento.portal.distancia_maxima_spawn", 5000);
        
        Location puntoReferencia;
        if (ubicacionIniciador != null) {
            puntoReferencia = ubicacionIniciador;
        } else {
            puntoReferencia = overworld.getSpawnLocation();
        }
        
        int distancia = minDist + random.nextInt(maxDist - minDist);
        double angulo = random.nextDouble() * 2 * Math.PI;
        
        int x = puntoReferencia.getBlockX() + (int) (distancia * Math.cos(angulo));
        int z = puntoReferencia.getBlockZ() + (int) (distancia * Math.sin(angulo));
        int y = overworld.getHighestBlockYAt(x, z);
        
        portalLocation = new Location(overworld, x, y, z);
        
        plugin.getLogger().info(String.format("[Apertura End] Portal generado en: X=%d Y=%d Z=%d (distancia: %d bloques)", 
            x, y, z, (int) puntoReferencia.distance(portalLocation)));
        
        // Construir portal épico usando el arena builder
        if (arenaBuilder != null) {
            new BukkitRunnable() {
                @Override
                public void run() {
                    arenaBuilder.construirPortalEpico(portalLocation);
                }
            }.runTaskLater(plugin, 20L); // 1 segundo después
        }
    }
    
    private void mostrarMensajeInicialSinCoordenadas() {
        new BukkitRunnable() {
            @Override
            public void run() {
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§5§l⚡ EL OBSERVADOR HABLA ⚡");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§7...§8] §7El portal al §5End §7está materializándose...");
                Bukkit.broadcastMessage("§8[§7...§8] §7Su ubicación es... §8borrosa§7.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8[§7...§8] §7Tendréis que §5ganároslo§7.");
                Bukkit.broadcastMessage("");
                Bukkit.broadcastMessage("§8§l━━━━━━━━━━━━━━━━━━━━━━━━━━━");
                
                for (Player p : Bukkit.getOnlinePlayers()) {
                    p.playSound(p.getLocation(), Sound.ENTITY_ENDER_DRAGON_GROWL, 1.0f, 0.8f);
                    p.playSound(p.getLocation(), Sound.BLOCK_END_PORTAL_SPAWN, 0.5f, 1.5f);
                }
            }
        }.runTaskLater(plugin, 40L);
    }
    
    private void iniciarSpawnsDramaticos() {
        spawnsTask = new BukkitRunnable() {
            int ticksTranscurridos = 0;
            
            @Override
            public void run() {
                if (phaseManager.getFaseEvento() != AperturaEndPhaseManager.EventPhase.DESCUBRIMIENTO) {
                    cancel();
                    return;
                }
                
                ticksTranscurridos++;
                
                // Spawns cada 30 segundos
                if (ticksTranscurridos % 600 == 0) {
                    for (Player player : Bukkit.getOnlinePlayers()) {
                        if (player.getWorld().getEnvironment() == World.Environment.NORMAL) {
                            spawnearMobsBasicos(player);
                        }
                    }
                }
                
                // Endermans cada 30 segundos
                if (ticksTranscurridos % 600 == 0) {
                    spawnearEndermansEspeciales();
                }
            }
        }.runTaskTimer(plugin, 600L, 20L);
        
        // Iniciar efectos de endermans
        effectsManager.iniciarEfectosEnderman();
    }
    
    private void spawnearMobsBasicos(Player player) {
        Location loc = player.getLocation();
        World world = loc.getWorld();
        
        // Spawns básicos cerca del jugador
        for (int i = 0; i < 3; i++) {
            double angle = random.nextDouble() * 2 * Math.PI;
            double distance = 15 + random.nextDouble() * 10;
            
            Location spawnLoc = loc.clone().add(
                distance * Math.cos(angle),
                0,
                distance * Math.sin(angle)
            );
            spawnLoc.setY(world.getHighestBlockYAt(spawnLoc) + 1);
            
            // Spawns aleatorios
            EntityType[] tipos = {EntityType.ZOMBIE, EntityType.SKELETON, EntityType.CREEPER};
            EntityType tipo = tipos[random.nextInt(tipos.length)];
            
            LivingEntity mob = (LivingEntity) world.spawnEntity(spawnLoc, tipo);
            mob.customName(net.kyori.adventure.text.Component.text("§c§l⚔ Corrompido por el Vacío"));
            mob.setCustomNameVisible(true);
        }
    }
    
    private void spawnearEndermansEspeciales() {
        List<Player> players = new ArrayList<>(Bukkit.getOnlinePlayers());
        if (players.isEmpty()) return;
        
        int cantidad = 2 + random.nextInt(3);
        
        for (int i = 0; i < cantidad; i++) {
            Player target = players.get(random.nextInt(players.size()));
            Location loc = target.getLocation();
            
            double distance = 15 + random.nextDouble() * 10;
            double angle = random.nextDouble() * 2 * Math.PI;
            
            Location spawnLoc = loc.clone().add(
                distance * Math.cos(angle), 0, distance * Math.sin(angle)
            );
            spawnLoc.setY(spawnLoc.getWorld().getHighestBlockYAt(spawnLoc) + 1);
            
            org.bukkit.entity.Enderman enderman = (org.bukkit.entity.Enderman) 
                spawnLoc.getWorld().spawnEntity(spawnLoc, EntityType.ENDERMAN);
            
            enderman.customName(net.kyori.adventure.text.Component.text("§d§l⚡ §5§lEMISARIO DEL END §d§l⚡"));
            enderman.setCustomNameVisible(true);
            enderman.setGlowing(true);
            
            // Mejorar stats
            if (enderman.getAttribute(org.bukkit.attribute.Attribute.ATTACK_DAMAGE) != null) {
                enderman.getAttribute(org.bukkit.attribute.Attribute.ATTACK_DAMAGE).setBaseValue(15.0);
            }
            if (enderman.getAttribute(org.bukkit.attribute.Attribute.MAX_HEALTH) != null) {
                enderman.getAttribute(org.bukkit.attribute.Attribute.MAX_HEALTH).setBaseValue(60.0);
                enderman.setHealth(60.0);
            }
        }
    }
    
